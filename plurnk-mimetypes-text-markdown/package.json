{
    "name": "@plurnk/plurnk-mimetypes-text-markdown",
    "version": "1.0.1",
    "description": "text/markdown mimetype handler for plurnk-service.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "plurnk": {
        "kind": "mimetype",
        "handlers": [
            {
                "name": "text/markdown",
                "glyph": "📝",
                "extensions": [
                    ".md",
                    ".markdown"
                ]
            }
        ]
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "plurnk-dev": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "deps:fresh": "npm outdated",
        "prepublishOnly": "npm run deps:fresh && npm audit --audit-level=moderate && npm test",
        "prepack": "npm run build"
    },
    "dependencies": {
        "marked": "^18.0.5"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "1.0.1"
    }
}
