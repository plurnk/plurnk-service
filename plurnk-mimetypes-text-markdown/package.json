{
    "name": "@plurnk/plurnk-mimetypes-text-markdown",
    "version": "1.8.0",
    "description": "text/markdown mimetype handler for plurnk-service.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "plurnk": {
        "kind": "mimetype",
        "handlers": [
            {
                "name": "text/markdown",
                "revision": "2",
                "glyph": "📝",
                "extensions": [
                    ".md",
                    ".markdown"
                ]
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test",
        "prepack": "npm run build"
    },
    "dependencies": {
        "marked": "^18.0.5"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^1.8.0"
    },
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-mimetypes-text-markdown#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-mimetypes-text-markdown"
    }
}
