# @plurnk/plurnk-execs — installed runtime admission.
# These filters only remove registered runtimes; they cannot install or force-enable tools.

# Comma-separated allowlist; unset = all discovered runtimes.
# PLURNK_EXECS_ONLY=sh,jq
# Per-runtime switch, case-insensitive: 0 = disabled; absent = enabled.
# PLURNK_EXECS_PYTHON3=0
# PLURNK_EXECS_BC=0
# PLURNK_EXECS_QUESTION=0
# Maximum diagnostic characters in model-facing errors; empty/unset = unbounded.
PLURNK_EXECS_ERROR_DETAIL_LIMIT=512

# Subprocess-common floors ({§operator-config-env-defaults}, {§exec-env-scoped}). The
# executor framework owns these because every subprocess runtime wants them and one owner
# per key is enforced at boot — each executor redeclaring them would crash the daemon.
# They are set-if-unset, so an operator who exports PAGER=less keeps theirs.
# A pager that waits for a keypress hangs a spawn that has no terminal.
PAGER=cat
GIT_PAGER=cat
# Colour escapes and progress spinners are noise in a captured channel.
NO_COLOR=1
# Non-interactive by construction: tools that branch on CI take the unattended path.
CI=1
