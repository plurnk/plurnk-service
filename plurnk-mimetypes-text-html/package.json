{
    "name": "@plurnk/plurnk-mimetypes-text-html",
    "version": "1.4.0",
    "description": "text/html and application/xhtml+xml mimetype handler for plurnk-service. Structural extraction via parse5; readable markdown (content channel) via Readability + turndown.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "plurnk": {
        "kind": "mimetype",
        "handlers": [
            {
                "name": "text/html",
                "revision": "1",
                "glyph": "🌐",
                "extensions": [
                    ".html",
                    ".htm"
                ]
            },
            {
                "name": "application/xhtml+xml",
                "revision": "1",
                "glyph": "🌐",
                "extensions": [
                    ".xhtml"
                ]
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        ".env.defaults",
        "README.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file=.env.defaults --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@mozilla/readability": "^0.6.0",
        "@xmldom/xmldom": "^0.9.10",
        "linkedom": "^0.18.12",
        "parse5": "^8.0.1",
        "turndown": "^7.2.4",
        "xpath": "^0.0.34"
    },
    "devDependencies": {
        "@types/turndown": "^5.0.6"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^1.4.0"
    },
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-mimetypes-text-html#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-mimetypes-text-html"
    }
}
