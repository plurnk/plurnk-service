{
    "name": "@plurnk/plurnk-mimetypes-text-html",
    "version": "0.6.1",
    "description": "text/html and application/xhtml+xml mimetype handler for plurnk-service. Extracts headings, code blocks, and title via parse5.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=25"
    },
    "plurnk": {
        "kind": "mimetype",
        "handlers": [
            {
                "name": "text/html",
                "glyph": "🌐",
                "extensions": [
                    ".html",
                    ".htm"
                ]
            },
            {
                "name": "application/xhtml+xml",
                "glyph": "🌐",
                "extensions": [
                    ".xhtml"
                ]
            }
        ]
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "prepare": "npm run build"
    },
    "dependencies": {
        "@xmldom/xmldom": "^0.9.10",
        "parse5": "^8.0.1",
        "xpath": "^0.0.34"
    },
    "devDependencies": {
        "@types/node": "^25.8.0",
        "typescript": "^6.0.3",
        "@plurnk/plurnk-mimetypes": "^0.14.1"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^0.14.1"
    }
}
