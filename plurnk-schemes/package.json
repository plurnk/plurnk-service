{
    "name": "@plurnk/plurnk-schemes",
    "version": "0.33.7",
    "description": "Framework + contract for the @plurnk/plurnk-schemes-* URI handler family.",
    "keywords": [
        "plurnk",
        "scheme",
        "uri"
    ],
    "homepage": "https://github.com/plurnk/plurnk-schemes#readme",
    "bugs": {
        "url": "https://github.com/plurnk/plurnk-schemes/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-schemes.git"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "SPEC.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "prepare": "npm run build"
    },
    "peerDependencies": {
        "@plurnk/plurnk-grammar": "0.75.3",
        "@plurnk/plurnk-mimetypes": "0.19.0"
    },
    "devDependencies": {
        "@plurnk/plurnk-grammar": "0.75.3",
        "@plurnk/plurnk-mimetypes": "0.19.0",
        "@types/node": "26.0.1",
        "typescript": "6.0.3"
    }
}
