{
    "name": "@plurnk/plurnk-execs-git",
    "version": "1.3.11",
    "description": "In-process git runtime executor for plurnk-service's exec scheme — isomorphic-git (no subprocess, no shell escape) for EXEC[git]. The sandbox-portable versioning surface.",
    "keywords": [
        "plurnk",
        "exec",
        "runtime",
        "executor",
        "git",
        "isomorphic-git"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service#readme",
    "bugs": {
        "url": "https://github.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "plurnk": {
        "kind": "exec",
        "runtimes": [
            {
                "name": "git",
                "glyph": "🔀",
                "example": "<<EXEC[git]:status:EXEC\n<<EXEC[git]:commit -m \"save work\":EXEC"
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "docs/**/*"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test \"src/**/*.test.ts\"",
        "test": "npm run test:lint && npm run test:unit",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "prepack": "npm run build",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test"
    },
    "dependencies": {
        "isomorphic-git": "1.40.0"
    },
    "peerDependencies": {
        "@plurnk/plurnk-execs": "^1.3.11"
    }
}
