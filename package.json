{
    "name": "@plurnk/plurnk-service",
    "version": "0.77.1",
    "description": "Plurnk agent runtime — the server / engine / core. Implements the @plurnk/plurnk-grammar contract.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./digest": {
            "types": "./dist/digest/Digest.d.ts",
            "default": "./dist/digest/Digest.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "plurnk-service": "dist/service.js"
    },
    "files": [
        ".env.example",
        "dist/**/*",
        "migrations/**/*.sql",
        "README.md",
        "INSTALL.md",
        "SPEC.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "start": "node src/service.ts",
        "test:lint": "tsc --noEmit",
        "test:unit": "node --import=./test/setup.ts --env-file-if-exists=.env.example --test --test-timeout=30000 src/**/*.test.ts",
        "test:intg": "PLURNK_SERVICE_FILES_ITEMS=0 node --import=./test/setup.ts --env-file-if-exists=.env.example --test --test-concurrency=1 --test-timeout=30000 test/intg/*.test.ts",
        "test:live": "PLURNK_SERVICE_EMBED_DISABLE=0 PLURNK_SERVICE_POLICY=./node_modules/@plurnk/plurnk-docs/PLURNK_PERSONALITY.md node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test --test --test-concurrency=1 test/live/*.test.ts",
        "test:demo": "PLURNK_SERVICE_EMBED_DISABLE=0 PLURNK_SERVICE_POLICY=./node_modules/@plurnk/plurnk-docs/PLURNK_PERSONALITY.md node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test --test --test-concurrency=1 test/demo/*.test.ts",
        "test:all": "npm run test:lint && npm run test:unit && npm run test:intg && npm run test:demo",
        "test:digest": "node bin/digest.ts",
        "test:clean-tmp": "rm -rf test/intg/.tmp",
        "dev:digest": "node bin/digest.ts",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build:sql": "node scripts/copy-sql.mjs",
        "build": "npm run build:clean && npm run build:dist && npm run build:sql",
        "build:global:install": "npm run build && npm install -g .",
        "build:global:uninstall": "npm uninstall -g @plurnk/plurnk-service",
        "build:local:install": "node scripts/install-sandbox.mjs install",
        "build:local:uninstall": "node scripts/install-sandbox.mjs uninstall",
        "test:installation": "node scripts/test-installation.mjs",
        "deps:audit": "node scripts/deps-audit.ts",
        "prepare": "npm run build",
        "prepublishOnly": "npm run deps:audit"
    },
    "dependencies": {
        "@plurnk/plurnk-docs": "^0.1.5",
        "@plurnk/plurnk-execs": "^0.4.36",
        "@plurnk/plurnk-execs-all": "^0.1.24",
        "@plurnk/plurnk-execs-common": "^0.2.18",
        "@plurnk/plurnk-execs-mcp": "^0.5.7",
        "@plurnk/plurnk-execs-search": "^0.3.2",
        "@plurnk/plurnk-grammar": "^0.75.3",
        "@plurnk/plurnk-mimetypes": "^0.19.0",
        "@plurnk/plurnk-mimetypes-all": "^0.5.16",
        "@plurnk/plurnk-mimetypes-text-html": "^0.6.8",
        "@plurnk/plurnk-providers": "^0.37.0",
        "@plurnk/plurnk-providers-all": "^0.14.2",
        "@plurnk/plurnk-schemes": "^0.33.7",
        "@plurnk/plurnk-schemes-all": "^0.2.48",
        "@plurnk/plurnk-schemes-http": "^0.19.4",
        "@possumtech/sqlrite": "5.2.0",
        "diff": "^9.0.0",
        "ws": "^8.20.1"
    },
    "devDependencies": {
        "@plurnk/plurnk-mimetypes-embeddings": "^0.11.0",
        "@types/diff": "^7.0.2",
        "@types/node": "^26.1.0",
        "@types/ws": "^8.18.1",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes-embeddings": "^0.11.0"
    },
    "peerDependenciesMeta": {
        "@plurnk/plurnk-mimetypes-embeddings": {
            "optional": true
        }
    }
}
