{
    "name": "@plurnk/monorepo",
    "private": true,
    "version": "1.0.0",
    "description": "The plurnk platform monorepo — daemon core, contract, and bundled families. Root is orchestration only; every workspace publishes individually.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "packageManager": "npm@12.2.0",
    "workspaces": [
        "plurnk-spec-check",
        "plurnk-meta",
        "plurnk-contracts",
        "plurnk-modules",
        "plurnk-parser",
        "plurnk-aliases",
        "plurnk-agent-skills",
        "plurnk-agent-plugins",
        "plurnk-models",
        "plurnk-mimetypes-application-json",
        "plurnk-mimetypes-application-xml",
        "plurnk-mimetypes-application-jsonl",
        "plurnk-mimetypes-application-ipynb",
        "plurnk-mimetypes-application-pdf",
        "plurnk-mimetypes-image",
        "plurnk-mimetypes-audio",
        "plurnk-mimetypes-text-csv",
        "plurnk-mimetypes-text-html",
        "plurnk-mimetypes-text-markdown",
        "plurnk-mimetypes-text-plain",
        "plurnk-mimetypes-text-diff",
        "plurnk-mimetypes-text-ini",
        "plurnk-mimetypes-text-dotenv",
        "plurnk-mimetypes",
        "plurnk-schemes",
        "plurnk-schemes-http",
        "plurnk-execs",
        "plurnk-execs-common",
        "plurnk-mcp",
        "plurnk-hooks",
        "plurnk-otel",
        "plurnk-providers",
        "plurnk-digest",
        "plurnk-schedule",
        "plurnk-skills",
        "plurnk-auth",
        "plurnk-acp",
        "plurnk-core"
    ],
    "scripts": {
        "prepare": "git config core.hooksPath .githooks && npm run build",
        "start": "npm start -w @plurnk/plurnk-service",
        "share": "npm run -s share -w @plurnk/plurnk-service --",
        "audit:direction": "npm run build && node scripts/audit/direction.mjs",
        "audit:unused": "knip --config scripts/audit/knip.json --no-progress --no-config-hints",
        "audit:clones": "node scripts/audit/clones.mjs",
        "source:check": "oxlint --type-aware --report-unused-disable-directives .",
        "docs:check": "markdownlint-cli2",
        "changelog": "node scripts/changelog.mjs",
        "packages:publint": "node scripts/package-publint.mjs",
        "packages:types": "node scripts/package-types.mjs",
        "metadata:write": "node scripts/package-provenance.mjs --write",
        "metadata:check": "node scripts/package-provenance.mjs",
        "lifecycle:check": "node scripts/package-lifecycle-policy.mjs",
        "root:lint": "npm run lifecycle:check && npm run metadata:check && node scripts/dependency-policy.mjs && node scripts/package-build-policy.mjs && plurnk-spec-check --allowance scripts/spec-witness-allowance.json && node scripts/host-path-policy.mjs && node scripts/env-surface-policy.mjs && npm run source:check && npm run docs:check && node scripts/changelog.mjs --check",
        "root:unit": "node --experimental-test-coverage --test-coverage-include-all '--test-coverage-include=scripts/**' --test ${PLURNK_TEST_CONCURRENCY:+--test-concurrency=$PLURNK_TEST_CONCURRENCY} 'scripts/**/*.test.*'",
        "test:lint": "npm run root:lint && npm run test:lint --workspaces --if-present",
        "test:unit": "npm run root:unit && npm run test:unit --workspaces --if-present",
        "test:intg": "npm run test:intg --workspaces --if-present",
        "test:live": "npm run test:live -w @plurnk/plurnk-service --",
        "probe:providers": "npm run probe:providers -w @plurnk/plurnk-providers --",
        "test:client-conformance": "node scripts/test-client-conformance.mjs",
        "test": "node scripts/drill.mjs",
        "build": "npm run build --workspaces --if-present",
        "deps:check": "node scripts/deps-preflight.mjs",
        "changeset": "changeset",
        "release:version": "node scripts/release-version.mjs",
        "release:gate": "node scripts/deps-preflight.mjs && node scripts/release-gates.mjs",
        "release:check": "node scripts/release-check.mjs",
        "release:order": "node scripts/release-order.mjs",
        "release:publish": "node scripts/release-publish.mjs",
        "release:finalize": "node scripts/release-finalize.mjs",
        "config:defaults": "node --conditions=plurnk-dev plurnk-core/src/service.ts config defaults",
        "candidate": "node scripts/candidate.mjs",
        "orientation": "node scripts/orientation.mjs",
        "report:floor": "npm --workspace plurnk-core run report:floor",
        "report:sql": "node --conditions=plurnk-dev plurnk-core/scripts/sql-report.mjs"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@plurnk/plurnk-spec-check": "^0.2.0",
        "@changesets/cli": "3.0.3",
        "@possumtech/sqlrite": "^6.6.1",
        "@types/node": "^26.6.6",
        "dependency-cruiser": "18.7.0",
        "jscpd": "5.4.2",
        "knip": "6.44.0",
        "markdownlint-cli2": "^0.24.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "publint": "^0.3.25",
        "semver": "7.8.5",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "@google/genai@2.21.0": false,
        "esbuild@0.28.2": true,
        "protobufjs@7.6.6": false
    },
    "overrides": {
        "smol-toml": "^1.9.1"
    }
}
