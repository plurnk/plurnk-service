{
    "name": "@plurnk/monorepo",
    "private": true,
    "version": "1.0.0",
    "description": "The plurnk platform monorepo — daemon core, contract, and bundled families. Root is orchestration only; every workspace publishes individually.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "packageManager": "npm@11.18.0",
    "workspaces": [
        "plurnk-meta",
        "plurnk-aliases",
        "plurnk-contracts",
        "gbnf",
        "plurnk-models",
        "plurnk-plurnkdown",
        "plurnk-mimetypes-application-json",
        "plurnk-mimetypes-application-xml",
        "plurnk-mimetypes-application-jsonl",
        "plurnk-mimetypes-application-ipynb",
        "plurnk-mimetypes-application-pdf",
        "plurnk-mimetypes-text-csv",
        "plurnk-mimetypes-text-html",
        "plurnk-mimetypes-text-markdown",
        "plurnk-mimetypes-text-plain",
        "plurnk-mimetypes-text-diff",
        "plurnk-mimetypes-text-ini",
        "plurnk-mimetypes-text-dotenv",
        "plurnk-mimetypes-embeddings",
        "plurnk-mimetypes-tokenizers",
        "plurnk-mimetypes",
        "plurnk-schemes",
        "plurnk-schemes-http",
        "plurnk-execs",
        "plurnk-execs-common",
        "plurnk-mcp",
        "plurnk-hooks",
        "plurnk-execs-git",
        "plurnk-execs-isogit",
        "plurnk-execs-jq",
        "plurnk-execs-sqlite",
        "plurnk-execs-wasm",
        "plurnk-providers",
        "plurnk-agui",
        "plurnk-core"
    ],
    "scripts": {
        "prepare": "git config core.hooksPath .githooks && npm run build",
        "start": "npm start -w @plurnk/plurnk-service",
        "source:check": "oxlint --type-aware --report-unused-disable-directives .",
        "docs:check": "markdownlint-cli2",
        "packages:publint": "node scripts/package-publint.mjs",
        "metadata:write": "node scripts/package-provenance.mjs --write",
        "metadata:check": "node scripts/package-provenance.mjs",
        "lifecycle:check": "node scripts/package-lifecycle-policy.mjs",
        "pretest:lint": "npm run lifecycle:check",
        "test:lint": "npm run metadata:check && node scripts/dependency-policy.mjs && node scripts/package-build-policy.mjs && node scripts/spec-references.mjs && npm run source:check && npm run docs:check && npm run test:lint --workspaces --if-present",
        "pretest:unit": "npm run lifecycle:check",
        "test:unit": "node --test 'scripts/*.test.*' && npm run test:unit --workspaces --if-present",
        "pretest:intg": "npm run lifecycle:check",
        "test:intg": "npm run test:intg --workspaces --if-present",
        "pretest:live": "npm run lifecycle:check",
        "test:live": "npm run test:live -w @plurnk/plurnk-service",
        "pretest:demo": "npm run lifecycle:check",
        "test:demo": "npm run test:demo -w @plurnk/plurnk-service",
        "test:providersPing": "npm run test:providersPing -w @plurnk/plurnk-providers",
        "pretest": "npm run lifecycle:check",
        "test": "node scripts/drill.mjs",
        "build": "npm run build --workspaces --if-present",
        "deps:check": "node scripts/deps-preflight.mjs",
        "release:version": "node scripts/release-prepare.mjs",
        "release:check": "node scripts/release-check.mjs",
        "release:order": "node scripts/release-order.mjs",
        "release:publish": "node scripts/release-publish.mjs",
        "release:externals": "node scripts/release-external-packages.mjs",
        "external:census": "node plurnk-meta/scripts/external-package-census.mjs",
        "config:list": "node --conditions=plurnk-dev scripts/config-list.mjs",
        "candidate": "node scripts/candidate.mjs",
        "readiness:metaproject": "node scripts/orientation.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "markdownlint-cli2": "^0.23.2",
        "oxlint": "^1.78.0",
        "oxlint-tsgolint": "^7.0.2001",
        "publint": "^0.3.23",
        "typescript": "^7.0.2"
    }
}
