{
    "name": "@plurnk/plurnk-service",
    "version": "0.59.0",
    "description": "Plurnk agent runtime — the server / engine / core. Implements the @plurnk/plurnk-grammar contract.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "plurnk-service": "dist/service.js"
    },
    "files": [
        ".env.example",
        "dist/**/*",
        "docs/**/*",
        "migrations/**/*.sql",
        "requirements.md",
        "README.md",
        "SPEC.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "start": "node src/service.ts",
        "test:lint": "tsc --noEmit",
        "test:unit": "node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test --test --test-timeout=30000 src/**/*.test.ts",
        "test:intg": "npm run test:clean-tmp && PLURNK_FILES_ITEMS=0 node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test --test --test-concurrency=1 --test-timeout=30000 test/intg/*.test.ts",
        "test:live": "npm run test:clean-tmp && node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test --test --test-concurrency=1 test/live/*.test.ts",
        "test:demo": "npm run test:clean-tmp && node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test --test --test-concurrency=1 test/demo/*.test.ts",
        "test:all": "npm run test:lint && npm run test:unit && npm run test:intg && npm run test:demo",
        "test:digest": "node bin/digest.ts",
        "test:clean-tmp": "rm -rf test/intg/.tmp",
        "dev:digest": "node bin/digest.ts",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build:sql": "node scripts/copy-sql.mjs",
        "build": "npm run build:clean && npm run build:dist && npm run build:sql",
        "build:global:install": "npm run build && npm install -g .",
        "build:global:uninstall": "npm uninstall -g @plurnk/plurnk-service",
        "build:local:install": "node scripts/install-sandbox.mjs install",
        "build:local:uninstall": "node scripts/install-sandbox.mjs uninstall",
        "test:installation": "node scripts/test-installation.mjs",
        "deps:audit": "node scripts/deps-audit.ts",
        "prepare": "npm run build",
        "prepublishOnly": "npm run deps:audit"
    },
    "dependencies": {
        "@plurnk/plurnk-execs": "0.4.23",
        "@plurnk/plurnk-execs-all": "0.1.10",
        "@plurnk/plurnk-execs-mcp": "0.2.0",
        "@plurnk/plurnk-grammar": "0.74.40",
        "@plurnk/plurnk-mimetypes": "0.15.38",
        "@plurnk/plurnk-mimetypes-all": "0.5.6",
        "@plurnk/plurnk-mimetypes-text-html": "0.6.6",
        "@plurnk/plurnk-providers": "0.20.1",
        "@plurnk/plurnk-providers-all": "0.10.0",
        "@plurnk/plurnk-schemes": "0.32.2",
        "@plurnk/plurnk-schemes-all": "0.2.25",
        "@possumtech/sqlrite": "5.2.0",
        "diff": "^9.0.0",
        "ws": "^8.20.1"
    },
    "devDependencies": {
        "@plurnk/plurnk-mimetypes-embeddings": "0.6.0",
        "@types/diff": "^7.0.2",
        "@types/node": "^26.0.0",
        "@types/ws": "^8.18.1",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes-embeddings": "0.6.0"
    },
    "peerDependenciesMeta": {
        "@plurnk/plurnk-mimetypes-embeddings": {
            "optional": true
        }
    }
}
