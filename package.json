{
    "name": "@plurnk/monorepo",
    "private": true,
    "version": "1.0.0",
    "description": "The plurnk platform monorepo \u2014 daemon core, contract, and bundled families. Root is orchestration only; every workspace publishes individually.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "workspaces": [
        "plurnk-meta",
        "plurnk-aliases",
        "gbnf",
        "plurnk-models",
        "plurnk-grammar",
        "plurnk-plurnkdown",
        "plurnk-mimetypes-application-json",
        "plurnk-mimetypes-application-xml",
        "plurnk-mimetypes-application-jsonl",
        "plurnk-mimetypes-application-ipynb",
        "plurnk-mimetypes-application-pdf",
        "plurnk-mimetypes-text-csv",
        "plurnk-mimetypes-text-html",
        "plurnk-mimetypes-text-markdown",
        "plurnk-mimetypes-text-plain",
        "plurnk-mimetypes-text-diff",
        "plurnk-mimetypes-text-ini",
        "plurnk-mimetypes-text-dotenv",
        "plurnk-mimetypes-embeddings",
        "plurnk-mimetypes-tokenizers",
        "plurnk-mimetypes",
        "plurnk-schemes",
        "plurnk-schemes-http",
        "plurnk-execs",
        "plurnk-execs-common",
        "plurnk-execs-search",
        "plurnk-execs-mcp",
        "plurnk-execs-git",
        "plurnk-execs-jq",
        "plurnk-execs-sqlite",
        "plurnk-execs-wasm",
        "plurnk-providers",
        "plurnk-agui",
        "plurnk-core"
    ],
    "scripts": {
        "prepare": "git config core.hooksPath .githooks",
        "test:lint": "node scripts/dependency-policy.mjs && npm run test:lint --workspaces --if-present",
        "test:unit": "node --test 'scripts/*.test.mjs' && npm run test:unit --workspaces --if-present",
        "test:intg": "npm run test:intg --workspaces --if-present",
        "test": "node scripts/drill.mjs",
        "build": "npm run build --workspaces --if-present",
        "deps:check": "node scripts/deps-preflight.mjs",
        "release:version": "npm run generate -w plurnk-models && node scripts/deps-preflight.mjs && npm run build && node scripts/release-gates.mjs && node plurnk-meta/scripts/external-package-census.mjs --write && node scripts/release-version.mjs",
        "release:order": "node scripts/release-order.mjs",
        "release:publish": "node scripts/release-publish.mjs",
        "release:externals": "node scripts/release-external-packages.mjs",
        "external:census": "node plurnk-meta/scripts/external-package-census.mjs",
        "candidate": "node scripts/candidate.mjs",
        "readiness:metaproject": "node scripts/orientation.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "typescript": "^7.0.2"
    }
}
