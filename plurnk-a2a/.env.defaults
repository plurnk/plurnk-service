# @plurnk/plurnk-a2a — outbound peers and optional inbound exposure.
# Alias blocks define available remote agents; PLURNK_A2A_ENABLED selects the
# exact aliases enabled for newly-created Workers.
PLURNK_A2A_ENABLED=[]
PLURNK_A2A_CONNECT_TIMEOUT=30000
PLURNK_A2A_REQUEST_TIMEOUT=86400000

# PLURNK_A2A_RESEARCH=https://agent.example
# PLURNK_A2A_RESEARCH_CARD_PATH=/.well-known/agent-card.json
# PLURNK_A2A_RESEARCH_BEARER=${A2A_RESEARCH_TOKEN}
# PLURNK_A2A_RESEARCH_HEADERS={"X-Tenant":"${A2A_RESEARCH_TENANT}"}

# One optional Plurnk-hosted A2A exposure. Identity comes from this environment;
# protocol claims come from the implementation and cannot be configured falsely.
PLURNK_A2A_EXPOSE=0
PLURNK_A2A_HOST=127.0.0.1
PLURNK_A2A_PORT=4100
PLURNK_A2A_ENDPOINT_PATH=/a2a
PLURNK_A2A_ENDPOINT_URL=
PLURNK_A2A_WORKSPACE=a2a
PLURNK_A2A_PROJECT_ROOT=
PLURNK_A2A_NAME=
PLURNK_A2A_DESCRIPTION=
PLURNK_A2A_VERSION=
PLURNK_A2A_PROVIDER_ORGANIZATION=
PLURNK_A2A_PROVIDER_URL=
PLURNK_A2A_DOCUMENTATION_URL=
PLURNK_A2A_ICON_URL=
PLURNK_A2A_SKILLS=[]
