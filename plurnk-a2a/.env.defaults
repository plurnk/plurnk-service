# @plurnk/plurnk-a2a — remote agents and optional hosted exposure.

# --- Outbound agents ---
# Enable declared agents by default; per-alias _ENABLED overrides this.
PLURNK_A2A_ENABLED=1
# Connection/discovery deadline, positive ms.
PLURNK_A2A_CONNECT_TIMEOUT=30000
# Individual request deadline, positive ms.
PLURNK_A2A_REQUEST_TIMEOUT=86400000
# Maximum diagnostic characters in public errors.
PLURNK_A2A_ERROR_DETAIL_LIMIT=512
# A complete definition; name matches the lowercase alias (_ for -). Empty definitions are invalid.
# Optional cardPath, headers and authorization belong here; credentials stay symbolic references.
# PLURNK_A2A_research={"name":"research","url":"https://agent.example","authorization":{"type":"bearer","token":"${A2A_RESEARCH_TOKEN}"},"headers":{"X-Tenant":"${A2A_RESEARCH_TENANT}"}}
# PLURNK_A2A_research_ENABLED=0
# Any alias: its definition, and its own _ENABLED control.
# PLURNK_A2A_<alias>=<definition>

# --- Inbound exposure ---
# 1 = expose a Plurnk agent on the service listener (PLURNK_HOST:PLURNK_PORT); 0 = off. Protocol
# capabilities come from the implementation.
PLURNK_A2A_EXPOSE=0
# Bearer required on the endpoint, declared by the card; empty = an unauthenticated exposure, so
# protect a nonlocal deployment externally. The card at /.well-known/agent-card.json is public.
PLURNK_A2A_TOKEN=
# Absolute endpoint URL pathname, without query or fragment.
PLURNK_A2A_ENDPOINT_PATH=/a2a
# Public HTTP(S) endpoint advertised in the card; empty = derive from the service listener.
PLURNK_A2A_ENDPOINT_URL=
# Workspace used for inbound tasks.
PLURNK_A2A_WORKSPACE=a2a
# Absolute project root for a new inbound workspace; empty = headless.
PLURNK_A2A_PROJECT_ROOT=
# Existing parent of new Context workers; children inherit its approval owner.
# _plurnk has no reviewer: operations requiring approval are rejected unless server-approved.
PLURNK_A2A_PARENT_WORKER=_plurnk
# Agent card name; required when EXPOSE=1.
PLURNK_A2A_NAME=
# Agent card description; required when EXPOSE=1.
PLURNK_A2A_DESCRIPTION=
# Agent card version; required when EXPOSE=1.
PLURNK_A2A_VERSION=
# Optional card provider organization; set together with PROVIDER_URL.
PLURNK_A2A_PROVIDER_ORGANIZATION=
# Optional card provider HTTP(S) URL; set together with PROVIDER_ORGANIZATION.
PLURNK_A2A_PROVIDER_URL=
# Optional card documentation HTTP(S) URL.
PLURNK_A2A_DOCUMENTATION_URL=
# Optional card icon HTTP(S) URL.
PLURNK_A2A_ICON_URL=
# Card skills, JSON array of {id,name,description,tags?,examples?,inputModes?,outputModes?}.
# These describe A2A capabilities, not installed Agent Skills directories.
PLURNK_A2A_SKILLS=[]
