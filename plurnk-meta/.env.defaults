# @plurnk/plurnk-meta — package discovery and product orientation.

# Plugin trust: 1 = @plurnk/* only; comma-separated package names = @plurnk/* plus those packages;
# 0/empty = every installed package. A plugin runs inside the daemon, so a third party is named
# here by the operator, never admitted by being present. Also gates their defaults.
PLURNK_PLUGINS_TRUSTED_ONLY=1
# Whole-product orientation deadline, seconds; includes admitted-project search preparation.
PLURNK_ACCEPTANCE_TIMEOUT=3600
