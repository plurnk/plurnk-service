{
    "name": "@plurnk/plurnk-meta",
    "version": "2.0.0",
    "description": "Extension discovery and trust primitives shared by every plurnk kind, and the teaching material the plurnk service gives models: policy, Recap, the plurnk skill and scheme references.",
    "keywords": [
        "plurnk",
        "agent-skills",
        "skill",
        "documentation"
    ],
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "dependencies": {
        "@opentelemetry/api": "^1.9.1"
    },
    "files": [
        ".env.defaults",
        "dist/**/*",
        "README.md",
        "SPEC.md",
        "CORPUS.md",
        "POLICY.md",
        "recap.md",
        "docs/**/*",
        "skills/**/*",
        "DIVERGENCES.md"
    ],
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./agent-plugin": {
            "plurnk-dev": "./src/AgentPlugin.ts",
            "types": "./dist/AgentPlugin.d.ts",
            "default": "./dist/AgentPlugin.js"
        },
        "./configuration-error": {
            "plurnk-dev": "./src/ConfigurationError.ts",
            "types": "./dist/ConfigurationError.d.ts",
            "default": "./dist/ConfigurationError.js"
        },
        "./package.json": "./package.json",
        "./POLICY.md": "./POLICY.md",
        "./recap.md": "./recap.md",
        "./docs/*.md": "./docs/*.md"
    },
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file=.env.defaults --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepack": "npm run build",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test"
    },
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-meta#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-meta"
    }
}
