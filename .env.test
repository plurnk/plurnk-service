# The TEST cascade — every override here is a DECLARED BLIND SPOT vs the shipped defaults
# (shipped-defaults.test.ts guards the template itself; the tier scripts set PLURNK_SERVICE_POLICY so
# the real-model tiers run the prod policy section. The embedder stays OFF tier-wide — enabling
# it cost 4-10 min/test: warmSessionDerivations cold-spins a MiniLM pool per test process; the
# four vector-ranking intg suites re-enable it per-file, which is the coverage).
PLURNK_SERVICE_DB_PATH=./plurnk.test.db
PLURNK_PORT=3045

# Isolate tests from any operator-set PLURNK_SERVICE_MD_POLICY (an ~/.plurnk/.env or shell
# value would make turn-0 foist an extra `READ plurnk:///POLICY.md` row — env-dependent
# test pollution). Empty = skipped (Paths.docs). doc-injection.test.ts self-provisions
# its own PLURNK_SERVICE_MD_* so its coverage is unaffected.
PLURNK_SERVICE_MD_POLICY=

# Isolate tests from the SYSTEM POLICY section too: readSystemPolicy() defaults to
# ~/.plurnk/AGENTS.md (the operator's dogfooding policy + personal style guide), which
# would otherwise foist ~1750 tokens of irrelevant operator content into every test/demo/live
# packet and bloat the budget floor. Explicit-empty = off (packet-inject readSystemPolicy).
PLURNK_SERVICE_POLICY=

# Fast lane is FTS-only: the embeddings package is a devDependency (installed here), so a bare
# `new Mimetypes()` would otherwise spin up the MiniLM worker pool and embed every materialized
# entry in every mock-provider test — pure waste for logic tests. The handful of tests that assert
# vector ranking re-enable it (delete process.env.PLURNK_SERVICE_EMBED_DISABLE) in their own setup.
PLURNK_SERVICE_EMBED_DISABLE=1

# Arm the turn ceiling under test: .env.example ships PLURNK_SERVICE_MAX_TURNS=-1 (uncapped), which
# leaves a wandering-but-green live loop with NO engine terminal — the harness wall-clock then
# cancels it from outside, yielding a corpse instead of a digestible 429. No test requests more
# than 20 turns, so the cap changes no test's ask; it only guarantees every loop ends legibly.
PLURNK_SERVICE_MAX_TURNS=50

# Partition reserves scaled for MOCK windows (a 8192-token Mock can't fit the real 13312 of
# reserves — promptBudget must stay positive). A declared blind spot: the REAL reserves ride
# the test:live/test:demo script prefixes, and shipped-defaults.test pins the template's
# 64Ki invariant. CTX inherits the shipped 78848.
PLURNK_SERVICE_REASONING=256
PLURNK_SERVICE_ASSISTANT=1024
PLURNK_SERVICE_SAFETY=64
