PLURNK_DB_PATH=./plurnk.test.db
PLURNK_PORT=3045

# Isolate tests from the operator's policy-doc foist. .env.example sets
# PLURNK_MD_POLICY=~/.plurnk/AGENTS.md (the operator default); without this
# override, whether that file EXISTS on the dev/CI box decides whether every
# turn-0 foists an extra `READ plurnk:///POLICY.md` row — env-dependent test
# pollution. Empty = skipped (Paths.docs). doc-injection.test.ts self-provisions
# its own PLURNK_MD_* so its coverage is unaffected.
PLURNK_MD_POLICY=

# Isolate tests from the SYSTEM POLICY section too: readSystemPolicy() defaults to
# ~/.plurnk/AGENTS.md (the operator's dogfooding policy + personal style guide), which
# would otherwise foist ~1750 tokens of irrelevant operator content into every test/demo/live
# packet and bloat the budget floor. Explicit-empty = off (packet-inject readSystemPolicy).
PLURNK_POLICY=

# Fast lane is FTS-only: the embeddings package is a devDependency (installed here), so a bare
# `new Mimetypes()` would otherwise spin up the MiniLM worker pool and embed every materialized
# entry in every mock-provider test — pure waste for logic tests. The handful of tests that assert
# vector ranking re-enable it (delete process.env.PLURNK_EMBED_DISABLE) in their own setup.
PLURNK_EMBED_DISABLE=1
