{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    // {§lint-gate} — oxlint runs type-aware beside tsc (`source:check` in root `test:lint`); every exception
    // below says why (#1162). The rules the tree carried before 2026-10-18 are kept.
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "perf": "error"
    },
    "plugins": [
        "typescript",
        "unicorn",
        "oxc",
        "import",
        "promise",
        "node"
    ],
    "ignorePatterns": [
        "**/.tmp/**",
        "**/dist/**",
        "**/generated/**",
        "**/node_modules/**",
        "**/vendor/**",
        "**/.plurnk/**",
        "**/coverage/**"
    ],
    "rules": {
        "eslint/no-unused-private-class-members": "error",
        "eslint/no-var": "error",
        // A binding a closure reads before its one assignment (`t.after(() => owner?.stop())`) stays `let`.
        "eslint/prefer-const": ["error", { "ignoreReadBeforeAssign": true }],
        "unicorn/prefer-node-protocol": "error",
        "typescript/no-deprecated": "error",
        "typescript/no-explicit-any": "error",
        // An unused parameter an interface or a destructuring still has to name starts with `_`.
        "eslint/no-unused-vars": [
            "error",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_",
                "caughtErrors": "none",
                "ignoreRestSiblings": true
            }
        ],
        // {§persistence-via-sqlrite}: internal persistence SQL belongs in package-owned SqlRite statements.
        "eslint/no-restricted-imports": [
            "error",
            {
                "paths": [
                    {
                        "name": "node:sqlite",
                        "message": "Internal persistence SQL belongs in package-owned SqlRite statements."
                    }
                ]
            }
        ],
        "import/no-cycle": "error",
        "typescript/no-floating-promises": "error",
        // `== null` is the one idiomatic loose comparison: null or undefined, nothing else.
        "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
        "eslint/no-useless-constructor": "error",
        "import/no-duplicates": "error",
        // A `.then(onFulfilled, onRejected)` pair handles rejection; the rule's default refuses it.
        "promise/catch-or-return": ["error", { "allowThen": true }],
        // Sequential awaits are frequently the point here (ordered dispatch, one request after another);
        // the rule stays off until its exceptions can be stated as a contract (#1162).
        "eslint/no-await-in-loop": "off",
        // The codebase preserves a caught error by throwing `AggregateError([cause, …])`, which the rule
        // does not recognize as preservation; the sites that dropped a cause were fixed by hand (#1162).
        "eslint/preserve-caught-error": "off",
        // `new RegExp(pattern)` and `new Headers(…)` inside a try are the standard validation of an
        // authored pattern or header field; the constructor's throw is the result.
        "eslint/no-new": "off",
        // `_plurnk` is the runtime worker's name in the contract, and `_`-prefixed fields name private
        // test seams; the dangle is the identifier.
        "eslint/no-underscore-dangle": "off",
        // Opinions, not idiom here: a helper defined where it is read is the codebase's style, and a class of
        // static members is how this codebase names a module-level namespace (Results, Namespace, FileAddress).
        "unicorn/consistent-function-scoping": "off",
        "typescript/no-extraneous-class": "off",
        // Idioms brought to zero by the fixer and hand batches (#1162): denied.
        "typescript/consistent-type-imports": "error",
        "typescript/no-unnecessary-template-expression": "error",
        "typescript/no-unnecessary-type-arguments": "error",
        "typescript/no-unnecessary-boolean-literal-compare": "error",
        "typescript/no-this-alias": "error",
        "typescript/no-redundant-type-constituents": "error",
        "typescript/no-unnecessary-type-conversion": "error",
        "typescript/no-unnecessary-type-parameters": "error",
        "typescript/require-array-sort-compare": "error",
        "unicorn/no-array-sort": "error",
        "unicorn/no-array-reverse": "error",
        "unicorn/prefer-string-starts-ends-with": "error",
        "unicorn/prefer-array-find": "error",
        "unicorn/prefer-array-flat-map": "error",
        "unicorn/prefer-set-size": "error",
        "unicorn/no-useless-fallback-in-spread": "error",
        "unicorn/no-new-array": "error",
        "unicorn/no-thenable": "error",
        "oxc/no-accumulating-spread": "error",
        // `[...text].length` counts code points, the column unit of text coordinates, and `[...map.keys()]` snapshots a
        // collection the loop body settles; the rule reads both as useless and its fix changes their meaning.
        "unicorn/no-useless-spread": "off",
        // The MCP SDK transports are handler-property APIs (`onmessage`, `onclose`), not EventTargets.
        "unicorn/prefer-add-event-listener": "off",
        // A short list checked with `includes` reads as the list it is; the rule is a performance opinion.
        "unicorn/prefer-set-has": "off",
        // `.map((row) => ({ ...row, … }))` is the projection idiom here; the rule is a performance opinion.
        "oxc/no-map-spread": "off",
        // `promise/catch-or-return` holds; a `.then` handler that returns nothing is a settled side effect, not a dropped value.
        "promise/always-return": "off",
        // Static members of a namespace class carry no `this`; destructuring them is this codebase's import style.
        "typescript/unbound-method": ["error", { "ignoreStatic": true }],
        // Named after their own sweeps (#1162).
        // node:test's subtest context is `t` inside the parent's `t`; everything else is renamed site by site.
        "eslint/no-shadow": ["error", { "allow": ["t"] }],
        // An exhaustive `switch` over a union ends without a `return` and tsc proves it total; a `catch` that ends in a
        // `never` call is the same. The syntactic rule sees neither.
        "typescript/consistent-return": "off",
        "typescript/explicit-module-boundary-types": "error",
        // The two counted debts after batch 8 (#1162): 795 unsafe assertions in sources, to be retired boundary by boundary
        // (tests are excused below: a witness's assertion is its claim); 34 assertions tsgolint reads as unnecessary that
        // tsc still needs (from `unknown` or `object`), a warning until the two checkers agree.
        "typescript/no-unsafe-type-assertion": "warn",
        "typescript/no-unnecessary-type-assertion": "warn",
        // A string enum compared with one of its own literals is checked by tsc (TS2367 on any other literal); the literal
        // is the wire name the protocol documents.
        "typescript/no-unsafe-enum-comparison": "off",
        "typescript/no-base-to-string": "error",
        "typescript/no-misused-spread": "error",
        "typescript/restrict-template-expressions": "error"
    },
    "overrides": [
        {
            "files": [
                "plurnk-execs-sqlite/src/Sqlite.ts"
            ],
            "rules": {
                "eslint/no-restricted-imports": "off"
            }
        },
        {
            "files": [
                "**/*.test.js",
                "**/*.test.mjs",
                "**/*.test.ts",
                "**/test/**"
            ],
            "rules": {
                "typescript/no-floating-promises": "off",
                // A seam captures an original method to restore it; `assert.equal(x.method, undefined)` reads a slot.
                "typescript/unbound-method": "off",
                // A witness's assertion is its claim about the shape it reads; a wrong claim fails the witness.
                "typescript/no-unsafe-type-assertion": "off"
            }
        },
        {
            // Untyped scripts: these rules cannot see the types they judge.
            "files": [
                "**/*.mjs",
                "**/*.js"
            ],
            "rules": {
                "typescript/require-array-sort-compare": "off",
                "typescript/restrict-template-expressions": "off",
                "typescript/no-base-to-string": "off"
            }
        },
        {
            // Generated by SqlRite codegen (`npm run types:sqlrite`), not hand-written.
            "files": [
                "**/SqlRite*.d.ts"
            ],
            "rules": {
                "typescript/no-unnecessary-type-parameters": "off"
            }
        }
    ]
}
