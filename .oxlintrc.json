{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    // {§lint-gate} — oxlint runs type-aware beside tsc (`source:check` in root `test:lint`); every exception
    // below says why (#1162). The rules the tree carried before 2026-10-18 are kept.
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "perf": "error"
    },
    "plugins": [
        "typescript",
        "unicorn",
        "oxc",
        "import",
        "promise",
        "node"
    ],
    "ignorePatterns": [
        "**/.tmp/**",
        "**/dist/**",
        "**/generated/**",
        "**/node_modules/**",
        "**/vendor/**",
        "**/.plurnk/**",
        "**/coverage/**"
    ],
    "rules": {
        "eslint/no-unused-private-class-members": "error",
        "eslint/no-var": "error",
        // A binding a closure reads before its one assignment (`t.after(() => owner?.stop())`) stays `let`.
        "eslint/prefer-const": ["error", { "ignoreReadBeforeAssign": true }],
        "unicorn/prefer-node-protocol": "error",
        // 23 deprecations on 2026-10-18 (AI SDK `finalStep`/`stream`/`include`, zod `looseObject`, `process.umask()`,
        // MCP `ClientCredentialsProvider`, xmldom `errorHandler`, otel `AsyncHooksContextManager`): batch 2 of #1162.
        "typescript/no-deprecated": "warn",
        "typescript/no-explicit-any": "error",
        // An unused parameter an interface or a destructuring still has to name starts with `_`.
        "eslint/no-unused-vars": [
            "error",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_",
                "caughtErrors": "none",
                "ignoreRestSiblings": true
            }
        ],
        // {§persistence-via-sqlrite}: internal persistence SQL belongs in package-owned SqlRite statements.
        "eslint/no-restricted-imports": [
            "error",
            {
                "paths": [
                    {
                        "name": "node:sqlite",
                        "message": "Internal persistence SQL belongs in package-owned SqlRite statements."
                    }
                ]
            }
        ],
        "import/no-cycle": "error",
        "typescript/no-floating-promises": "error",
        // `== null` is the one idiomatic loose comparison: null or undefined, nothing else.
        "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
        "eslint/no-useless-constructor": "error",
        "import/no-duplicates": "error",
        // A `.then(onFulfilled, onRejected)` pair handles rejection; the rule's default refuses it.
        "promise/catch-or-return": ["error", { "allowThen": true }],
        // Sequential awaits are frequently the point here (ordered dispatch, one request after another);
        // the rule stays off until its exceptions can be stated as a contract (#1162).
        "eslint/no-await-in-loop": "off",
        // The codebase preserves a caught error by throwing `AggregateError([cause, …])`, which the rule
        // does not recognize as preservation; the sites that dropped a cause were fixed by hand (#1162).
        "eslint/preserve-caught-error": "off",
        // `new RegExp(pattern)` and `new Headers(…)` inside a try are the standard validation of an
        // authored pattern or header field; the constructor's throw is the result.
        "eslint/no-new": "off",
        // `_plurnk` is the runtime worker's name in the contract, and `_`-prefixed fields name private
        // test seams; the dangle is the identifier.
        "eslint/no-underscore-dangle": "off",
        // Opinions, not idiom here: a helper defined where it is read is the codebase's style, and a class of
        // static members is how this codebase names a module-level namespace (Results, Namespace, FileAddress).
        "unicorn/consistent-function-scoping": "off",
        "typescript/no-extraneous-class": "off",
        // Counted debts, 2026-10-18 (#1162): warnings until their sites are rewritten, batch by batch.
        "eslint/no-shadow": "warn",
        "promise/always-return": "warn",
        "unicorn/no-array-sort": "warn",
        "unicorn/no-array-reverse": "warn",
        "unicorn/prefer-string-starts-ends-with": "warn",
        "unicorn/prefer-array-find": "warn",
        "unicorn/prefer-array-flat-map": "warn",
        "unicorn/prefer-set-has": "warn",
        "unicorn/prefer-set-size": "warn",
        "unicorn/no-useless-spread": "warn",
        "unicorn/no-useless-fallback-in-spread": "warn",
        "unicorn/no-new-array": "warn",
        "unicorn/prefer-add-event-listener": "warn",
        "unicorn/no-thenable": "warn",
        "oxc/no-map-spread": "warn",
        "oxc/no-accumulating-spread": "warn",
        "typescript/no-this-alias": "warn",
        "typescript/consistent-type-imports": "warn",
        "typescript/explicit-module-boundary-types": "warn",
        // Type-aware strictness, counted 2026-10-18: unsafe assertions 3,044, unnecessary assertions 1,968,
        // unbound methods 248, enum comparisons 159, base-to-string 134, template expressions 52, misused
        // spreads 41, type conversions 32, consistent-return 31 — each a batch of its own (#1162).
        "typescript/no-unsafe-type-assertion": "warn",
        "typescript/no-unnecessary-type-assertion": "warn",
        "typescript/unbound-method": "warn",
        "typescript/no-unsafe-enum-comparison": "warn",
        "typescript/no-base-to-string": "warn",
        "typescript/no-unnecessary-template-expression": "warn",
        "typescript/no-misused-spread": "warn",
        "typescript/no-unnecessary-type-conversion": "warn",
        "typescript/consistent-return": "warn",
        // Type-aware rules the suspicious and perf categories brought in, counted 2026-10-18: template expressions 26,
        // redundant type constituents 26, sort without compare 23, type parameters 9, type arguments 8, boolean
        // literal compares 7 (#1162).
        "typescript/restrict-template-expressions": "warn",
        "typescript/no-redundant-type-constituents": "warn",
        "typescript/require-array-sort-compare": "warn",
        "typescript/no-unnecessary-type-parameters": "warn",
        "typescript/no-unnecessary-type-arguments": "warn",
        "typescript/no-unnecessary-boolean-literal-compare": "warn"
    },
    "overrides": [
        {
            "files": [
                "plurnk-execs-sqlite/src/Sqlite.ts"
            ],
            "rules": {
                "eslint/no-restricted-imports": "off"
            }
        },
        {
            "files": [
                "**/*.test.js",
                "**/*.test.mjs",
                "**/*.test.ts",
                "**/test/**"
            ],
            "rules": {
                "typescript/no-floating-promises": "off"
            }
        }
    ]
}
