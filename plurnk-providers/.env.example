# @plurnk/plurnk-providers — operator config reference (SPEC §4/§5).
#
# Every PLURNK_* knob below is REQUIRED and read with no in-code default: an
# unset/invalid value fails hard at provider construction, naming the var. This
# is deliberate (fail-hard contract) — there are no silent fallbacks. The
# consuming service copies the vars it needs into its own .env; this file is the
# authoritative list of what the provider layer reads.

# ── Alias cascade (SPEC §5) ──────────────────────────────────────────────────
# Declare aliases, then select the active one. First path segment is the
# provider name; the rest is the provider-native model id (may contain "/").
PLURNK_MODEL_gemma=openai/macher.gguf
PLURNK_MODEL_opus=anthropic/claude-opus-4-8
PLURNK_MODEL_sonnet=openrouter/anthropic/claude-sonnet-latest
PLURNK_MODEL=gemma

# ── Universal knobs — read by EVERY provider (SPEC §4) ───────────────────────
# Side-channel reasoning budget: 0 off, -1 adaptive (no cap), N>0 capped.
PLURNK_PROVIDERS_REASONING_BUDGET=0
# Per-request fetch ceiling in ms (PER attempt, not shared across retries).
PLURNK_FETCH_TIMEOUT=600000
# Transient-failure retry budget: 0 surfaces the first failure; N retries on
# 429/5xx/timeout/network with exponential backoff (honors Retry-After).
PLURNK_PROVIDER_RETRY_ATTEMPTS=3
# Optional: override the reported context window. Resolution:
#   this var → live endpoint probe → models.dev catalog → null.
# PLURNK_PROVIDER_CONTEXT_SIZE=200000

# ── Host plugin trust gate (SPEC §5, shared across the plurnk families) ───────
# Unset/empty/0 → every installed provider loads. A value → @plurnk/* always
# trusted, plus a comma-separated allowlist ("1" = first-party only).
# PLURNK_PLUGINS_TRUSTED_ONLY=0

# ── Per-provider credentials & endpoints ─────────────────────────────────────
# Standard providers (no package — frozen table). Set the key for the ones you use.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # or a local llama-server / vLLM base; alias: OPENAI_API_BASE
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=                           # aliases also accepted: DEEPINFRA_API_TOKEN, DEEPINFRA_TOKEN
ANTHROPIC_API_KEY=                          # first-party Claude (compat endpoint)
AWS_BEARER_TOKEN_BEDROCK=                    # Bedrock API key (bearer; SigV4 not required)
# Bedrock base: set BEDROCK_BASE_URL explicitly, OR leave it unset and the base is
# derived from AWS_REGION / AWS_DEFAULT_REGION. Note the OpenAI-compat path is /openai/v1.
# BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1

# plurnk hosted model — llama.cpp at model.plurnk.ai. A single OPTIONAL bearer
# (the key identifies the account server-side); sent only when set.
# PLURNK_API_KEY=                           # bearer credential (optional)
# PLURNK_BASE_URL=https://model.plurnk.ai/v1   # override the default endpoint

# Bespoke daughters (each needs its own @plurnk/plurnk-providers-<name> installed;
# the -all bundle installs all five). Set the key/URL for the ones you use.
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434      # or the official OLLAMA_HOST (e.g. 127.0.0.1:11434)
GEMINI_API_KEY=                             # alias also accepted: GOOGLE_API_KEY (GEMINI_API_KEY wins)
XAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=                       # alias also accepted: CF_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=                        # alias also accepted: CF_API_TOKEN

# Optional per-provider tokenizer override (heuristic | cl100k_base | llama):
# OPENAI_TOKENIZER=cl100k_base

# ── NOT read here — this is a SERVICE-side knob, listed to avoid confusion ────
# PLURNK_PROVIDERS_GBNF   — the grammar the service resolves and passes per call;
#                           its canonical form requires PLAN. No provider knob.
