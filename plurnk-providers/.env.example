# @plurnk/plurnk-providers — operator config reference (SPEC §4/§5).
#
# Every PLURNK_* knob below is REQUIRED and read with no in-code default: an
# unset/invalid value fails hard at provider construction, naming the var. This
# is deliberate (fail-hard contract) — there are no silent fallbacks. The
# consuming service copies the vars it needs into its own .env; this file is the
# authoritative list of what the provider layer reads.

# ── Alias cascade (SPEC §5) ──────────────────────────────────────────────────
# Declare aliases, then select the active one. First path segment is the
# provider name; the rest is the provider-native model id (may contain "/").
PLURNK_MODEL_gemma=openai/macher.gguf
PLURNK_MODEL_opus=anthropic/claude-opus-4-8
PLURNK_MODEL_sonnet=openrouter/anthropic/claude-sonnet-latest
PLURNK_MODEL=gemma
#
# Per-alias endpoint override — PLURNK_BASEURL_<alias>. The only way to run N
# self-hosted boxes of the same provider (openai = llama.cpp/vLLM; ollama): it
# binds an endpoint to the ALIAS and wins over the provider's own *_BASE_URL.
# Meaningful only for the self-hosted providers; a dangling override fails hard.
# PLURNK_MODEL_HAZEL1=openai/qwen2.5-coder
# PLURNK_BASEURL_HAZEL1=http://hazel1:8080/v1
# PLURNK_MODEL_HAZEL2=openai/qwen3-coder
# PLURNK_BASEURL_HAZEL2=http://hazel2:8080/v1
# PLURNK_MODEL_NOOK=ollama/qwen2.5-coder
# PLURNK_BASEURL_NOOK=http://nook:11434

# ── Universal knobs — read by EVERY provider (SPEC §4) ───────────────────────
# Side-channel thinking: ACTIVATION and CAPACITY are separate (#33) — a numeric
# can never silently flip wire flags. THINKING is off | adaptive | on; CAPACITY
# (positive int) is required iff on, and on llama.cpp MUST equal the box's
# --reasoning-budget launch flag (per-request numerics are ignored there).
# Intent maps the same with or without a grammar — reasoning and rails coexist
# (fireworks masks content only; canary-verified, TUNING-EPIC F9; #32 clamp lifted).
# Envelope: give high-effort reasoners max_tokens headroom (deepseek-v4-pro at
# "high" overruns a 4096 cap; "low"/"adaptive" conform within it).
PLURNK_PROVIDERS_THINKING=off
# PLURNK_PROVIDERS_THINKING_CAPACITY=4096
# Decode tuning — measured canonical values (bench/TUNING-EPIC.md F1/F6; #9/#30).
# TEMPERATURE is the default for EVERY request, under caller sampling; the repeat
# penalty is a FLOOR the provider manages wherever a grammar rides. EVERY
# PLURNK_PROVIDERS_ knob in this file is alias-scopable: _<alias> wins over bare.
PLURNK_PROVIDERS_TEMPERATURE=0.2
PLURNK_PROVIDERS_REPEAT_PENALTY=1.15
# Transient-retry backoff base (attempt N waits DELAY * 2^(N-1); Retry-After wins)
PLURNK_PROVIDERS_RETRY_DELAY=2000
# Boot capability-probe retries (#34): one hiccup must never decide capability.
PLURNK_PROVIDERS_PROBE_ATTEMPTS=3
PLURNK_PROVIDERS_PROBE_DELAY=250
# Per-request fetch ceiling in ms (PER attempt, not shared across retries).
PLURNK_PROVIDERS_FETCH_TIMEOUT=600000
# Transient-failure retry budget: 0 surfaces the first failure; N retries on
# 429/5xx/timeout/network with exponential backoff (honors Retry-After).
PLURNK_PROVIDERS_RETRY_ATTEMPTS=3
# Optional: override the reported context window. Resolution:
#   this var → live endpoint probe → models.dev catalog → null.
# When ALL THREE miss, the provider warns once (PLURNK_CONTEXT_UNKNOWN) naming
# the model — set this var (alias-scopable _<alias>) so window budgets are
# deliberate rather than inherited from numbers tuned for another model.
# PLURNK_PROVIDERS_CONTEXT_SIZE=200000
# Optional GBNF debug toggle (off by default; 0/empty = off, any other value = on).
# When on, a transported grammar is validated locally and a MALFORMED one throws
# before any wire call — and the grammar is NOT sent to the model (the request runs
# unconstrained). A dev aid for catching invalid grammars; leave off in production.
# PLURNK_PROVIDERS_GBNF_DEBUG=0

# ── Data capture (#36, SPEC §14): opt-in, OFF by default, per-alias-scopable ──
# The flag IS the isolation: a serving turn requests and carries NOTHING. Enable
# these ONLY on a dataset-scraping alias (append _<alias>, e.g. _fireslow) — every
# other alias is byte-for-byte unchanged. Universal across every provider.
# PLURNK_PROVIDERS_LOGPROB — non-negative int = top_logprobs. Set → request
#   per-token logprobs; surfaced on response.assistant.logprobs[] ({token, logprob,
#   top?}) + assistant.meanLogprob. `logprob` is the RAW model value (the honest,
#   sampling-invariant confidence — Fireworks' sampling_logprob measured identical
#   under grammar). 0 = chosen-token only; 3 = + top-3 alternatives. Unset = off.
# PLURNK_PROVIDERS_RAWBODY — truthy (not ""/"0") → attach the VERBATIM backend
#   wire body to response.rawBody (the digest assistantRaw drops choices[]; this
#   keeps everything: sampling_logprob, token_id, bytes). Off by default.
# PLURNK_PROVIDERS_LOGPROB_fireslow=3
# PLURNK_PROVIDERS_RAWBODY_fireslow=1

# ── Host plugin trust gate (SPEC §5, shared across the plurnk families) ───────
# Unset/empty/0 → every installed provider loads. A value → @plurnk/* always
# trusted, plus a comma-separated allowlist ("1" = first-party only).
# PLURNK_PLUGINS_TRUSTED_ONLY=0

# ── Per-provider credentials & endpoints ─────────────────────────────────────
# Standard providers (no package — frozen table). Each *_BASE_URL is REQUIRED and
# read with no in-code default (fail-hard) — the canonical endpoint lives HERE,
# never baked into the code. Set the API key for the ones you use; the base URLs
# ship at their vendor defaults, ready to copy.

# Generic OpenAI-compatible endpoint (OpenAI proper, or a local llama-server / vLLM).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1    # alias: OPENAI_API_BASE
# OPENAI_LLAMA_SERVER=1                      # pin llama-server capabilities (skip flaky
                                             # detection, #34); 0 forces plain remote; unset = auto

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
DEEPINFRA_API_KEY=                           # aliases also accepted: DEEPINFRA_API_TOKEN, DEEPINFRA_TOKEN
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# Chinese cloud hosts. Base ships as the INTERNATIONAL endpoint; mainland
# operators point *_BASE_URL at the provider's `.cn` twin (see provider docs).
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
DASHSCOPE_API_KEY=                           # Alibaba Qwen (DashScope compatible-mode)
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ZHIPUAI_API_KEY=                             # Zhipu GLM; alias also accepted: ZAI_API_KEY
ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4
ARK_API_KEY=                                 # ByteDance Doubao (BytePlus ModelArk)
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
HUNYUAN_API_KEY=                             # Tencent Hunyuan
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
STEP_API_KEY=                                # StepFun
STEPFUN_BASE_URL=https://api.stepfun.com/v1
BAICHUAN_API_KEY=
BAICHUAN_BASE_URL=https://api.baichuan-ai.com/v1
QIANFAN_API_KEY=                             # Baidu ERNIE (Qianfan v2)
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
MODELSCOPE_API_KEY=                          # alias also accepted: MODELSCOPE_TOKEN
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# First-party Claude (Anthropic's OpenAI-compat endpoint).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# AWS Bedrock (OpenAI-compat path is /openai/v1). The base is region-templated:
# set BEDROCK_BASE_URL explicitly, OR leave it unset to derive it from
# AWS_REGION / AWS_DEFAULT_REGION.
AWS_BEARER_TOKEN_BEDROCK=                     # Bedrock API key (bearer; SigV4 not required)
# BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1

# plurnk hosted model. PLURNK_API_KEY is an OPTIONAL bearer (sent only when set).
# PLURNK_API_KEY=
PLURNK_BASE_URL=https://plurnk.ai/v1
# PLURNK_BASE_URL=http://plurnksnr2kihuukt6v22ko72r34dxeatbsfhgow3hvnlw6btanxphad.onion/v1   # swap in to reach plurnk over Tor

# Bespoke daughters (each needs its own @plurnk/plurnk-providers-<name> installed;
# the -all bundle installs all five). Set the key/URL for the ones you use.
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434      # or the official OLLAMA_HOST (e.g. 127.0.0.1:11434)
GEMINI_API_KEY=                             # alias also accepted: GOOGLE_API_KEY (GEMINI_API_KEY wins)
XAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=                       # alias also accepted: CF_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=                        # alias also accepted: CF_API_TOKEN

# Tokenizer families were REMOVED (tokenizer shed, mimetypes#44): exact counting
# lives in the @plurnk/plurnk-mimetypes tokenizer seam + Provider.tokenize();
# countTokens is a surfaced chars/2 upper bound. A still-set *_TOKENIZER fails hard.

# ── NOT read here — this is a SERVICE-side knob, listed to avoid confusion ────
# PLURNK_PROVIDERS_GBNF   — the grammar the service resolves and passes per call;
#                           its canonical form requires PLAN. No provider knob.
