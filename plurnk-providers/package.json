{
    "name": "@plurnk/plurnk-providers",
    "version": "5.0.2",
    "description": "PLURNK's stable model-provider contract and provider SDK adapter.",
    "keywords": [
        "plurnk",
        "llm",
        "provider",
        "tokenizer"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-providers#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-providers"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./openai": {
            "plurnk-dev": "./src/openai.ts",
            "types": "./dist/openai.d.ts",
            "default": "./dist/openai.js"
        },
        "./accounting": {
            "plurnk-dev": "./src/accountingPublic.ts",
            "types": "./dist/accountingPublic.d.ts",
            "default": "./dist/accountingPublic.js"
        },
        "./errors": {
            "plurnk-dev": "./src/providerError.ts",
            "types": "./dist/providerError.d.ts",
            "default": "./dist/providerError.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "SPEC.md",
        "docs/**/*.md",
        ".env.defaults"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file=.env.defaults --experimental-test-coverage --test-coverage-include-all '--test-coverage-include=src/**' --test ${PLURNK_TEST_CONCURRENCY:+--test-concurrency=$PLURNK_TEST_CONCURRENCY} 'src/**/*.test.ts' 'scripts/**/*.test.mjs'",
        "probe:providers": "bash ../scripts/operator-environment.sh node --conditions=plurnk-dev scripts/providers-ping.mjs",
        "probe:tokens": "bash ../scripts/operator-environment.sh node --conditions=plurnk-dev scripts/token-envelope-probe.mjs",
        "test": "npm run test:lint && npm run test:unit",
        "release:check": "node scripts/runtime-neutral-session-smoke.mjs",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test && npm run build && npm run release:check",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@earendil-works/pi-ai": "1.4.0",
        "@plurnk/plurnk-aliases": "^2.0.0",
        "@plurnk/plurnk-contracts": "^6.0.0",
        "@plurnk/plurnk-meta": "^2.1.0",
        "@plurnk/plurnk-models": "^3.0.0"
    },
    "devDependencies": {
        "esbuild": "^0.28.2"
    }
}
