{
    "name": "@plurnk/plurnk-providers",
    "version": "3.0.3",
    "description": "PLURNK's stable model-provider contract and AI SDK adapter.",
    "keywords": [
        "plurnk",
        "llm",
        "provider",
        "tokenizer"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-providers#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-providers"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./openai": {
            "plurnk-dev": "./src/openai.ts",
            "types": "./dist/openai.d.ts",
            "default": "./dist/openai.js"
        },
        "./accounting": {
            "plurnk-dev": "./src/accountingPublic.ts",
            "types": "./dist/accountingPublic.d.ts",
            "default": "./dist/accountingPublic.js"
        },
        "./errors": {
            "plurnk-dev": "./src/providerError.ts",
            "types": "./dist/providerError.d.ts",
            "default": "./dist/providerError.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "SPEC.md",
        "docs/**/*.md",
        ".env.defaults"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file=.env.defaults --test src/**/*.test.ts scripts/*.test.mjs",
        "test:providersPing": "bash ../scripts/operator-environment.sh node --conditions=plurnk-dev --import=../plurnk-core/test/floor.ts --env-file-if-exists=../plurnk-core/.env.defaults --env-file-if-exists=${XDG_CONFIG_HOME:-$HOME/.config}/plurnk/.env --env-file-if-exists=../plurnk-core/.env --env-file-if-exists=../plurnk-core/.env.test scripts/providers-ping.mjs",
        "probe:tokens": "bash ../scripts/operator-environment.sh node --conditions=plurnk-dev --import=../plurnk-core/test/floor.ts --env-file-if-exists=../plurnk-core/.env.defaults --env-file-if-exists=${XDG_CONFIG_HOME:-$HOME/.config}/plurnk/.env --env-file-if-exists=../plurnk-core/.env --env-file-if-exists=../plurnk-core/.env.test scripts/token-envelope-probe.mjs",
        "test": "npm run test:lint && npm run test:unit",
        "release:check": "node scripts/runtime-neutral-worker-smoke.mjs",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test && npm run build && npm run release:check",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@ai-sdk/amazon-bedrock": "5.0.113",
        "@ai-sdk/anthropic": "4.0.78",
        "@ai-sdk/cerebras": "3.0.67",
        "@ai-sdk/deepinfra": "3.0.67",
        "@ai-sdk/google": "4.0.93",
        "@ai-sdk/groq": "4.0.59",
        "@ai-sdk/mistral": "4.0.62",
        "@ai-sdk/openai": "4.0.91",
        "@ai-sdk/openai-compatible": "3.0.67",
        "@ai-sdk/togetherai": "3.0.68",
        "@ai-sdk/xai": "5.0.20",
        "@openrouter/ai-sdk-provider": "3.1.0",
        "@plurnk/plurnk-aliases": "^2.0.0",
        "@plurnk/plurnk-contracts": "^4.0.0",
        "@plurnk/plurnk-meta": "^2.1.0",
        "@plurnk/plurnk-models": "^3.0.0",
        "ai": "7.0.137",
        "zod": "^4.6.6"
    },
    "devDependencies": {
        "esbuild": "^0.28.2"
    }
}
