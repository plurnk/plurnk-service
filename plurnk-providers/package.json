{
    "name": "@plurnk/plurnk-providers",
    "version": "1.3.12",
    "description": "PLURNK's stable model-provider contract and AI SDK adapter.",
    "keywords": [
        "plurnk",
        "llm",
        "provider",
        "tokenizer"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-providers#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-providers"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./openai": {
            "plurnk-dev": "./src/openai.ts",
            "types": "./dist/openai.d.ts",
            "default": "./dist/openai.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src/**/*",
        "dist/**/*",
        "README.md",
        "SPEC.md",
        ".env.defaults"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test src/**/*.test.ts",
        "test:llama": "node --conditions=plurnk-dev --test test/llama/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@ai-sdk/amazon-bedrock": "^5.0.0",
        "@ai-sdk/anthropic": "^4.0.0",
        "@ai-sdk/deepinfra": "^3.0.0",
        "@ai-sdk/google": "^4.0.0",
        "@ai-sdk/groq": "^4.0.0",
        "@ai-sdk/mistral": "^4.0.0",
        "@ai-sdk/openai": "^4.0.0",
        "@ai-sdk/openai-compatible": "^3.0.14",
        "@ai-sdk/togetherai": "^3.0.0",
        "@ai-sdk/xai": "^4.0.0",
        "@openrouter/ai-sdk-provider": "^3.0.0",
        "@plurnk/gbnf": "1.3.12",
        "@plurnk/plurnk-aliases": "1.3.12",
        "@plurnk/plurnk-contracts": "1.3.12",
        "@plurnk/plurnk-meta": "1.3.12",
        "@plurnk/plurnk-models": "1.3.12",
        "ai": "^7.0.37",
        "zod": "^3.25.76"
    }
}
