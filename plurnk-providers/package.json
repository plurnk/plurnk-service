{
    "name": "@plurnk/plurnk-providers",
    "version": "1.3.4",
    "description": "Framework + contract for plurnk LLM transports: built-in standard OpenAI-compatible providers plus scope-agnostic discovery of first-party and third-party provider packages.",
    "keywords": [
        "plurnk",
        "llm",
        "provider",
        "tokenizer"
    ],
    "homepage": "https://github.com/plurnk/plurnk-providers#readme",
    "bugs": {
        "url": "https://github.com/plurnk/plurnk-providers/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-providers.git"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./openai": {
            "plurnk-dev": "./src/openai.ts",
            "types": "./dist/openai.d.ts",
            "default": "./dist/openai.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src/**/*",
        "dist/**/*",
        "README.md",
        "SPEC.md",
        ".env.defaults"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "probe:caps": "node scripts/probe-capabilities.mjs",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@plurnk/gbnf": "1.3.4",
        "@plurnk/plurnk-aliases": "1.3.4",
        "@plurnk/plurnk-models": "1.3.4",
        "@plurnk/plurnk-providers-ollama": "1.3.4",
        "@plurnk/plurnk-meta": "1.3.4"
    }
}
