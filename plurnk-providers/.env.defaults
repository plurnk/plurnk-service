# REFERENCE - @plurnk/plurnk-providers' shipped .env.defaults: the operative floor for the
# PLURNK_PROVIDERS_* knobs AND the standard providers' endpoints + alias config (ecosystem
# standard, providers#44: every package owns what it reads; the file IS the documentation).
# The daemon assembles every installed member's file into one floor (set-if-unset under the
# operator's env) - do NOT edit this file; put YOUR config in ~/.plurnk/.env or ./.env. A key
# claimed by two packages crashes boot naming both.
#
# EVERY PLURNK_PROVIDERS_* knob is per-alias-scopable: PLURNK_PROVIDERS_<KNOB>_<alias> wins over
# the bare name (suffix case-folds; SPEC §4). Set lines are the floor; commented lines are values
# whose UNSET state is meaningful (derive/auto/off, or a required secret) - uncomment to pin.
#
# Base URLs are SHIPPED DEFAULTS - the canonical vendor endpoint lives HERE (overridable in your
# .env, or per-alias via PLURNK_BASEURL_<alias>), so the happy path needs ZERO endpoint config.
# The ONLY required per-provider input is the API KEY: a secret with no default, set in your own
# .env; an unset key for a provider you actually use fails hard at construction naming the var.

# --- Side-channel reasoning (SPEC §4, #32/#33/#399) ---
# ACTIVATION and BUDGET are separate so a numeric can never silently flip wire flags.
# off | adaptive | on. The provider maps intent to each backend's native mechanism
# (reasoning_effort, enable_thinking, think, ...). Default ADAPTIVE (owner ruling,
# #399): reasoning ACTIVE on a fresh install, each backend's own adaptive depth,
# no shipped magnitude - a reasoning model that ships un-reasoning blind-edits and
# declares done (svc#396 A/B: 25 EXECs -> 0, build broken, confident SEND[200]).
PLURNK_PROVIDERS_REASONING=adaptive
# Positive int, REQUIRED iff REASONING=on - the magnitude for tier/budget mapping. On
# llama.cpp the ENFORCEMENT is the box's --reasoning-budget LAUNCH flag (per-request
# numerics are ignored): env budget and launch flag are the same number, changed together.
# PLURNK_PROVIDERS_REASONING_BUDGET=4096

# --- Decode tuning (measured canonical values; bench/TUNING-EPIC.md F1/F6; #9/#30) ---
# TEMPERATURE is the default for EVERY request (under caller sampling); REPEAT_PENALTY is
# the floor the provider manages wherever a grammar rides (greedy-under-mask loops without it).
PLURNK_PROVIDERS_TEMPERATURE=0.2
PLURNK_PROVIDERS_REPEAT_PENALTY=1.15
# FREQUENCY_PENALTY (#426): the anti-degeneration guard on the CLOUD path. repeat_penalty is a
# llama.cpp/vLLM MULTIPLIER the plain cloud path (grammarStyle "none") can't use; frequency_penalty
# is OpenAI-standard, so every OpenAI-compat backend accepts it (verified live: together, deepinfra,
# fireworks). Without it a cloud alias ran the sampler bare and looped to the token cap. 0 = off.
# NOTE: 0.4 is a STARTING value (acceptance-verified, not yet effectiveness-benched) - raise it if a
# firefast/deepseek re-bench still degenerates.
PLURNK_PROVIDERS_FREQUENCY_PENALTY=0.4
# #567: OPTIONAL llama.cpp loop-breakers - OFF unless set (absent = the box's own default).
# DRY penalizes repeated SEQUENCES (penalty escalates with run length) - the lever for a
# plan-restart loop a short-window repeat_penalty can't see; REPEAT_LAST_N widens that window.
# llamacpp path only, alias-scopable. NOT floored: a value here would be a per-model/benchmark
# guess - the operator/bench sets it for the box (e.g. turboderp) and sweeps from there.
# PLURNK_PROVIDERS_DRY_MULTIPLIER_<alias>=0.8
# PLURNK_PROVIDERS_DRY_BASE_<alias>=1.75
# PLURNK_PROVIDERS_DRY_ALLOWED_LENGTH_<alias>=2
# PLURNK_PROVIDERS_REPEAT_LAST_N_<alias>=512

# --- Transport budgets (§4, #18) ---
# Per-attempt fetch timeout (ms); the caller's abort signal spans retries.
PLURNK_PROVIDERS_FETCH_TIMEOUT=600000
# Transient-failure retries: 0 = surface the first failure; N = retries on 429/5xx/timeout
# with exponential backoff (Retry-After wins). RETRY_DELAY is the backoff base (ms).
PLURNK_PROVIDERS_RETRY_ATTEMPTS=3
PLURNK_PROVIDERS_RETRY_DELAY=2000

# --- Endpoint probe (#34) ---
# GET /v1/models at construction (context window + llama-server fingerprint). One failure
# must never decide capability: ATTEMPTS retries with DELAY(ms) backoff base.
PLURNK_PROVIDERS_PROBE_ATTEMPTS=3
PLURNK_PROVIDERS_PROBE_DELAY=250

# --- Grammar (GBNF, SPEC §13) ---
# The grammar artifact the consumer resolves and passes per call (providers transport it
# verbatim; enforcement is per-backend - see constrainsOutput). Read by the service.
# OFF by default (bare unset = off): core opts IN per alias via PLURNK_PROVIDERS_GBNF_<alias>
# (Engine §353). A GLOBAL rails default is unsafe - providers that ACCEPT a grammar quietly
# disable reasoning as a side effect, invisible to the constrainsOutput gate (it verifies rails
# are ENFORCED, not that reasoning SURVIVED). The reasoning model then blind-edits and looks
# like plurnk's fault on their platform (svc#396). Off degrades gracefully (free output, still
# verified; divergence -> grammar_unenforced telemetry, #24); rails-on-where-unsafe degrades
# silently. Turn ON per alias where rails coexist (local llama-server) or the reasoning
# tradeoff is deliberate.
# PLURNK_PROVIDERS_GBNF=plurnk.gbnf
# Debug toggle (0/empty = off): validate a transported grammar locally, throw on malformed,
# and WITHHOLD it so the model runs unconstrained - the free output is still verified and a
# divergence surfaces as grammar_unenforced telemetry. Dev aid; leave off in production.
# PLURNK_PROVIDERS_GBNF_DEBUG=0

# --- Window (SPEC §11) ---
# Unset = derive: env -> live endpoint probe (n_ctx) -> models.dev catalog -> null (surfaced
# once via PLURNK_CONTEXT_UNKNOWN naming the model). Set to pin the window deliberately -
# per-alias (_<alias>) for a box whose model the catalog doesn't know.
# PLURNK_PROVIDERS_CONTEXT_WINDOW=200000

# --- llama-server detection pin (#34) ---
# Unset = auto-detect from the /v1/models fingerprint. 1 = pin llama-server capabilities
# (grammar transport, slot pinning, /tokenize) WITHOUT trusting the probe; 0 = force plain
# remote even when the fingerprint matches. Usually per-alias: _<alias>.
# PLURNK_PROVIDERS_LLAMA_SERVER=1

# --- Data capture (#36, SPEC §14) - OFF by default; the flag IS the isolation ---
# Enable ONLY on a dataset-scraping alias (append _<alias>); serving turns then request and
# carry nothing. TOP_LOGPROBS: non-negative int = the OpenAI top_logprobs count (surfaced on
# assistant.logprobs; raw model logprob, the sampling-invariant confidence). RAWBODY: truthy -> verbatim wire
# body on response.rawBody (keeps sampling_logprob/token_id/bytes the digest drops).
# PLURNK_PROVIDERS_TOP_LOGPROBS_myscraper=3
# PLURNK_PROVIDERS_RAWBODY_myscraper=1

# --- Alias cascade (SPEC §5) - declare aliases, then pick the active one ---
# First path segment is the provider name; the rest is the provider-native model id (may
# contain "/"). Operator-specific, no default - the examples are commented.
# PLURNK_MODEL_gemma=openai/macher.gguf
# PLURNK_MODEL_opus=anthropic/claude-opus-4-8
# PLURNK_MODEL_sonnet=openrouter/anthropic/claude-sonnet-latest
# PLURNK_MODEL=gemma
#
# PLURNK_BASEURL_<alias> - bind an endpoint to ONE alias (the only way to run N self-hosted
# boxes of one provider: openai=llama.cpp/vLLM, ollama). WINS over the provider's *_BASE_URL;
# a dangling override fails hard.
# PLURNK_MODEL_HAZEL1=openai/qwen2.5-coder
# PLURNK_BASEURL_HAZEL1=http://hazel1:8080/v1
# PLURNK_MODEL_NOOK=ollama/qwen2.5-coder
# PLURNK_BASEURL_NOOK=http://nook:11434

# --- Standard provider endpoints (frozen table) ---
# Base URLs ship at their canonical vendor default - zero endpoint config for the happy path.
# Override in your .env (proxy/self-host/regional twin), or per-alias with PLURNK_BASEURL_<alias>
# (which wins over these). Each provider ALSO needs its API KEY - a required secret with no
# default, set in ~/.plurnk/.env; the key var mirrors the *_BASE_URL prefix (FIREWORKS_API_KEY,
# ...) except where noted. An unset key fails hard at construction naming the var.

# Generic OpenAI-compat - OpenAI proper by default; for a local llama-server/vLLM, override the
# endpoint per-alias (PLURNK_BASEURL_<alias>). OPENAI_API_BASE is a legacy URL alias.
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MISTRAL_BASE_URL=https://api.mistral.ai/v1
TOGETHER_BASE_URL=https://api.together.xyz/v1
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai   # key aliases: DEEPINFRA_API_TOKEN, DEEPINFRA_TOKEN

# Chinese cloud hosts - base ships INTERNATIONAL; mainland operators repoint *_BASE_URL at the `.cn` twin.
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # Alibaba Qwen
ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4   # Zhipu GLM; key ZHIPUAI_API_KEY (alias ZAI_API_KEY)
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3   # ByteDance Doubao (BytePlus ModelArk)
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1   # Tencent Hunyuan
MINIMAX_BASE_URL=https://api.minimax.io/v1
STEPFUN_BASE_URL=https://api.stepfun.com/v1   # StepFun; key STEP_API_KEY
BAICHUAN_BASE_URL=https://api.baichuan-ai.com/v1
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2   # Baidu ERNIE (Qianfan v2)
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1   # key alias: MODELSCOPE_TOKEN

# First-party Claude (Anthropic's OpenAI-compat endpoint).
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# AWS Bedrock (OpenAI-compat path /openai/v1) - base is REGION-templated: leave unset to derive
# from AWS_REGION / AWS_DEFAULT_REGION, or pin explicitly. No static default. Key AWS_BEARER_TOKEN_BEDROCK.
# BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1

# plurnk hosted model - PLURNK_API_KEY is an OPTIONAL bearer (sent only when set).
PLURNK_BASE_URL=https://plurnk.ai/v1
# PLURNK_BASE_URL=http://plurnksnr2kihuukt6v22ko72r34dxeatbsfhgow3hvnlw6btanxphad.onion/v1   # Tor

# --- Generation envelope (#507, owner-ruled) - sane defaults from the DETECTED window ---
# When a backend advertises its context window (llama-server n_ctx, the plurnk.ai router,
# a cataloged cloud model), the reserves derive from it automatically - ZERO operator
# tuning. Each accepts a percentage of the window ("10%") or an absolute token count
# ("4096"; absolutes win outright, alias-scopable for measured envelopes). The prompt
# budget is window - reasoning - completion - the consumer's own safety margin.
PLURNK_PROVIDERS_REASONING_RESERVE=10%
PLURNK_PROVIDERS_COMPLETION_RESERVE=25%
