# ⚠ REFERENCE — @plurnk/plurnk-providers' shipped .env.defaults: the operative floor for the
# PLURNK_PROVIDERS_* knobs (ecosystem standard, providers#44: every package owns its knobs; the
# file IS the documentation). The daemon assembles every installed member's file into one floor
# (set-if-unset under the operator's env) — do NOT edit this file; put YOUR config in
# ~/.plurnk/.env or ./.env. A key claimed by two packages crashes boot naming both.
#
# EVERY knob here is per-alias-scopable: PLURNK_PROVIDERS_<KNOB>_<alias> wins over the bare name
# for that alias (suffix case-folds; SPEC §4). Set lines are the floor; commented keys are
# knobs whose UNSET state is meaningful (derive/auto/off) — uncomment to pin.
# Vendor facts (API keys, base URLs: XAI_API_KEY, FIREWORKS_BASE_URL, …) are NOT knobs and
# carry no defaults — they stay operator-declared, fail-hard when required (SPEC §3).

# --- Side-channel reasoning (SPEC §4, #32/#33/#399) ---
# ACTIVATION and BUDGET are separate so a numeric can never silently flip wire flags.
# off | adaptive | on. The provider maps intent to each backend's native mechanism
# (reasoning_effort, enable_thinking, think, …). Default ADAPTIVE (owner ruling,
# #399): reasoning ACTIVE on a fresh install, each backend's own adaptive depth,
# no shipped magnitude — a reasoning model that ships un-reasoning blind-edits and
# declares done (svc#396 A/B: 25 EXECs → 0, build broken, confident SEND[200]).
PLURNK_PROVIDERS_REASONING=adaptive
# Positive int, REQUIRED iff REASONING=on — the magnitude for tier/budget mapping. On
# llama.cpp the ENFORCEMENT is the box's --reasoning-budget LAUNCH flag (per-request
# numerics are ignored): env budget and launch flag are the same number, changed together.
# PLURNK_PROVIDERS_REASONING_BUDGET=4096

# --- Decode tuning (measured canonical values; bench/TUNING-EPIC.md F1/F6; #9/#30) ---
# TEMPERATURE is the default for EVERY request (under caller sampling); REPEAT_PENALTY is
# the floor the provider manages wherever a grammar rides (greedy-under-mask loops without it).
PLURNK_PROVIDERS_TEMPERATURE=0.2
PLURNK_PROVIDERS_REPEAT_PENALTY=1.15

# --- Transport budgets (§4, #18) ---
# Per-attempt fetch timeout (ms); the caller's abort signal spans retries.
PLURNK_PROVIDERS_FETCH_TIMEOUT=600000
# Transient-failure retries: 0 = surface the first failure; N = retries on 429/5xx/timeout
# with exponential backoff (Retry-After wins). RETRY_DELAY is the backoff base (ms).
PLURNK_PROVIDERS_RETRY_ATTEMPTS=3
PLURNK_PROVIDERS_RETRY_DELAY=2000

# --- Endpoint probe (#34) ---
# GET /v1/models at construction (context window + llama-server fingerprint). One failure
# must never decide capability: ATTEMPTS retries with DELAY(ms) backoff base.
PLURNK_PROVIDERS_PROBE_ATTEMPTS=3
PLURNK_PROVIDERS_PROBE_DELAY=250

# --- Grammar (GBNF, SPEC §13) ---
# The grammar artifact the consumer resolves and passes per call (providers transport it
# verbatim; enforcement is per-backend — see constrainsOutput). Read by the service.
# Ships ON deliberately: the default bundle serves locally (llama.cpp/ollama), where rails
# and REASONING=adaptive coexist — reasoning rides reasoning_content, exempt from the content
# mask. Cloud is an opt-in leaf where the two can fight (grammar demotes reasoning); reconcile
# there per-alias (PLURNK_PROVIDERS_REASONING_<alias>=off) over the constrainsOutput boot
# gate — never by dropping the floor the shipped path depends on.
PLURNK_PROVIDERS_GBNF=plurnk.gbnf
# Debug toggle (0/empty = off): validate a transported grammar locally, throw on malformed,
# and WITHHOLD it so the model runs unconstrained — the free output is still verified and a
# divergence surfaces as grammar_unenforced telemetry. Dev aid; leave off in production.
# PLURNK_PROVIDERS_GBNF_DEBUG=0

# --- Window (SPEC §11) ---
# Unset = derive: env → live endpoint probe (n_ctx) → models.dev catalog → null (surfaced
# once via PLURNK_CONTEXT_UNKNOWN naming the model). Set to pin the window deliberately —
# per-alias (_<alias>) for a box whose model the catalog doesn't know.
# PLURNK_PROVIDERS_CONTEXT_SIZE=200000

# --- llama-server detection pin (#34) ---
# Unset = auto-detect from the /v1/models fingerprint. 1 = pin llama-server capabilities
# (grammar transport, slot pinning, /tokenize) WITHOUT trusting the probe; 0 = force plain
# remote even when the fingerprint matches. Usually per-alias: _<alias>.
# PLURNK_PROVIDERS_LLAMA_SERVER=1

# --- Data capture (#36, SPEC §14) — OFF by default; the flag IS the isolation ---
# Enable ONLY on a dataset-scraping alias (append _<alias>); serving turns then request and
# carry nothing. LOGPROB: non-negative int = top_logprobs (surfaced on assistant.logprobs;
# raw model logprob, the sampling-invariant confidence). RAWBODY: truthy → verbatim wire
# body on response.rawBody (keeps sampling_logprob/token_id/bytes the digest drops).
# PLURNK_PROVIDERS_LOGPROB_myscraper=3
# PLURNK_PROVIDERS_RAWBODY_myscraper=1
