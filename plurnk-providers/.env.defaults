# @plurnk/plurnk-providers — models, generation, and transport.
# Per-model knobs accept _<alias> overrides; nonempty overrides win, alias case-insensitively.
# Provider declarations (PROVIDER_<NAME>_*) apply to that provider, not one alias.
# Models.dev supplies known endpoints, credential names, limits, capabilities, and prices.
# Active lines are defaults. Commented lines are optional examples, not loaded values.

# --- Model selection ---
# PLURNK_MODEL accepts an exact provider/model route or a declared alias.
# The model id may contain "/". Aliases provide reusable endpoint/tuning scopes.
# PLURNK_MODEL_cloud=openrouter/qwen/qwen3-coder
# PLURNK_MODEL_local=openai/model-name-from-endpoint
# PLURNK_BASEURL_local=http://127.0.0.1:8080/v1
# PLURNK_MODEL=cloud
# PLURNK_MODEL=google/gemini-3-flash

# --- Capacity ---
# Total output envelope INCLUDING reasoning: positive tokens or context percentage in (0,100).
# Known model limits cap it. Must leave input capacity; the context budget is derived, not set here.
PLURNK_PROVIDERS_OUTPUT_BUDGET=35%
# Optional reasoning subset of output, using the same units; must be smaller than total output.
# Unset/empty = provider-adaptive budget, not reasoning off.
# PLURNK_PROVIDERS_REASONING_BUDGET=8192
# Total context cap, tokens; unset = live endpoint capacity, then Models.dev, otherwise unknown.
# A cap can reduce known capacity or declare unknown capacity; it cannot enlarge known limits.
# PLURNK_PROVIDERS_CONTEXT_WINDOW=200000

# --- Reasoning ---
# off | adaptive | low | medium | high | xhigh | max. Seed for durable Worker reasoning.
# adaptive uses native dynamic reasoning where supported, otherwise the supported high posture.
PLURNK_PROVIDERS_REASONING=adaptive
# Response interpretation: verbatim = trust structured reasoning fields; think-tags = extract one
# leading <think> envelope. Select only for an endpoint that emits it; independent of activation.
PLURNK_PROVIDERS_REASONING_RESPONSE_STYLE=verbatim

# --- Sampling ---
# Temperature; empty = omit, retaining the provider's sampling default.
PLURNK_PROVIDERS_TEMPERATURE=
# Repetition penalty; empty = omit. Values above 1 can penalize required verbatim repetition.
PLURNK_PROVIDERS_REPEAT_PENALTY=
# Frequency penalty; 0 = off. Support and effect depend on the endpoint.
PLURNK_PROVIDERS_FREQUENCY_PENALTY=0
# Repeat-penalty window, tokens; unset = endpoint default.
# PLURNK_PROVIDERS_REPEAT_LAST_N=512
# llama.cpp DRY repeated-sequence penalty; 0 = off. Nonzero can distort required exact copying.
PLURNK_PROVIDERS_DRY_MULTIPLIER=0
# DRY exponential base; unset/empty = endpoint default.
# PLURNK_PROVIDERS_DRY_BASE=
# DRY unpenalized sequence length, tokens; unset/empty = endpoint default.
# PLURNK_PROVIDERS_DRY_ALLOWED_LENGTH=

# --- Cache and billing ---
# Stable Worker affinity on supported routes: 1 = on; 0 = off. Unknown routes get no guessed field.
PLURNK_PROVIDERS_CACHE_AFFINITY=1
# Explicit cache writes: stable-system = reusable system boundary on supported Claude routes;
# off = no explicit writes. This is distinct from affinity and can affect billing.
PLURNK_PROVIDERS_CACHE_WRITE_POLICY=stable-system
# Provider service tier; unset = provider default. Usually set per alias: routing can change cost.
# PLURNK_PROVIDERS_SERVICE_TIER_myfireworks=priority
# USD per million tokens, merged over Models.dev rates; omitted categories retain catalog values.
# Supported keys: input, output, reasoning, cacheRead, cacheWrite. This is estimation, not billing truth.
# PLURNK_PROVIDERS_COST=input=0.22,output=0.66,reasoning=0.66,cacheRead=0.007

# --- Connectivity (milliseconds; each deadline accepts 0 = off) ---
# Logical generation deadline, including physical attempts and retry delays.
PLURNK_PROVIDERS_OPERATION_TIMEOUT=2700000
# Deadline per physical generation attempt.
PLURNK_PROVIDERS_FETCH_TIMEOUT=600000
# Wait from stream start to first semantic content; metadata/empty deltas do not count.
PLURNK_PROVIDERS_FIRST_CONTENT_TIMEOUT=180000
# Maximum silence between semantic content chunks after content begins.
PLURNK_PROVIDERS_STREAM_IDLE_TIMEOUT=120000
# Retries for 429, Retry-After, or X-Should-Retry:true; 0 = none. Other failures return immediately
# to Core's separate recovery window. Retry-After takes precedence over backoff.
PLURNK_PROVIDERS_RETRY_ATTEMPTS=3
# Maximum upstream diagnostic characters in public errors; structured facts remain complete.
PLURNK_PROVIDERS_ERROR_DETAIL_LIMIT=512
# Local endpoint /v1/models probe attempts (capacity and llama-server detection).
PLURNK_PROVIDERS_PROBE_ATTEMPTS=3
# Initial probe backoff, ms.
PLURNK_PROVIDERS_PROBE_DELAY=250

# --- Local endpoints and grammar ---
# llama-server: unset = detect; 1 = pin capabilities; 0 = force plain compatible transport.
# PLURNK_PROVIDERS_LLAMA_SERVER=1
# Local GBNF filename; unset = no rail. Choose the template's bundled profile or a path, per alias.
# PLURNK_PROVIDERS_GBNF=plurnk.qwen.gbnf
# Validate configured GBNF but withhold it from inference, recording unconstrained divergence.
# 0/unset = off; nonempty nonzero = on. Diagnostic only.
# PLURNK_PROVIDERS_GBNF_DEBUG=0

# --- Evidence capture ---
# OpenAI top_logprobs: off/unset = none; 0 = chosen token only; N > 0 = alternatives.
# PLURNK_PROVIDERS_TOP_LOGPROBS=3
# Retain raw wire body: unset/empty/0 = off; other values = on. Usually isolate to one capture alias.
# PLURNK_PROVIDERS_RAWBODY=1

# --- Provider declarations ---
# Override known facts or declare an uncataloged provider. NAME is the route's provider segment.
# API_KEY_ENV names a variable, never its secret value.
# PLURNK_PROVIDERS_PROVIDER_ACME_NPM=@ai-sdk/openai-compatible
# PLURNK_PROVIDERS_PROVIDER_ACME_BASE_URL=https://api.acme.example/v1
# PLURNK_PROVIDERS_PROVIDER_ACME_API_KEY_ENV=ACME_API_KEY
# Reasoning wire adaptations that are not expressed by catalog metadata:
# Fireworks requires an explicit off effort; Cloudflare graded models require an effort.
PLURNK_PROVIDERS_PROVIDER_FIREWORKS_AI_REASONING_STYLE=effort_explicit
PLURNK_PROVIDERS_PROVIDER_CLOUDFLARE_WORKERS_AI_REASONING_STYLE=effort_required
# Additional supported Cloudflare effort values, comma-separated; empty = Models.dev only.
PLURNK_PROVIDERS_PROVIDER_CLOUDFLARE_WORKERS_AI_REASONING_EFFORTS=
# Direct DeepSeek thinking activation and effort.
PLURNK_PROVIDERS_PROVIDER_DEEPSEEK_REASONING_STYLE=thinking_effort
# Uncataloged compatible providers: SDK, endpoint, and credential-variable name.
PLURNK_PROVIDERS_PROVIDER_BAICHUAN_NPM=@ai-sdk/openai-compatible
PLURNK_PROVIDERS_PROVIDER_BAICHUAN_BASE_URL=https://api.baichuan-ai.com/v1
PLURNK_PROVIDERS_PROVIDER_BAICHUAN_API_KEY_ENV=BAICHUAN_API_KEY
PLURNK_PROVIDERS_PROVIDER_QIANFAN_NPM=@ai-sdk/openai-compatible
PLURNK_PROVIDERS_PROVIDER_QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
PLURNK_PROVIDERS_PROVIDER_QIANFAN_API_KEY_ENV=QIANFAN_API_KEY

# --- Compatible and first-party endpoints ---
# OpenAI-compatible fallback endpoint; PLURNK_BASEURL_<alias> overrides it for one declared alias.
OPENAI_BASE_URL=https://api.openai.com/v1
# First-party Plurnk endpoint; authentication uses optional PLURNK_API_KEY in the operator environment.
PLURNK_BASE_URL=https://plurnk.ai/v1

# --- OpenRouter application attribution ---
# Public application URL; empty suppresses attribution, including the title.
OPENROUTER_HTTP_REFERER=https://github.com/plurnk/plurnk-service
# Application display name, sent only with a nonempty URL.
OPENROUTER_APP_TITLE=Plurnk
