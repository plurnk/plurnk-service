# REFERENCE - @plurnk/plurnk-providers' shipped .env.defaults: the operative floor for
# PLURNK_PROVIDERS_* knobs and provider declarations ({§operator-config-env-defaults});
# every package owns what it reads, and this file IS the configuration reference.
# The daemon assembles every installed member's file into one floor (set-if-unset under the
# operator's env) - do NOT edit this file; put YOUR config in ~/.plurnk/.env or ./.env. A key
# claimed by two packages crashes boot naming both.
#
# EVERY PLURNK_PROVIDERS_* knob is per-alias-scopable: PLURNK_PROVIDERS_<KNOB>_<alias> wins over
# the bare name (suffix case-folds; SPEC §4). Set lines are the floor; commented lines are values
# whose UNSET state is meaningful (derive/auto/off, or a required secret) - uncomment to pin.
#
# Models.dev supplies cataloged providers' SDK package, endpoint, credential names,
# and model facts. {§model-fact-resolution} defines precedence per fact; there is
# no live price fetch. Secret VALUES never belong here.

# --- Side-channel reasoning (SPEC §4, #32/#33/#399) ---
# ACTIVATION and BUDGET are separate so a numeric can never silently flip wire flags.
# off | adaptive | on. The provider maps intent to each backend's native mechanism
# (reasoning_effort, enable_thinking, think, ...). Default ADAPTIVE (owner ruling,
# #399): reasoning ACTIVE on a fresh install, each backend's own adaptive depth,
# no shipped magnitude - a reasoning model that ships un-reasoning blind-edits and
# declares done.
PLURNK_PROVIDERS_REASONING=adaptive
# Positive int, REQUIRED iff REASONING=on - the magnitude for tier/budget mapping.
# On llama-server it is a request-scoped reasoning allowance and may tighten, but
# cannot exceed, the resolved PLURNK_PROVIDERS_REASONING_RESERVE.
# PLURNK_PROVIDERS_REASONING_BUDGET=4096

# --- Decode tuning (measured canonical values; #9/#30) ---
# TEMPERATURE is the default for EVERY request (under caller sampling); REPEAT_PENALTY is
# the floor the provider manages wherever a grammar rides (greedy-under-mask loops without it).
PLURNK_PROVIDERS_TEMPERATURE=0.2
PLURNK_PROVIDERS_REPEAT_PENALTY=1.15
# FREQUENCY_PENALTY (#426): optional cloud anti-degeneration tuning. API acceptance
# permits the field to ride but does not establish its semantic effect, and provider
# implementations differ. The portable floor is off; enable per alias only from
# provider documentation or a controlled behavioral experiment.
PLURNK_PROVIDERS_FREQUENCY_PENALTY=0
# PLURNK_PROVIDERS_FREQUENCY_PENALTY_myendpoint=0.4
# Fixed provider service tier. Fireworks accepts auto|default|flex|priority;
# normally set per alias so a paid routing choice is explicit.
# PLURNK_PROVIDERS_SERVICE_TIER_myfireworks=priority
# Compatible endpoints verified to accept the OpenAI prompt_cache_key use the
# stable worker id for replica-local prefix affinity. Official native SDKs own
# their cache mechanisms and do not receive this compatible extension.
PLURNK_PROVIDERS_PROMPT_CACHE_KEY=1
# #567: DRY is a llama.cpp-only repeated-sequence penalty. It can reduce
# degenerate loops, but it can also corrupt exact source, identifiers, quoted
# evidence, and other repetition required by PLURNK operations. The portable
# server-wide default is off. A nonzero alias override is an explicit fidelity
# tradeoff; DRY_BASE_<alias> and DRY_ALLOWED_LENGTH_<alias> tune that opt-in.
PLURNK_PROVIDERS_DRY_MULTIPLIER=0
# PLURNK_PROVIDERS_DRY_BASE_<alias>=
# PLURNK_PROVIDERS_DRY_ALLOWED_LENGTH_<alias>=
# REPEAT_LAST_N widens the older repeat_penalty window past the box's default.
# Set it per alias only from measured model behavior.
# PLURNK_PROVIDERS_REPEAT_LAST_N_<alias>=512

# --- Transport budgets (§4, #18) ---
# Total generation-operation timeout (ms), including retries; caller cancellation also spans the operation.
PLURNK_PROVIDERS_FETCH_TIMEOUT=600000
# Maximum silence (ms) between streamed response-body chunks after response
# streaming begins. Disabled at the portable floor: slow local inference may
# pause legitimately. Enable per alias only from measured endpoint behavior.
PLURNK_PROVIDERS_STREAM_IDLE_TIMEOUT=0
# PLURNK_PROVIDERS_STREAM_IDLE_TIMEOUT_firefast=120000
# Transient-failure retries: 0 = surface the first failure; N = retries on 429/5xx/timeout
# with exponential backoff (Retry-After wins). RETRY_DELAY is the backoff base (ms).
PLURNK_PROVIDERS_RETRY_ATTEMPTS=3
# Maximum characters retained from an upstream provider diagnostic in the
# public Problem detail. Structured failure facts are not truncated.
PLURNK_PROVIDERS_ERROR_DETAIL_LIMIT=512

# --- Endpoint probe (#34) ---
# GET /v1/models at construction (context window + llama-server fingerprint). One failure
# must never decide capability: ATTEMPTS retries with DELAY(ms) backoff base.
PLURNK_PROVIDERS_PROBE_ATTEMPTS=3
PLURNK_PROVIDERS_PROBE_DELAY=250

# --- Optional local constrained sampling (GBNF, SPEC §13) ---
# Unset by default. Set per alias only for a local llama-server whose GBNF
# transport is detected or pinned. Cloud and endpoint-managed model settings do
# not use this knob.
# PLURNK_PROVIDERS_GBNF=plurnk.gbnf
# Debug toggle: validate but withhold a configured local GBNF, then report the
# unconstrained output's divergence. Development aid; leave unset in production.
# PLURNK_PROVIDERS_GBNF_DEBUG=0

# --- Window ({§model-fact-resolution}) ---
# Physical provider context only. Unset derives from a live endpoint probe (n_ctx) or
# models.dev, else null (surfaced once via PLURNK_CONTEXT_UNKNOWN). A configured value
# caps detected physics or declares it when unknown. Prompt packing and model-facing
# pressure are consumer policy, not provider configuration.
# PLURNK_PROVIDERS_CONTEXT_WINDOW=200000

# --- Model pricing override (USD per million tokens; {§model-fact-resolution}) ---
# Models.dev owns catalog rates. Set these together for a model absent from the
# snapshot or to deliberately override its rates. Cached input defaults to the
# input rate when omitted. All three knobs are per-alias scopable.
# PLURNK_PROVIDERS_INPUT_USD_PER_MILLION=1
# PLURNK_PROVIDERS_CACHE_READ_USD_PER_MILLION=0.1
# PLURNK_PROVIDERS_OUTPUT_USD_PER_MILLION=5

# --- llama-server detection pin (#34) ---
# Unset = auto-detect from the /v1/models fingerprint. 1 = pin llama-server capabilities
# (grammar transport, slot pinning, /tokenize) WITHOUT trusting the probe; 0 = force plain
# remote even when the fingerprint matches. Usually per-alias: _<alias>.
# PLURNK_PROVIDERS_LLAMA_SERVER=1

# --- Data capture (#36, SPEC §14) - OFF by default; the flag IS the isolation ---
# Enable ONLY on a dataset-scraping alias (append _<alias>); serving turns then request and
# carry nothing. TOP_LOGPROBS: "off" or a non-negative OpenAI top_logprobs count
# (0 captures only the chosen token; surfaced on assistant.logprobs). "off" lets
# an alias override process-wide capture. RAWBODY: truthy -> verbatim wire body
# on response.rawBody (keeps sampling_logprob/token_id/bytes the digest drops).
# PLURNK_PROVIDERS_TOP_LOGPROBS_myscraper=3
# PLURNK_PROVIDERS_RAWBODY_myscraper=1

# --- Provider declarations (SPEC §5) ---
# Models.dev supplies the AI SDK package, credential names, endpoint, and model
# metadata for cataloged providers. These knobs override those facts or declare
# an endpoint Models.dev does not list. NAME is the alias provider segment.
# PLURNK_PROVIDERS_PROVIDER_<NAME>_NPM=<supported AI SDK package>
# PLURNK_PROVIDERS_PROVIDER_<NAME>_BASE_URL=<endpoint>
# PLURNK_PROVIDERS_PROVIDER_<NAME>_API_KEY_ENV=<comma-separated env names>
PLURNK_PROVIDERS_PROVIDER_CLOUDFLARE_API_KEY_ENV=CLOUDFLARE_API_TOKEN,CLOUDFLARE_API_KEY
# Fireworks reasoners default on when reasoning_effort is omitted; explicit
# "none" is its off switch. This is a declared wire exception, not a registry.
PLURNK_PROVIDERS_PROVIDER_FIREWORKS_REASONING_STYLE=effort_explicit
# Direct DeepSeek reasoning follows {§deepseek-reasoning-request}.
PLURNK_PROVIDERS_PROVIDER_DEEPSEEK_REASONING_STYLE=thinking_effort
PLURNK_PROVIDERS_PROVIDER_VOLCENGINE_NPM=@ai-sdk/openai-compatible
PLURNK_PROVIDERS_PROVIDER_VOLCENGINE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
PLURNK_PROVIDERS_PROVIDER_VOLCENGINE_API_KEY_ENV=ARK_API_KEY
PLURNK_PROVIDERS_PROVIDER_BAICHUAN_NPM=@ai-sdk/openai-compatible
PLURNK_PROVIDERS_PROVIDER_BAICHUAN_BASE_URL=https://api.baichuan-ai.com/v1
PLURNK_PROVIDERS_PROVIDER_BAICHUAN_API_KEY_ENV=BAICHUAN_API_KEY
PLURNK_PROVIDERS_PROVIDER_QIANFAN_NPM=@ai-sdk/openai-compatible
PLURNK_PROVIDERS_PROVIDER_QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
PLURNK_PROVIDERS_PROVIDER_QIANFAN_API_KEY_ENV=QIANFAN_API_KEY

# --- Alias cascade (SPEC §5) - declare aliases, then pick the active one ---
# First path segment is the provider name; the rest is the provider-native model id (may
# contain "/"). Operator-specific, no default - the examples are commented.
# PLURNK_MODEL_gemma=openai/macher.gguf
# PLURNK_MODEL_opus=anthropic/claude-opus-4-8
# PLURNK_MODEL_sonnet=openrouter/anthropic/claude-sonnet-latest
# PLURNK_MODEL=gemma
#
# PLURNK_BASEURL_<alias> - bind an endpoint to ONE alias (the only way to run N self-hosted
# boxes of one provider: openai=llama.cpp/vLLM, ollama). WINS over the provider's *_BASE_URL;
# a dangling override fails hard.
# PLURNK_MODEL_HAZEL1=openai/qwen2.5-coder
# PLURNK_BASEURL_HAZEL1=http://hazel1:8080/v1
# PLURNK_MODEL_NOOK=ollama/qwen2.5-coder
# PLURNK_BASEURL_NOOK=http://nook:11434

# The compatible `openai` and first-party `plurnk` adapters are intentionally
# local contracts rather than catalog declarations. OpenAI defaults to its
# canonical endpoint; override it per alias for llama-server or vLLM.
OPENAI_BASE_URL=https://api.openai.com/v1
# PLURNK_API_KEY is an optional bearer; the endpoint is eventually keyless.
PLURNK_BASE_URL=https://plurnk.ai/v1
# PLURNK_BASE_URL=http://plurnksnr2kihuukt6v22ko72r34dxeatbsfhgow3hvnlw6btanxphad.onion/v1   # Tor

# --- Generation envelope (#507, owner-ruled) - sane defaults from the DETECTED window ---
# When a backend advertises its context window (llama-server n_ctx, the plurnk.ai router,
# a cataloged cloud model), the reserves derive from it automatically - ZERO operator
# tuning. Each accepts a percentage of the window ("10%") or an absolute token count
# ("4096"; absolutes win outright, alias-scopable for measured envelopes). The prompt
# budget is window - reasoning - completion - the consumer's own safety margin.
# On llama-server, the resolved reasoning reserve is also the adaptive per-response
# reasoning ceiling. It is one cumulative allowance across every reasoning block.
PLURNK_PROVIDERS_REASONING_RESERVE=10%
PLURNK_PROVIDERS_COMPLETION_RESERVE=25%
