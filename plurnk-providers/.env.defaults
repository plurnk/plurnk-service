# @plurnk/plurnk-providers — models, generation, and transport.
# Per-model knobs accept _<alias> overrides; nonempty overrides win, alias case-insensitively.
# Provider declarations (PROVIDER_<NAME>_*) apply to that provider, not one alias.
# Models.dev supplies known endpoints, credential names, limits, capabilities, and prices.
# Active lines are defaults. Commented lines are optional examples, not loaded values.

# --- Model selection ---
# PLURNK_MODEL accepts an exact provider/model route or a declared alias.
# The model id may contain "/". Aliases provide reusable endpoint/tuning scopes.
# PLURNK_MODEL_cloud=openrouter/qwen/qwen3-coder
# PLURNK_MODEL_local=openai/model-name-from-endpoint
# PLURNK_BASEURL_local=http://127.0.0.1:8080/v1
# PLURNK_MODEL=cloud
# PLURNK_MODEL=google/gemini-3-flash

# --- Capacity ---
# Simultaneous inference attempts per resolved endpoint in this process; -1 = unrestricted.
# Positive limits queue excess calls. Aliases sharing an endpoint must agree on its limit.
PLURNK_PROVIDERS_MAX_CONCURRENCY=-1
# PLURNK_PROVIDERS_MAX_CONCURRENCY_local=1
# Reserved output INCLUDING reasoning: positive tokens or context percentage in (0,100).
# Known model limits cap it; input capacity is derived. Exact-counting calls may grant unused context.
PLURNK_PROVIDERS_OUTPUT_BUDGET=35%
# Optional reasoning subset of output, using the same units; must be smaller than total output.
# Unset/empty = provider-adaptive budget, not reasoning off.
# PLURNK_PROVIDERS_REASONING_BUDGET=8192
# Total context cap, tokens; unset = live endpoint capacity, then Models.dev, otherwise unknown.
# A cap can reduce known capacity or declare unknown capacity; it cannot enlarge known limits.
# PLURNK_PROVIDERS_CONTEXT_WINDOW=200000

# --- Reasoning ---
# off | adaptive | low | medium | high | xhigh | max. Seed for durable Worker reasoning.
# adaptive prefers native dynamic reasoning, then the supported fallback below.
PLURNK_PROVIDERS_REASONING=adaptive
# Fixed effort when native adaptation is unavailable; empty/unsupported = enabled provider default.
PLURNK_PROVIDERS_REASONING_FALLBACK=high
# Response interpretation: verbatim = trust structured reasoning fields; think-tags = extract one
# leading <think> envelope. Select only for an endpoint that emits it; independent of activation.
PLURNK_PROVIDERS_REASONING_RESPONSE_STYLE=verbatim
# Compatible wire declarations below supplement Models.dev; native SDKs own their protocols.
# Route knobs use the same suffix, e.g. PLURNK_PROVIDERS_REASONING_BUDGET_PATH_<alias>.
# PLURNK_PROVIDERS_REASONING_EFFORTS_<alias>=low,medium,high
# PLURNK_PROVIDERS_REASONING_TRANSPORT_EFFORTS_<alias>=none,low,medium,high
# PLURNK_PROVIDERS_OPTIONS_NAMESPACE_<alias>=openrouter
# PLURNK_PROVIDERS_REASONING_ADAPTIVE_BODY_<alias>='{}'
# PLURNK_PROVIDERS_REASONING_TOGGLE_BODY_<alias>='{"reasoning":{"enabled":true}}'

# --- Sampling ---
# Temperature; empty = omit, retaining the provider's sampling default.
PLURNK_PROVIDERS_TEMPERATURE=
# Nucleus probability mass, 0..1; empty = omit.
PLURNK_PROVIDERS_TOP_P=
# Token shortlist, non-negative integer; empty = omit. Support and zero semantics vary by endpoint.
PLURNK_PROVIDERS_TOP_K=
# Presence penalty, -2..2; empty = omit.
PLURNK_PROVIDERS_PRESENCE_PENALTY=
# Sampling seed, safe integer; empty = omit. Reproducibility depends on the endpoint.
PLURNK_PROVIDERS_SEED=
# Repetition penalty; empty = omit. Values above 1 can penalize required verbatim repetition.
PLURNK_PROVIDERS_REPEAT_PENALTY=
# Frequency penalty, -2..2; 0 = no configured override. Support depends on the endpoint.
PLURNK_PROVIDERS_FREQUENCY_PENALTY=0
# Repeat-penalty window, tokens; unset = endpoint default.
# PLURNK_PROVIDERS_REPEAT_LAST_N=512
# llama.cpp DRY repeated-sequence penalty; 0 = off. Nonzero can distort required exact copying.
PLURNK_PROVIDERS_DRY_MULTIPLIER=0
# DRY exponential base; unset/empty = endpoint default.
# PLURNK_PROVIDERS_DRY_BASE=
# DRY unpenalized sequence length, tokens; unset/empty = endpoint default.
# PLURNK_PROVIDERS_DRY_ALLOWED_LENGTH=

# --- Cache and billing ---
# Stable Worker affinity on supported routes: 1 = on; 0 = off. Unknown routes get no guessed field.
PLURNK_PROVIDERS_CACHE_AFFINITY=1
# FIELD declares placement, independent of the enable switch; null clears it for an alias.
# target is header or body with name, or provider-option with provider and name.
# PLURNK_PROVIDERS_CACHE_AFFINITY_FIELD_<alias>='{"target":"header","name":"x-session-id"}'
PLURNK_PROVIDERS_PROVIDER_OPENAI_CACHE_AFFINITY_FIELD='{"target":"provider-option","provider":"openai","name":"promptCacheKey"}'
PLURNK_PROVIDERS_PROVIDER_DEEPINFRA_CACHE_AFFINITY_FIELD='{"target":"provider-option","provider":"deepinfra","name":"prompt_cache_key"}'
PLURNK_PROVIDERS_PROVIDER_OPENROUTER_CACHE_AFFINITY_FIELD='{"target":"header","name":"x-session-id"}'
PLURNK_PROVIDERS_PROVIDER_CLOUDFLARE_WORKERS_AI_CACHE_AFFINITY_FIELD='{"target":"header","name":"x-session-affinity"}'
PLURNK_PROVIDERS_PROVIDER_FIREWORKS_AI_CACHE_AFFINITY_FIELD='{"target":"header","name":"x-session-affinity"}'
# Explicit cache writes: stable-system = reusable system boundary on supported Claude routes;
# off = no explicit writes. This is distinct from affinity and can affect billing.
PLURNK_PROVIDERS_CACHE_WRITE_POLICY=stable-system
# Provider service tier; unset = provider default. Usually set per alias: routing can change cost.
# PLURNK_PROVIDERS_SERVICE_TIER=
# PLURNK_PROVIDERS_SERVICE_TIER_myfireworks=priority
# USD per million tokens, merged over Models.dev rates; omitted categories retain catalog values.
# Supported keys: input, output, reasoning, cacheRead, cacheWrite. This is estimation, not billing truth.
# PLURNK_PROVIDERS_COST=input=0.22,output=0.66,reasoning=0.66,cacheRead=0.007

# --- Connectivity (milliseconds; each deadline accepts 0 = off) ---
# Logical generation deadline, including admission queues, physical attempts and retry delays.
PLURNK_PROVIDERS_OPERATION_TIMEOUT=2700000
# Deadline per physical generation attempt; a streamed attempt is bounded only until content flows.
PLURNK_PROVIDERS_FETCH_TIMEOUT=600000
# Wait from stream start to first semantic content; metadata/empty deltas do not count.
PLURNK_PROVIDERS_FIRST_CONTENT_TIMEOUT=180000
# Maximum silence between semantic content chunks after content begins.
PLURNK_PROVIDERS_STREAM_IDLE_TIMEOUT=120000
# A line of 16+ characters streamed this many times stops the response as a repetition; 0 = off.
PLURNK_PROVIDERS_REPEATED_LINE_LIMIT=32
# Retries for 429, Retry-After, or X-Should-Retry:true; 0 = none. Other failures return immediately
# to Core's separate recovery window. Retry-After takes precedence over backoff.
PLURNK_PROVIDERS_RETRY_ATTEMPTS=3
# Maximum upstream diagnostic characters in public errors; structured facts remain complete.
PLURNK_PROVIDERS_ERROR_DETAIL_LIMIT=512
# Local endpoint /v1/models probe attempts (capacity and llama-server detection).
PLURNK_PROVIDERS_PROBE_ATTEMPTS=3
# Initial probe backoff, ms.
PLURNK_PROVIDERS_PROBE_DELAY=250

# --- Local endpoints and grammar ---
# llama-server: unset = detect; 1 = pin capabilities; 0 = force plain compatible transport.
# PLURNK_PROVIDERS_LLAMA_SERVER=1
# Path of an operator-written GBNF grammar carried verbatim to a llama-server route; unset/0 = none.
# The service ships no grammar profile; a bare name is an error. Per alias: PLURNK_PROVIDERS_GBNF_<alias>.
# PLURNK_PROVIDERS_GBNF=~/.config/plurnk/my-rail.gbnf

# --- Evidence capture ---
# OpenAI top_logprobs: off/unset = none; 0 = chosen token only; N > 0 = alternatives.
# PLURNK_PROVIDERS_TOP_LOGPROBS=3
# Retain raw wire body: unset/empty/0 = off; other values = on. Usually isolate to one capture alias.
# PLURNK_PROVIDERS_RAWBODY=1

# --- Provider declarations ---
# Override known facts or declare an uncataloged provider. NAME is the route's provider segment.
# API_KEY_ENV names a variable, never its secret value.
# PLURNK_PROVIDERS_PROVIDER_ACME_NPM=@ai-sdk/openai-compatible
# PLURNK_PROVIDERS_PROVIDER_ACME_BASE_URL=https://api.acme.example/v1
# PLURNK_PROVIDERS_PROVIDER_ACME_API_KEY_ENV=ACME_API_KEY
# Compatible request fields use RFC 6901 pointers; output defaults to the SDK's max_tokens.
# Effort vocabulary and budget bounds come from Models.dev; EFFORTS adds declared values.
# ON_BODY applies whenever reasoning is active. OFF_BODY disables it. ADAPTIVE_BODY replaces
# the graded fallback; {} leaves the enabled endpoint at its native default.
# TOGGLE_BODY enables a catalog toggle when no adaptive body or supported fallback applies.
# Bodies contain only reasoning controls, not model/messages, sampling, or token ceilings.
# With both paths declared, CONTROLS must say exclusive or combined. Fixed effort plus a numeric
# budget on an exclusive route fails before inference; adaptive + budget selects the numeric dial.
# PLURNK_PROVIDERS_PROVIDER_ACME_OUTPUT_PATH=/max_completion_tokens
# PLURNK_PROVIDERS_PROVIDER_ACME_REASONING_EFFORT_PATH=/reasoning/effort
# PLURNK_PROVIDERS_PROVIDER_ACME_REASONING_BUDGET_PATH=/reasoning/max_tokens
# PLURNK_PROVIDERS_PROVIDER_ACME_REASONING_CONTROLS=exclusive
# PLURNK_PROVIDERS_PROVIDER_ACME_REASONING_EFFORTS=low,medium,high
# PLURNK_PROVIDERS_PROVIDER_ACME_REASONING_ON_BODY='{"reasoning":{"enabled":true}}'
# PLURNK_PROVIDERS_PROVIDER_ACME_REASONING_OFF_BODY='{"reasoning":{"enabled":false}}'
# PLURNK_PROVIDERS_PROVIDER_ACME_REASONING_ADAPTIVE_BODY='{}'
PLURNK_PROVIDERS_PROVIDER_FIREWORKS_AI_REASONING_EFFORT_PATH=/reasoning_effort
PLURNK_PROVIDERS_PROVIDER_FIREWORKS_AI_REASONING_OFF_BODY='{"reasoning_effort":"none"}'
PLURNK_PROVIDERS_PROVIDER_FIREWORKS_AI_REASONING_TOGGLE_BODY='{"reasoning_effort":true}'
PLURNK_PROVIDERS_PROVIDER_CLOUDFLARE_WORKERS_AI_REASONING_EFFORT_PATH=/reasoning_effort
# Additional supported Cloudflare effort values, comma-separated; empty = Models.dev only.
PLURNK_PROVIDERS_PROVIDER_CLOUDFLARE_WORKERS_AI_REASONING_EFFORTS=
# Direct DeepSeek thinking activation and effort.
PLURNK_PROVIDERS_PROVIDER_DEEPSEEK_REASONING_EFFORT_PATH=/reasoning_effort
PLURNK_PROVIDERS_PROVIDER_DEEPSEEK_REASONING_ON_BODY='{"thinking":{"type":"enabled"}}'
PLURNK_PROVIDERS_PROVIDER_DEEPSEEK_REASONING_OFF_BODY='{"thinking":{"type":"disabled"}}'
# OpenRouter's native SDK accepts these same fields in per-call provider options.
PLURNK_PROVIDERS_PROVIDER_OPENROUTER_OPTIONS_NAMESPACE=openrouter
PLURNK_PROVIDERS_PROVIDER_OPENROUTER_REASONING_EFFORT_PATH=/reasoning/effort
PLURNK_PROVIDERS_PROVIDER_OPENROUTER_REASONING_BUDGET_PATH=/reasoning/max_tokens
PLURNK_PROVIDERS_PROVIDER_OPENROUTER_REASONING_CONTROLS=exclusive
PLURNK_PROVIDERS_PROVIDER_OPENROUTER_REASONING_TRANSPORT_EFFORTS=none,minimal,low,medium,high,xhigh,max
PLURNK_PROVIDERS_PROVIDER_OPENROUTER_REASONING_ON_BODY='{"reasoning":{"enabled":true}}'
PLURNK_PROVIDERS_PROVIDER_OPENROUTER_REASONING_OFF_BODY='{"reasoning":{"effort":"none"}}'
# Qwen 3.7+ Max on Alibaba: max_tokens is answer-only, max_completion_tokens is inclusive.
# Configure the selected alias, not every model on Alibaba (older models differ).
# PLURNK_PROVIDERS_OUTPUT_PATH_qmax=/max_completion_tokens
# PLURNK_PROVIDERS_REASONING_EFFORT_PATH_qmax=/reasoning_effort
# PLURNK_PROVIDERS_REASONING_BUDGET_PATH_qmax=/thinking_budget
# PLURNK_PROVIDERS_REASONING_CONTROLS_qmax=exclusive
# PLURNK_PROVIDERS_REASONING_ON_BODY_qmax='{"enable_thinking":true}'
# PLURNK_PROVIDERS_REASONING_OFF_BODY_qmax='{"enable_thinking":false}'
# Uncataloged compatible providers: SDK, endpoint, and credential-variable name.
PLURNK_PROVIDERS_PROVIDER_BAICHUAN_NPM=@ai-sdk/openai-compatible
PLURNK_PROVIDERS_PROVIDER_BAICHUAN_BASE_URL=https://api.baichuan-ai.com/v1
PLURNK_PROVIDERS_PROVIDER_BAICHUAN_API_KEY_ENV=BAICHUAN_API_KEY
PLURNK_PROVIDERS_PROVIDER_QIANFAN_NPM=@ai-sdk/openai-compatible
PLURNK_PROVIDERS_PROVIDER_QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
PLURNK_PROVIDERS_PROVIDER_QIANFAN_API_KEY_ENV=QIANFAN_API_KEY

# --- Compatible endpoints ---
# OpenAI-compatible fallback endpoint; PLURNK_BASEURL_<alias> overrides it for one declared alias.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- OpenRouter application attribution ---
# Public application URL; empty suppresses attribution, including the title.
OPENROUTER_HTTP_REFERER=https://github.com/plurnk/plurnk-service
# Application display name, sent only with a nonempty URL.
OPENROUTER_APP_TITLE=Plurnk
