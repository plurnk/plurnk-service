{
    "name": "@plurnk/plurnk-mimetypes-application-pdf",
    "version": "1.3.8",
    "description": "application/pdf mimetype handler for plurnk-service. Binary content; hybrid preview surfaces bookmark outline/Title when present and falls back to extracted page text otherwise; query supports regex/glob via extracted text and jsonpath against the outline.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "plurnk": {
        "kind": "mimetype",
        "binary": true,
        "handlers": [
            {
                "name": "application/pdf",
                "glyph": "📕",
                "extensions": [
                    ".pdf"
                ]
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md",
        ".env.defaults"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test",
        "prepack": "npm run build"
    },
    "dependencies": {
        "pdfjs-dist": "^6.0.227"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^1.3.8"
    }
}
