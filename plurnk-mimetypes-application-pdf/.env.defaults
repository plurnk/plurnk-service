# @plurnk/plurnk-mimetypes-application-pdf — PDF extraction.
# Positive integers or empty/unset = unbounded. The shared binary-input ceiling still applies.

# Maximum PDF source bytes admitted before parsing.
PLURNK_MIMETYPES_PDF_MAX_BYTES=
# Maximum pages extracted; remaining pages are not parsed.
PLURNK_MIMETYPES_PDF_MAX_PAGES=
