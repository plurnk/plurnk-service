# @plurnk/plurnk-agui — client protocol. Listener address: the shared PLURNK_HOST/PLURNK_PORT
# (@plurnk/plurnk-contracts).

# Bearer required on non-preflight requests; empty = no module-level authentication. Empty is the
# package floor, not the shipped posture: a fresh install mints its own token into the operator's
# `.env` above this ({§agui-http-authorization}), and every client reads it from there. Emptying
# that line is how an operator turns the perimeter off.
PLURNK_AGUI_TOKEN=
# The origin whose pages a browser lets read replies (CORS): * = any page; one origin = that page
# only; empty = no CORS headers, so no page reads a reply. The bearer, not this, is the perimeter.
PLURNK_AGUI_ALLOW_ORIGIN=*
# Default run turn cap: empty = no module default; -1 = unlimited; otherwise nonnegative integer.
# Core's operator ceiling still applies.
PLURNK_AGUI_MAX_TURNS=
# SSE comment heartbeat, ms (0..2147483647); 0 = off. Independent of model output.
PLURNK_AGUI_HEARTBEAT_MS=15000
