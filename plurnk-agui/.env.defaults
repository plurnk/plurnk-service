# @plurnk/plurnk-agui — client protocol. Listener address: the shared PLURNK_HOST/PLURNK_PORT
# (@plurnk/plurnk-contracts). The posture, the operator's secret and the browser sign-in are the
# shared PLURNK_AUTH, PLURNK_SECRET and PLURNK_PASS there ({§agui-oauth}).

# The authorization server's issuer, the public origin clients reach this daemon at
# ({§agui-oauth-endpoints}). Empty = the address each request reached this daemon at, so a daemon on
# every interface (PLURNK_HOST=0.0.0.0) answers each caller where it called; set it when a front the
# daemon cannot see, such as a TLS proxy, serves another origin.
PLURNK_AGUI_ISSUER=
# Credential lifetimes ({§agui-oauth-tokens}), seconds. An access token is presented as the bearer and
# renewed through the refresh token or the secret; a refresh token rotates on every use.
PLURNK_AGUI_ACCESS_TTL_SEC=3600
PLURNK_AGUI_REFRESH_TTL_SEC=2592000
# Failed sign-ins or client secrets tolerated from one address per window before the next is refused
# with 429 and a Retry-After ({§agui-oauth-login}). 0 attempts = no limit.
PLURNK_AGUI_LOGIN_ATTEMPTS=5
PLURNK_AGUI_LOGIN_WINDOW_SEC=60
# Confidential clients beyond the operator's own, one line each ({§agui-oauth-clients}):
# PLURNK_AGUI_CLIENT_<id>={"secret":"<its secret>","scopes":["agui"]}. Each holds its own
# credentials; removing its line and restarting revokes them. "operator" is reserved.
# The other origin whose pages a browser lets read replies (CORS): * = any page; one origin = that
# page only; empty = no CORS headers, so no page of another origin reads a reply (a page this
# daemon serves reads its own). The bearer, not this, is the perimeter.
PLURNK_AGUI_ALLOW_ORIGIN=*
# Default run turn cap: empty = no module default; -1 = unlimited; otherwise nonnegative integer.
# Core's operator ceiling still applies.
PLURNK_AGUI_MAX_TURNS=
# SSE comment heartbeat, ms (0..2147483647); 0 = off. Independent of model output.
PLURNK_AGUI_HEARTBEAT_MS=15000
