# @plurnk/plurnk-agui — client protocol. Listener address: the shared PLURNK_HOST/PLURNK_PORT
# (@plurnk/plurnk-contracts). Authentication is the shared PLURNK_AUTH ({§credential-authority},
# {§auth-oauth}).

# The other origin whose pages a browser lets read replies (CORS): * = any page; one origin = that
# page only; empty = no CORS headers, so no page of another origin reads a reply (a page this
# daemon serves reads its own). The bearer, not this, is the perimeter.
PLURNK_AGUI_ALLOW_ORIGIN=*
# Default run turn cap: empty = no module default; -1 = unlimited; otherwise nonnegative integer.
# Core's operator ceiling still applies.
PLURNK_AGUI_MAX_TURNS=
# SSE comment heartbeat, ms (0..2147483647); 0 = off. Independent of model output.
PLURNK_AGUI_HEARTBEAT_MS=15000
# Conversation history a client receives ({§agui-history-window}): a snapshot holds the bound worker's newest
# loops, whole turns, and links the page before; GET at that link answers one loop at a time. No number fits
# every workload; these are the starting points.
PLURNK_AGUI_HISTORY_LOOPS=2
# The most characters one snapshot, history page or live text delta serializes to. Keep it below what a
# client takes in one event: the official @ag-ui/client refuses an event over 10,000,000.
PLURNK_AGUI_HISTORY_PAGE_CHARS=2000000
# The most characters of a message's excerpt a list carries ({§list-excerpt}): a loop's opening in a worker's loop
# list ({§agui-worker-loops}) and a worker's latest finished reply in the overview ({§agui-overview}).
PLURNK_AGUI_EXCERPT_CHARS=240
# The places one worker overview holds beside every place waiting on a gate ({§agui-overview}); it counts the rest.
PLURNK_AGUI_OVERVIEW_WORKERS=200
