{
    "name": "@plurnk/plurnk-agui",
    "version": "1.3.5",
    "description": "AG-UI HTTP and SSE interface for the PLURNK daemon",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-agui.git"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        ".env.defaults",
        "README.md",
        "SPEC.md"
    ],
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "test": "npm run test:lint && npm run test:unit && npm run test:intg",
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file-if-exists=.env.defaults --test src/*.test.ts",
        "test:intg": "node --conditions=plurnk-dev --env-file-if-exists=.env.defaults --test test/intg/*.test.ts",
        "prepublishOnly": "npm test",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@ag-ui/client": "0.0.57",
        "@types/ws": "8.18.1",
        "ws": "8.21.1"
    },
    "keywords": [
        "plurnk",
        "ag-ui",
        "agui",
        "agent",
        "transport",
        "sse",
        "human-in-the-loop"
    ],
    "homepage": "https://github.com/plurnk/plurnk-agui#readme",
    "bugs": {
        "url": "https://github.com/plurnk/plurnk-agui/issues"
    },
    "author": "@wikitopian",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@ag-ui/core": "^0.0.57",
        "@plurnk/plurnk-execs-mcp": "1.3.5",
        "@plurnk/plurnk-grammar": "1.3.5"
    }
}
