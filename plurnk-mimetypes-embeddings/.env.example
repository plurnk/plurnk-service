# @plurnk/plurnk-mimetypes-embeddings — configuration knobs.
# The host process sets these in its environment; this file is the contract.
# Family-prefix convention: every mimetypes-family knob is PLURNK_MIMETYPES_*.

# PLURNK_MIMETYPES_EMBED_WORKERS — REQUIRED, no default. embedBatch() pool size:
# how many single-threaded workers texts are spread across. Each worker holds
# its own model copy, so this is a memory↔throughput decision only you can make
# — the embedder refuses to guess. A positive integer sets the exact count; -1
# sizes to the host's core count (availableParallelism) — an explicit "match
# cores" directive, still your choice, not a fallback. Dedicated box: -1 or the
# core count. Shared / low-RAM host: a small number. Unset, empty, 0, or
# malformed → crash on load.
# (Renamed from PLURNK_EMBED_WORKERS; the old name crashes with a pointer here.)
# Example: PLURNK_MIMETYPES_EMBED_WORKERS=-1   (or a positive integer, e.g. 8)
PLURNK_MIMETYPES_EMBED_WORKERS=

# --- Remote mode (#46) — optional BYO-GPU embedder ---

# PLURNK_MIMETYPES_EMBED_BASE_URL — OpenAI-convention base of a /v1/embeddings
# endpoint (llama-server, vLLM, hosted); the client appends /embeddings.
# UNSET = the bundled WASM embedder (default, hermetic, no network). When set,
# the dimension is probed at load — an unreachable endpoint crashes the import,
# so misconfiguration surfaces at boot, never mid-query. Identity becomes
# remote:<model>@d<dim>, so an embedder swap re-derives the vector space.
# Example: PLURNK_MIMETYPES_EMBED_BASE_URL=http://127.0.0.1:8080/v1
PLURNK_MIMETYPES_EMBED_BASE_URL=

# PLURNK_MIMETYPES_EMBED_MODEL — REQUIRED when BASE_URL is set (the embedder
# will not guess which model the endpoint serves). Crash if missing.
PLURNK_MIMETYPES_EMBED_MODEL=

# PLURNK_MIMETYPES_EMBED_API_KEY — optional; sent as Authorization: Bearer.
PLURNK_MIMETYPES_EMBED_API_KEY=
