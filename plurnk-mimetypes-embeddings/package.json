{
    "name": "@plurnk/plurnk-mimetypes-embeddings",
    "version": "1.12.0",
    "description": "Portable local/hosted embedder for @plurnk/plurnk-mimetypes' explicitly requested embedding seam. The bundled local MiniLM path uses vendored WASM with no native addon, runtime network, or transitive install scripts.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "exports": {
        ".": {
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "index.js",
        "local.js",
        "profiles.js",
        "configured.js",
        "standard.js",
        "profile-tokenizers.js",
        "profile-tokenizers/**",
        "embed-core.js",
        "embed-worker.js",
        "model/**",
        ".model-pin",
        "vendor/**",
        ".ort-pin",
        "README.md",
        ".env.defaults"
    ],
    "scripts": {
        "build:model": "node --conditions=plurnk-dev scripts/fetch-model.mjs",
        "verify:model": "node --conditions=plurnk-dev scripts/verify-model.mjs",
        "fetch:profile-tokenizers": "node --conditions=plurnk-dev scripts/fetch-profile-tokenizers.mjs",
        "verify:profile-tokenizers": "node --conditions=plurnk-dev scripts/verify-profile-tokenizers.mjs",
        "vendor:ort": "node --conditions=plurnk-dev scripts/vendor-ort.mjs",
        "verify:ort": "node --conditions=plurnk-dev scripts/verify-ort.mjs",
        "pretest:unit": "npm run verify:ort && npm run verify:profile-tokenizers",
        "test:unit": "PLURNK_EMBEDDING_MODEL= PLURNK_EMBEDDING_WORKERS=2 node --experimental-test-module-mocks --conditions=plurnk-dev --test configured.test.js index.test.js lifecycle.test.js profile-tokenizers.test.js profiles.test.js selection.test.js standard.test.js",
        "test:intg": "PLURNK_EMBEDDING_MODEL= PLURNK_EMBEDDING_WORKERS=2 node --conditions=plurnk-dev --test test/integration/*.test.js",
        "test": "npm run test:unit && npm run test:intg",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test"
    },
    "dependencies": {
        "@huggingface/tokenizers": "^0.1.3",
        "@plurnk/plurnk-providers": "1.12.0",
        "ai": "^7.0.37"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^1.12.0"
    },
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-mimetypes-embeddings#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-mimetypes-embeddings"
    }
}
