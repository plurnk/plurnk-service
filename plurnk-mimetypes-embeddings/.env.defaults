# @plurnk/plurnk-mimetypes-embeddings — operator knobs (.env.defaults standard,
# mimetypes#52). This file ships in the tarball and IS the documentation; the
# daemon assembles it into the boot floor set-if-unset. Empty value = unset.

# embedBatch() worker pool size (LOCAL WASM mode). -1 = match the host's cores
# (availableParallelism) — an explicit directive, not a guess. Positive integer
# for an exact count (one model copy per worker: memory↔throughput). Unset,
# empty, or malformed crashes — the embedder never guesses.

# Remote mode (#46): OpenAI-convention /v1 base of an embeddings endpoint
# (llama-server, vLLM, hosted); /embeddings is appended. Empty = bundled local
# WASM embedder (hermetic, no network). Dimension is probed at load; a bad
# endpoint crashes boot, never mid-query.
PLURNK_MIMETYPES_EMBED_BASE_URL=

# REQUIRED when BASE_URL is set — the model the endpoint serves (never guessed).
PLURNK_MIMETYPES_EMBED_MODEL=

# Optional Bearer token for the remote endpoint.
PLURNK_MIMETYPES_EMBED_API_KEY=

# The REMOTE model's input context window, declared by you — the endpoint owner
# knows their model card. Empty = unknown (hosts take the null-window lane).
# Remote-only: a non-empty value in local mode crashes (the bundled model's
# window is a model fact, not config).
PLURNK_MIMETYPES_EMBED_CONTEXT_WINDOW=

# Local batch pool size. Empty uses every available core through four and leaves
# one free on larger hosts. A positive integer is exact; -1 claims every core.
PLURNK_MIMETYPES_EMBED_WORKERS=
