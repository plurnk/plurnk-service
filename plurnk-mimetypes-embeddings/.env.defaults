# @plurnk/plurnk-mimetypes-embeddings operator knobs
# ({§operator-config-env-defaults}). The daemon assembles this reference into
# the set-if-unset floor. Put operator values in $XDG_CONFIG_HOME/plurnk/.env or
# ./.env, never here.

# Unset selects the bundled hermetic MiniLM artifact. Otherwise select an exact
# <provider>/<model> route or an existing PLURNK_MODEL_<alias>. Provider URL and
# credentials come from the ordinary provider catalog/declaration contract.
# Configured profiles may require the separately installed exact-tokenizer
# artifact; see the package README.
# PLURNK_EMBEDDING_MODEL=cloudflare-workers-ai/@cf/qwen/qwen3-embedding-0.6b

# Maximum simultaneous provider embedding requests after the AI SDK partitions a
# corpus according to the adapter's standard batch limit.
PLURNK_EMBEDDING_CONCURRENCY=4

# Bundled-local document pool. Empty uses every available core through four and
# leaves one free on larger hosts. Positive is exact; -1 claims every core. Each
# worker owns one model copy.
PLURNK_EMBEDDING_WORKERS=

# A known model route supplies these exact profile facts. For an unknown custom
# route, declare all four or resolution fails before any request. The unknown
# profile is symmetric: query and document text are passed through unchanged.
PLURNK_EMBEDDING_DIMENSIONS=
PLURNK_EMBEDDING_CONTEXT_WINDOW=
PLURNK_EMBEDDING_TOKENIZER=
PLURNK_EMBEDDING_MAX_INPUTS_PER_REQUEST=
