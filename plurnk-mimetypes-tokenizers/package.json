{
    "name": "@plurnk/plurnk-mimetypes-tokenizers",
    "version": "1.12.0",
    "description": "Bundled LLM tokenizer vocabularies (tokenizer.json set) for @plurnk/plurnk-mimetypes' tokenizer seam — exact token counting for window math.",
    "keywords": [
        "plurnk",
        "tokenizer",
        "llm",
        "token-counting",
        "bpe",
        "sentencepiece"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-mimetypes-tokenizers#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-mimetypes-tokenizers"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": "./index.js",
        "./package.json": "./package.json"
    },
    "files": [
        "index.js",
        "tokenizers/**/*",
        "README.md"
    ],
    "scripts": {
        "fetch:tokenizers": "node --conditions=plurnk-dev scripts/fetch-tokenizers.mjs",
        "verify:tokenizers": "node --conditions=plurnk-dev scripts/verify-tokenizers.mjs",
        "pretest:unit": "npm run verify:tokenizers",
        "test:unit": "node --conditions=plurnk-dev --test index.test.js",
        "test": "npm run test:unit",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^1.12.0"
    },
    "dependencies": {
        "@huggingface/tokenizers": "^0.1.3"
    }
}
