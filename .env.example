# plurnk-service environment cascade.
#
# Override order: `.env.example` < `.env` < `.env.<profile>` < shell < params.
# Feature-flag bools use `=== "1"` exactly. Never `=== "true"`.

# --- Storage ---
PLURNK_DB_PATH=./plurnk.db

# --- Daemon transport ---
PLURNK_HOST=127.0.0.1
PLURNK_PORT=3044

# --- Loop control ---
# Operator turn ceiling. -1 (default) = no cap (loops end via SEND, budget,
# strikes, or cycle detection). A positive value is an inviolable hard cap a
# per-call loop.run({maxTurns}) cannot exceed (min wins).
PLURNK_MAX_TURNS=-1
PLURNK_MAX_COMMANDS=99
PLURNK_RPC_TIMEOUT=30000
PLURNK_LOOP_TIMEOUT=86400000

# --- Engine rails ---
PLURNK_MAX_STRIKES=3
PLURNK_MIN_CYCLES=3
PLURNK_MAX_CYCLE_PERIOD=4

# --- Schemes ---
# (Workspace root for file ops is per-session — supplied by the client
# via session.create({projectRoot}) or session.set_root({projectRoot});
# stored on sessions.project_root. No env-level default.)

# --- Git integration ---
# Service-level hard ceiling for git/gh integration (repo telemetry, EXEC[git],
# auto-add new files). =1 permits it (then a git worktree + per-session config
# decide); =0 flatly disables it service-wide — no client/session can re-enable
# (the sandbox/benchmark kill switch).
PLURNK_GIT_ENABLED=1

# --- Persona ---
# Path to the default persona file (text/markdown). Injected into
# packet.system.persona when no per-session, per-run, or per-loop override
# is supplied via RPC. Relative paths resolve against the package root.
PLURNK_PERSONA=persona.md

# --- Reference docs (auto-READ at turn 0) ---
# PLURNK_MD_<ALIAS>=<path> materializes <path>'s markdown as a plurnk://<ALIAS>.md
# entry the model READs at turn 0 — an idiomatic way to inject standing context
# (an ordinary entry + READ op, not a bespoke packet section). ~ expands to home;
# relative paths resolve against the package root. The same convention works
# client-side. Commented out = no docs by default.
# PLURNK_MD_AGENTS=~/.plurnk/AGENTS.md

# --- Providers (universal knobs) ---
# Reasoning is split into two REQUIRED, fail-hard gates (THINKING, REASONING);
# PLURNK_REASON below is MAGNITUDE only now. No in-code defaults — boot throws
# if a gate is unset (providers 0.1.10+, SPEC §4).
#
# Native think channel. On llama-server this reaches the wire as
# chat_template_kwargs.enable_thinking. =0 closes the model's native <think>
# deterministically; =1 opens it. MUST be 0 whenever GBNF is on (below): native
# thinking and a grammar are mutually exclusive (SPEC §13) — an open channel
# under a grammar empties/leaks content as the grammar auto-gates past it (the
# #204 amputation). With =0, a reasoning model routes chain-of-thought through
# the grammar's <<PLAN:...:PLAN op instead.
PLURNK_PROVIDERS_THINKING=0
# Cloud/relay reasoning requests (reasoning_effort tiers, openrouter
# include_reasoning), magnitude-tiered by PLURNK_REASON when on. =1 keeps cloud
# reasoning on; =0 suppresses it. Inert for local llama-server (gated by THINKING).
PLURNK_PROVIDERS_REASONING=1
# Reasoning MAGNITUDE only now (on/off moved to the two gates above): effort
# tiers for OpenAI o-series, budget_tokens for Anthropic. Provider modules own
# the per-model-family translation to their own wire format.
PLURNK_REASON=0
# Service-wide fetch timeout in ms — the universal upper bound on any
# single outbound request (provider calls, future http:// scheme reads,
# anything that does network IO). Streamed completions can run long;
# default 600000 (10 minutes). Provider/scheme modules MAY have their
# own vendor-specific overrides for narrower defaults, but they honor
# this as the operator's universal ceiling.
PLURNK_FETCH_TIMEOUT=600000
# Grammar-constrained sampling: =1 hands the plurnk GBNF to the provider on
# every generate() so capable backends (llama-server, detected via the
# /v1/models fingerprint) can only sample valid plurnk DSL; backends that
# don't support it drop it silently. =0 disables it service-wide.
PLURNK_PROVIDERS_GBNF=1
# Override the model's reported context window in tokens. Provider modules
# normally read this from the model/API; set this to force a specific
# value (smaller for testing, larger for models that under-report). Unset
# = trust the provider's default.
# PLURNK_PROVIDER_CONTEXT_SIZE=

# --- Diagnostics ---
PLURNK_DEBUG=0
PLURNK_LOG_LEVEL=info
