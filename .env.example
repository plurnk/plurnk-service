# plurnk-service environment cascade.
#
# Override order: `.env` < `.env.<profile>` < shell.
# Read fails on undefined ⇒ fix THIS file (add a sane default), not the read site.
# Feature-flag bools use `=== "1"` exactly. Never `=== "true"`.

# --- Storage ---
# SQLite file path. Use `plurnk_dev.db` in development; `plurnk.db` in production.
PLURNK_DB_PATH=./plurnk_dev.db

# --- Daemon transport ---
# WebSocket bind address. Default 127.0.0.1 keeps the daemon local-only.
PLURNK_HOST=127.0.0.1
# TCP port for the daemon WebSocket.
PLURNK_PORT=3044

# --- Loop control ---
# Default safety cap on turns per loop.run (overridable per RPC call).
PLURNK_MAX_TURNS=50
# Timeout in ms for non-longRunning RPC handlers (loop.run is exempt).
PLURNK_RPC_TIMEOUT=30000

# --- Rendering ---
# Per-channel preview budget for index tiles, in characters (SPEC §14.2).
PLURNK_ENTRY_SIZE_DEFAULT_TOKENS=256

# --- Diagnostics ---
# When `1`, runs JSON Schema validation on every internal hop (vs. boundaries only).
PLURNK_DEBUG=0

# --- Stdout logging ---
# Boot-time banners and crash reports only. Runtime logging is DB rows (log://).
# Levels: trace, debug, info, warn, error.
PLURNK_LOG_LEVEL=info

# --- Note ---
# Provider-side env (OPENAI_*) lives in the consumer package's .env, not here.
# @plurnk/plurnk-service is the engine library + admin CLI. User-facing
# CLI/TUI is @plurnk/plurnk (separate package).
#
# Engine constraints: ONE cap, fixed at SQL level — 100 MiB char-length per
# channel content body (CHECK constraint in migrations/005_entries.sql).
# All other limits (rate, burst, per-call budget) are owned by providers,
# schemes, and mimetypes — not the engine.
