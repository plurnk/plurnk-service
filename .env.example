# plurnk-service environment cascade.
#
# Override order: `.env.example` < `.env` < `.env.<profile>` < shell < params.
# Feature-flag bools use `=== "1"` exactly. Never `=== "true"`.

# --- Storage ---
PLURNK_DB_PATH=./plurnk.db

# --- Daemon transport ---
PLURNK_HOST=127.0.0.1
PLURNK_PORT=3044

# --- Loop control ---
PLURNK_MAX_TURNS=999
PLURNK_MAX_COMMANDS=99
PLURNK_RPC_TIMEOUT=30000
PLURNK_LOOP_TIMEOUT=86400000

# --- Engine rails ---
PLURNK_MAX_STRIKES=3
PLURNK_MIN_CYCLES=3
PLURNK_MAX_CYCLE_PERIOD=4

# --- Schemes ---
# (Workspace root for file ops is per-session — supplied by the client
# via session.create({projectRoot}) or session.set_root({projectRoot});
# stored on sessions.project_root. No env-level default.)

# --- Persona ---
# Path to the default persona file (text/markdown). Injected into
# packet.system.persona when no per-session, per-run, or per-loop override
# is supplied via RPC. Relative paths resolve against the package root.
PLURNK_PERSONA=persona.md

# --- Providers (universal knobs) ---
# Reasoning-token budget for the model. 0 disables reasoning entirely;
# positive integers request that many reasoning tokens (provider modules
# own the per-model-family translation to their own wire format —
# OpenAI o-series reasoning_effort tiers, llama-server think flag, etc).
PLURNK_REASON=0
# Fetch timeout in ms for any single provider request. Streamed completions
# can run long; default 600000 (10 minutes). Provider modules MAY apply a
# lower default if their endpoint is known-fast, but they honor this as the
# upper bound the operator has set.
PLURNK_PROVIDER_FETCH_TIMEOUT=600000

# --- Rendering ---
PLURNK_ENTRY_SIZE_DEFAULT_TOKENS=256

# --- Diagnostics ---
PLURNK_DEBUG=0
PLURNK_LOG_LEVEL=info
