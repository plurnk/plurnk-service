# plurnk-service environment cascade.
#
# Override order: `.env` < `.env.<profile>` < shell.
# Read fails on undefined ⇒ fix THIS file (add a sane default), not the read site.
# Feature-flag bools use `=== "1"` exactly. Never `=== "true"`.

# --- Storage ---
# SQLite file path. Use `plurnk_dev.db` in development; `plurnk.db` in production.
PLURNK_DB_PATH=./plurnk_dev.db

# --- Rendering ---
# Per-channel head/tail token budget for index preview tiles. The scheme declares
# orientation (head/tail) via SchemeRegistration.channel_orientations; this knob
# decides how many tokens to render from that orientation.
PLURNK_ENTRY_SIZE_DEFAULT_TOKENS=256

# --- Backpressure ---
# Max chunks delivered into packet.system.log[] per turn per active subscription.
# Truncation emits a synthesized log row with status_rx=206 (Partial Content).
PLURNK_SUBSCRIPTION_BURST=64

# --- Diagnostics ---
# When `1`, runs JSON Schema validation on every internal hop (vs. boundaries only).
PLURNK_DEBUG=0

# --- Stdout logging ---
# Boot-time banners and crash reports only. Runtime logging is DB rows (log://).
# Levels: trace, debug, info, warn, error.
PLURNK_LOG_LEVEL=info

# --- Note ---
# Provider-side env (OPENAI_*) and loop-control env (PLURNK_MAX_TURNS)
# live in the consumer package's .env, not here. @plurnk/plurnk-service
# is a library + admin CLI; only PLURNK_DB_PATH is read by the bin script.
# User-facing CLI/TUI is @plurnk/plurnk (separate package).
