{
    "name": "@plurnk/plurnk-parser",
    "version": "4.4.0",
    "description": "The PLURNK Code Mode parser: unwrapped TypeScript/JavaScript statement admission, canonical serialization, and path decomposition implementing @plurnk/plurnk-contracts",
    "keywords": [
        "plurnk",
        "codemode",
        "parser",
        "protocol"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-parser#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-parser"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "plurnk-parser": "./bin/plurnk-parser.js"
    },
    "files": [
        "bin/plurnk-parser.js",
        "dist/**/*",
        "README.md",
        "SPEC.md"
    ],
    "scripts": {
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --experimental-test-coverage --test-coverage-include-all '--test-coverage-include=src/**' --test ${PLURNK_TEST_CONCURRENCY:+--test-concurrency=$PLURNK_TEST_CONCURRENCY} src/*.test.ts",
        "test:intg": "node --conditions=plurnk-dev --experimental-test-coverage --test-coverage-include-all '--test-coverage-include=src/**' --test ${PLURNK_TEST_CONCURRENCY:+--test-concurrency=$PLURNK_TEST_CONCURRENCY} test/integration/*.test.ts test/demo/*.test.ts",
        "test:installation": "node --conditions=plurnk-dev scriptify/smoke-test.ts",
        "test": "npm run test:lint && npm run test:unit && npm run test:intg",
        "release:check": "npm run test:installation",
        "prepublishOnly": "npm audit && npm run build && npm test && npm run test:installation",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@plurnk/plurnk-contracts": "^7.3.0",
        "json-p3": "^3.0.2",
        "xpath": "^0.0.36"
    },
    "devDependencies": {
        "@plurnk/plurnk-meta": "^2.2.0",
        "esbuild": "^0.28.1"
    }
}
