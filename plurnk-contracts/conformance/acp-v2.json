        ": heartbeat\r\nid: ignored\r\ndata: {\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"fixture\",\"update\":{\"sessionUpdate\":\"notice\",\r\ndata: \"severity\":\"info\",\"title\":\"engine/fixture\",\"_meta\":{\"plurnk\":{\"notice\":{\"source\":\"engine\",\"kind\":\"fixture\",\"level\":\"info\"}}}}}}\r",
        "\n\r\n"
      ],
      "eof": false,
      "expect": {
        "events": [
          {
            "sessionUpdate": "notice",
            "severity": "info",
            "title": "engine/fixture",
            "_meta": {
              "plurnk": {
                "notice": { "source": "engine", "kind": "fixture", "level": "info" }
              }
            }
          }
        ]
      }
    },
    {
      "name": "split-frame-and-eof-dispatch",
      "chunks": [
        "data: {\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"fixture\",\"update\":{\"sessionUpdate\":\"state_update\",\"state\":\"run",
        "ning\"}}}\n\ndata: {\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"fixture\",\"update\":{\"sessionUpdate\":\"state_update\",\"state\":\"idle\",\"stopReason\":\"end_turn\"}}}"
      ],
      "eof": true,
      "expect": {
        "events": [
          { "sessionUpdate": "state_update", "state": "running" },
          {
            "sessionUpdate": "state_update",
            "state": "idle",
            "stopReason": "end_turn"
          }
        ]
      }
    },
    {
      "name": "malformed-json",
      "chunks": ["data: [{\"jsonrpc\":\"2.0\"}]\n\n"],
      "eof": false,
      "expect": { "error": "invalid-json" }
    },
    {
      "name": "cr-only-lines",
      "chunks": [
