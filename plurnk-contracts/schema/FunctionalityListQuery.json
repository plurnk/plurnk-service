{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/FunctionalityListQuery.json",
    "title": "FunctionalityListQuery",
    "description": "A family-neutral bounded filter and pagination query over workspace or session Functionality definitions.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "query": {
            "description": "Case-insensitive substring filter over alias, provenance, and non-secret definition metadata.",
            "type": "string",
            "maxLength": 256
        },
        "state": {
            "description": "Filter by current preparation or enablement state.",
            "enum": ["disabled", "dormant", "active", "unavailable", "authorization-required"]
        },
        "origin": {
            "description": "Filter by definition ownership.",
            "enum": ["service", "workspace", "session"]
        },
        "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
        }
    }
}
