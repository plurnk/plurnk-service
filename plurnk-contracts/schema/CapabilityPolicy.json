{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/CapabilityPolicy.json",
    "title": "CapabilityPolicy",
    "description": "One capability-policy layer. Deny wins; when only is present, a demand must match at least one selector; allow pre-approves matching admitted proposals.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "allow": {
            "type": "array",
            "items": { "$ref": "https://schemas.plurnk.xyz/v0/CapabilitySelector.json" }
        },
        "only": {
            "type": "array",
            "items": { "$ref": "https://schemas.plurnk.xyz/v0/CapabilitySelector.json" }
        },
        "deny": {
            "type": "array",
            "items": { "$ref": "https://schemas.plurnk.xyz/v0/CapabilitySelector.json" }
        }
    }
}
