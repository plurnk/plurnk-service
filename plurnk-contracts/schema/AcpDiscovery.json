{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/AcpDiscovery.json",
    "title": "AcpDiscovery",
    "description": "The installed ACP management action and display capability surface. Action names are object keys so identity has one representation.",
    "type": "object",
    "required": ["schemaVersion", "actions", "display"],
    "additionalProperties": false,
    "properties": {
        "schemaVersion": {
            "const": 1
        },
        "actions": {
            "type": "object",
            "propertyNames": {
                "type": "string",
                "minLength": 1
            },
            "additionalProperties": {
                "$ref": "#/$defs/action"
            }
        },
        "display": {
            "$ref": "https://schemas.plurnk.xyz/v0/ClientDisplayCapabilities.json"
        }
    },
    "$defs": {
        "jsonSchema": {
            "type": "object",
            "description": "A JSON Schema 2020-12 schema supplied by the contract owner.",
            "additionalProperties": true
        },
        "action": {
            "type": "object",
            "required": ["scope", "inputSchema", "outputSchema"],
            "additionalProperties": false,
            "properties": {
                "scope": {
                    "enum": ["daemon", "workspace", "session"]
                },
                "inputSchema": {
                    "$ref": "#/$defs/jsonSchema"
                },
                "outputSchema": {
                    "$ref": "#/$defs/jsonSchema"
                }
            }
        }
    }
}
