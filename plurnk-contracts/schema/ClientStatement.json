{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/ClientStatement.json",
    "title": "ClientStatement",
    "description": "The client-tier AST returned by PlurnkParser.parseClient: the closed protocol PlurnkStatement union plus the read-shaped LOOK utility statement.",
    "oneOf": [
        {
            "$ref": "https://schemas.plurnk.xyz/v0/PlurnkStatement.json"
        },
        {
            "$ref": "#/$defs/LookStatement"
        }
    ],
    "$defs": {
        "AsideOrNull": {
            "type": [
                "string",
                "null"
            ]
        },
        "SchemeMetadataOrNull": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                {
                    "type": "null"
                }
            ]
        },
        "PathOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/ParsedPath.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "LineMarkerOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/LineMarker.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "TextLineMarkerOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/TextLineMarker.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "MatcherBodyOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/MatcherBody.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "PositionRef": {
            "$ref": "https://schemas.plurnk.xyz/v0/Position.json"
        },
        "LookStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "metadata",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "LOOK"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "metadata": {
                    "$ref": "#/$defs/SchemeMetadataOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/TextLineMarkerOrNull"
                },
                "body": {
                    "$ref": "#/$defs/MatcherBodyOrNull"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        }
    }
}
