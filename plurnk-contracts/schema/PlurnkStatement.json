{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/PlurnkStatement.json",
    "title": "PlurnkStatement",
    "description": "The parsed AST union for one protocol statement, discriminated by `op`. Every variant has fixed signal, target, metadata, lineMarker, aside, body, and source-position fields, and the text and log operations add a matcher lifted from the `pattern` option; operation-specific schemas constrain their types. A null field records an omitted tolerated slot and does not satisfy runtime requirements by itself.",
    "oneOf": [
        {
            "$ref": "#/$defs/FindStatement"
        },
        {
            "$ref": "#/$defs/ReadStatement"
        },
        {
            "$ref": "#/$defs/EditStatement"
        },
        {
            "$ref": "#/$defs/CopyStatement"
        },
        {
            "$ref": "#/$defs/MoveStatement"
        },
        {
            "$ref": "#/$defs/SendStatement"
        },
        {
            "$ref": "#/$defs/ExecStatement"
        },
        {
            "$ref": "#/$defs/BareStatement"
        },
        {
            "$ref": "#/$defs/WorkStatement"
        },
        {
            "$ref": "#/$defs/ForkStatement"
        },
        {
            "$ref": "#/$defs/KillStatement"
        },
        {
            "$ref": "#/$defs/DispositionStatement"
        }
    ],
    "$defs": {
        "AsideOrNull": {
            "type": [
                "string",
                "null"
            ]
        },
        "SchemeMetadataOrNull": {
            "description": "Opaque ordered scheme-metadata modifier blocks. Contracts preserve each block's raw inner text; the addressed scheme exclusively owns interpretation and validation.",
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                {
                    "type": "null"
                }
            ]
        },
        "AppliedTagSignal": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^\\+?[^+\\-\\[\\],\\s\\u0000-\\u001F\\u007F-\\u009F][^\\[\\],\\s\\u0000-\\u001F\\u007F-\\u009F]*$"
                    }
                },
                {
                    "type": "null"
                }
            ]
        },
        "CurationTagSignal": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[+-]?[^+\\-\\[\\],\\s\\u0000-\\u001F\\u007F-\\u009F][^\\[\\],\\s\\u0000-\\u001F\\u007F-\\u009F]*$"
                    }
                },
                {
                    "type": "null"
                }
            ]
        },
        "PathOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/ParsedPath.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "LineMarkerOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/LineMarker.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "TextLineMarkerOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/TextLineMarker.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "MatcherBodyOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/MatcherBody.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "SendBodyOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/SendBody.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "PositionRef": {
            "$ref": "https://schemas.plurnk.xyz/v0/Position.json"
        },
        "FindStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "metadata",
                "target",
                "lineMarker",
                "matcher",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "FIND"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "metadata": {
                    "$ref": "#/$defs/SchemeMetadataOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/LineMarkerOrNull"
                },
                "matcher": {
                    "$ref": "#/$defs/MatcherBodyOrNull",
                    "description": "The selection matcher lifted from the heading's `[{\"pattern\": …}]` option ({§matcher-option}); null when the heading carries none."
                },
                "body": {
                    "type": "null",
                    "description": "FIND takes no body; its matcher is the `pattern` option."
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "ReadStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "metadata",
                "target",
                "lineMarker",
                "matcher",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "READ"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "metadata": {
                    "$ref": "#/$defs/SchemeMetadataOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/TextLineMarkerOrNull"
                },
                "matcher": {
                    "$ref": "#/$defs/MatcherBodyOrNull",
                    "description": "The selection matcher lifted from the heading's `[{\"pattern\": …}]` option ({§matcher-option}); null when the heading carries none."
                },
                "body": {
                    "type": "null"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "EditStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "metadata",
                "target",
                "lineMarker",
                "matcher",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "EDIT"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "metadata": {
                    "$ref": "#/$defs/SchemeMetadataOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/TextLineMarkerOrNull"
                },
                "matcher": {
                    "$ref": "#/$defs/MatcherBodyOrNull",
                    "description": "The selection matcher lifted from the heading's `[{\"pattern\": …}]` option ({§matcher-option}); null when the heading carries none."
                },
                "body": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "CopyStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "source",
                "destination",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "COPY"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "source": {
                    "$ref": "https://schemas.plurnk.xyz/v0/ResourceSelection.json"
                },
                "destination": {
                    "$ref": "https://schemas.plurnk.xyz/v0/ResourceSelection.json"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "MoveStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "source",
                "destination",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "MOVE"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "source": {
                    "$ref": "https://schemas.plurnk.xyz/v0/ResourceSelection.json"
                },
                "destination": {
                    "$ref": "https://schemas.plurnk.xyz/v0/ResourceSelection.json"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "SendStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "metadata",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "SEND"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "metadata": {
                    "$ref": "#/$defs/SchemeMetadataOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/LineMarkerOrNull"
                },
                "body": {
                    "$ref": "#/$defs/SendBodyOrNull"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "ExecStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "metadata",
                "executor",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "EXEC"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "metadata": {
                    "$ref": "#/$defs/SchemeMetadataOrNull"
                },
                "executor": {
                    "description": "The registered executor selected by the fence name; null is the default shell for native EXEC.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/LineMarkerOrNull"
                },
                "body": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "BareStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "metadata",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "BARE"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "metadata": {
                    "$ref": "#/$defs/SchemeMetadataOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "type": "null"
                },
                "body": {
                    "type": "string"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "KillStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "metadata",
                "target",
                "lineMarker",
                "matcher",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "KILL"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "metadata": {
                    "$ref": "#/$defs/SchemeMetadataOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/TextLineMarkerOrNull",
                    "description": "Scope of the kill: lines of a log body or of an entry ({§kill-scope}); null kills the whole target."
                },
                "matcher": {
                    "$ref": "#/$defs/MatcherBodyOrNull",
                    "description": "The selection matcher lifted from the heading's `[{\"pattern\": …}]` option ({§matcher-option}); null when the heading carries none."
                },
                "body": {
                    "type": "null",
                    "description": "KILL takes no body; its matcher is the `pattern` option."
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "WorkStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "metadata",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "WORK"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "metadata": {
                    "$ref": "#/$defs/SchemeMetadataOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "type": "null"
                },
                "body": {
                    "type": "string"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "ForkStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "metadata",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "FORK"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "metadata": {
                    "$ref": "#/$defs/SchemeMetadataOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "type": "null"
                },
                "body": {
                    "type": "string"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "DispositionStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "metadata",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "TASK"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "metadata": {
                    "type": "null"
                },
                "target": {
                    "type": "null"
                },
                "lineMarker": {
                    "$ref": "#/$defs/LineMarkerOrNull"
                },
                "body": {
                    "$ref": "https://schemas.plurnk.xyz/v0/Plan.json"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        }
    }
}
