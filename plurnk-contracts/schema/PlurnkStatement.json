{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/PlurnkStatement.json",
    "title": "PlurnkStatement",
    "description": "The parsed AST union for one protocol statement, discriminated by `op`. Every variant has fixed signal, target, lineMarker, annotation, body, delimiter, and source-position fields; operation-specific schemas constrain their types. A null field records an omitted tolerated slot and does not satisfy runtime requirements by itself.",
    "oneOf": [
        {
            "$ref": "#/$defs/FindStatement"
        },
        {
            "$ref": "#/$defs/ReadStatement"
        },
        {
            "$ref": "#/$defs/OpenStatement"
        },
        {
            "$ref": "#/$defs/FoldStatement"
        },
        {
            "$ref": "#/$defs/EditStatement"
        },
        {
            "$ref": "#/$defs/CopyStatement"
        },
        {
            "$ref": "#/$defs/MoveStatement"
        },
        {
            "$ref": "#/$defs/SendStatement"
        },
        {
            "$ref": "#/$defs/ExecStatement"
        },
        {
            "$ref": "#/$defs/BareStatement"
        },
        {
            "$ref": "#/$defs/WorkStatement"
        },
        {
            "$ref": "#/$defs/ForkStatement"
        },
        {
            "$ref": "#/$defs/KillStatement"
        },
        {
            "$ref": "#/$defs/PlanStatement"
        }
    ],
    "$defs": {
        "TagSignal": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                {
                    "type": "null"
                }
            ]
        },
        "AnnotationOrNull": {
            "type": [
                "string",
                "null"
            ]
        },
        "AppliedTagSignal": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^\\+?[^+\\-\\[\\],\\s\\u0000-\\u001F\\u007F-\\u009F][^\\[\\],\\s\\u0000-\\u001F\\u007F-\\u009F]*$"
                    }
                },
                {
                    "type": "null"
                }
            ]
        },
        "CurationTagSignal": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[+-]?[^+\\-\\[\\],\\s\\u0000-\\u001F\\u007F-\\u009F][^\\[\\],\\s\\u0000-\\u001F\\u007F-\\u009F]*$"
                    }
                },
                {
                    "type": "null"
                }
            ]
        },
        "PathOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/ParsedPath.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "LineMarkerOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/LineMarker.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "TextLineMarkerOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/TextLineMarker.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "MatcherBodyOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/MatcherBody.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "SendBodyOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/SendBody.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "ResourceSelectionOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/ResourceSelection.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "PositionRef": {
            "$ref": "https://schemas.plurnk.xyz/v0/Position.json"
        },
        "FindStatement": {
            "type": "object",
            "required": [
                "op",
                "delimiter",
                "annotation",
                "signal",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "FIND"
                },
                "delimiter": {
                    "type": "string"
                },
                "annotation": {
                    "$ref": "#/$defs/AnnotationOrNull"
                },
                "signal": {
                    "$ref": "#/$defs/AppliedTagSignal"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/LineMarkerOrNull"
                },
                "body": {
                    "$ref": "#/$defs/MatcherBodyOrNull"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "ReadStatement": {
            "type": "object",
            "required": [
                "op",
                "delimiter",
                "annotation",
                "signal",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "READ"
                },
                "delimiter": {
                    "type": "string"
                },
                "annotation": {
                    "$ref": "#/$defs/AnnotationOrNull"
                },
                "signal": {
                    "$ref": "#/$defs/AppliedTagSignal"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/TextLineMarkerOrNull"
                },
                "body": {
                    "type": "null"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "OpenStatement": {
            "type": "object",
            "required": [
                "op",
                "delimiter",
                "annotation",
                "signal",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "OPEN"
                },
                "delimiter": {
                    "type": "string"
                },
                "annotation": {
                    "$ref": "#/$defs/AnnotationOrNull"
                },
                "signal": {
                    "$ref": "#/$defs/CurationTagSignal"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/TextLineMarkerOrNull"
                },
                "body": {
                    "$ref": "#/$defs/MatcherBodyOrNull"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "FoldStatement": {
            "type": "object",
            "required": [
                "op",
                "delimiter",
                "annotation",
                "signal",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "FOLD"
                },
                "delimiter": {
                    "type": "string"
                },
                "annotation": {
                    "$ref": "#/$defs/AnnotationOrNull"
                },
                "signal": {
                    "$ref": "#/$defs/CurationTagSignal"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/TextLineMarkerOrNull"
                },
                "body": {
                    "$ref": "#/$defs/MatcherBodyOrNull"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "EditStatement": {
            "type": "object",
            "required": [
                "op",
                "delimiter",
                "annotation",
                "signal",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "EDIT"
                },
