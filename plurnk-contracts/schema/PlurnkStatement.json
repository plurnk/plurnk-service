{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/PlurnkStatement.json",
    "title": "PlurnkStatement",
    "description": "The parsed AST union for one protocol statement, discriminated by `op`. Every variant has fixed target, lineMarker, aside, body, and source-position fields, the text and log operations add a matcher lifted from the `pattern` option, HTTP-capable operations add `headers` (and `kill` adds `remote`), and messaging operations add `attachments`; operation-specific schemas constrain their types. A null field records an omitted tolerated slot and does not satisfy runtime requirements by itself.",
    "oneOf": [
        {
            "$ref": "#/$defs/FindStatement"
        },
        {
            "$ref": "#/$defs/ReadStatement"
        },
        {
            "$ref": "#/$defs/EditStatement"
        },
        {
            "$ref": "#/$defs/CopyStatement"
        },
        {
            "$ref": "#/$defs/MoveStatement"
        },
        {
            "$ref": "#/$defs/SendStatement"
        },
        {
            "$ref": "#/$defs/DoneStatement"
        },
        {
            "$ref": "#/$defs/FailStatement"
        },
        {
            "$ref": "#/$defs/ExecStatement"
        },
        {
            "$ref": "#/$defs/BareStatement"
        },
        {
            "$ref": "#/$defs/WorkStatement"
        },
        {
            "$ref": "#/$defs/ForkStatement"
        },
        {
            "$ref": "#/$defs/KillStatement"
        },
        {
            "$ref": "#/$defs/DispositionStatement"
        },
        {
            "$ref": "#/$defs/NoteStatement"
        },
        {
            "$ref": "#/$defs/TodoStatement"
        }
    ],
    "$defs": {
        "AsideOrNull": {
            "type": [
                "string",
                "null"
            ]
        },
        "HeadersOrNull": {
            "description": "Optional HTTP request headers (`{ [name: string]: string }`); null when omitted.",
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                {
                    "type": "null"
                }
            ]
        },
        "AttachmentsOrNull": {
            "description": "Optional resource addresses attached to a message; null when omitted.",
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                {
                    "type": "null"
                }
            ]
        },
        "PathOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/ParsedPath.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "LineMarkerOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/LineMarker.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "TextLineMarkerOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/TextLineMarker.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "MatcherBodyOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/MatcherBody.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "SendBodyOrNull": {
            "oneOf": [
                {
                    "$ref": "https://schemas.plurnk.xyz/v0/SendBody.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "PositionRef": {
            "$ref": "https://schemas.plurnk.xyz/v0/Position.json"
        },
        "FindStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "headers",
                "target",
                "lineMarker",
                "matcher",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "find"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "headers": {
                    "$ref": "#/$defs/HeadersOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/LineMarkerOrNull"
                },
                "matcher": {
                    "$ref": "#/$defs/MatcherBodyOrNull",
                    "description": "The selection matcher lifted from the `pattern` option ({§parse-recovery}); null when omitted."
                },
                "body": {
                    "type": "null",
                    "description": "Retrieval bodies normalize to separate `note` statements; selection belongs to the options ({§op-shapes})."
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "ReadStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "headers",
                "target",
                "lineMarker",
                "matcher",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "read"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "headers": {
                    "$ref": "#/$defs/HeadersOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/TextLineMarkerOrNull"
                },
                "matcher": {
                    "$ref": "#/$defs/MatcherBodyOrNull",
                    "description": "The selection matcher lifted from the `pattern` option ({§parse-recovery}); null when omitted."
                },
                "body": {
                    "type": "null"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "EditStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "headers",
                "target",
                "lineMarker",
                "matcher",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "edit"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "headers": {
                    "$ref": "#/$defs/HeadersOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/TextLineMarkerOrNull"
                },
                "matcher": {
                    "$ref": "#/$defs/MatcherBodyOrNull",
                    "description": "The selection matcher lifted from the `pattern` option ({§parse-recovery}); null when omitted."
                },
                "body": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "CopyStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "source",
                "destination",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "copy"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "source": {
                    "$ref": "https://schemas.plurnk.xyz/v0/ResourceSelection.json"
                },
                "destination": {
                    "$ref": "https://schemas.plurnk.xyz/v0/ResourceSelection.json"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "MoveStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "source",
                "destination",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "move"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "source": {
                    "$ref": "https://schemas.plurnk.xyz/v0/ResourceSelection.json"
                },
                "destination": {
                    "$ref": "https://schemas.plurnk.xyz/v0/ResourceSelection.json"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "SendStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "headers",
                "attachments",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "send"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "headers": {
                    "$ref": "#/$defs/HeadersOrNull"
                },
                "attachments": {
                    "$ref": "#/$defs/AttachmentsOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "type": "null"
                },
                "body": {
                    "$ref": "#/$defs/SendBodyOrNull"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "DoneStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "attachments",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "done"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "attachments": {
                    "$ref": "#/$defs/AttachmentsOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "type": "null"
                },
                "body": {
                    "$ref": "#/$defs/SendBodyOrNull"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "FailStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "attachments",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "fail"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "attachments": {
                    "$ref": "#/$defs/AttachmentsOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "type": "null"
                },
                "body": {
                    "$ref": "#/$defs/SendBodyOrNull"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "ExecStatement": {
            "type": "object",
            "required": [
                "runtime",
                "aside",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "runtime": {
                    "description": "The runtime tag the call names, in its registered lowercase spelling. An execution has no operation keyword: the call name is the runtime, and the log row's op shows it as written.",
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9+._-]*$",
                    "tsType": "Lowercase<string>"
                },
                "op": {
                    "description": "Never present: an execution is named by its runtime.",
                    "not": {},
                    "tsType": "never"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "cwd": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "lineMarker": {
                    "$ref": "#/$defs/LineMarkerOrNull"
                },
                "body": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "BareStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "bare"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "type": "null"
                },
                "body": {
                    "type": "string"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "KillStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "headers",
                "remote",
                "target",
                "lineMarker",
                "matcher",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "kill"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "headers": {
                    "$ref": "#/$defs/HeadersOrNull"
                },
                "remote": {
                    "description": "Optional confirmation for remote HTTP DELETE (`true`); null when omitted.",
                    "type": ["boolean", "null"]
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/TextLineMarkerOrNull",
                    "description": "Scope of the kill: lines of a log body or of an entry ({§op-shapes}); null kills the whole target."
                },
                "matcher": {
                    "$ref": "#/$defs/MatcherBodyOrNull",
                    "description": "The selection matcher lifted from the `pattern` option ({§parse-recovery}); null when omitted."
                },
                "body": {
                    "type": ["string", "null"],
                    "description": "A `log:///` `kill` carries its optional distillation, kept as the model's own `note` row ({§log-kill-scope}). Other `kill` statements take no body; their matcher rides on the `pattern` option ({§parse-recovery})."
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "WorkStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "work"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "type": "null"
                },
                "body": {
                    "type": "string"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "ForkStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "fork"
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "type": "null"
                },
                "body": {
                    "type": "string"
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "DispositionStatement": {
            "type": "object",
            "required": [
                "op",
                "aside",
                "target",
                "lineMarker",
                "seconds",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "enum": ["wait"]
                },
                "aside": {
                    "$ref": "#/$defs/AsideOrNull"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "type": "null"
                },
                "seconds": {
                    "description": "Optional maximum park duration from `timeout` option; zero continues without parking.",
                    "type": ["number", "null"],
                    "minimum": 0
                },
                "body": {
                    "type": ["string", "null"]
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "NoteStatement": {
            "type": "object",
            "required": ["op", "aside", "target", "lineMarker", "body", "position"],
            "additionalProperties": false,
            "properties": {
                "op": { "const": "note" },
                "aside": { "$ref": "#/$defs/AsideOrNull" },
                "target": { "type": "null" },
                "lineMarker": { "type": "null" },
                "body": { "type": ["string", "null"] },
                "position": { "$ref": "#/$defs/PositionRef" }
            }
        },
        "TodoStatement": {
            "type": "object",
            "required": ["op", "aside", "target", "lineMarker", "body", "position"],
            "additionalProperties": false,
            "properties": {
                "op": { "const": "todo" },
                "aside": { "$ref": "#/$defs/AsideOrNull" },
                "target": { "type": "null" },
                "lineMarker": { "type": "null" },
                "body": { "type": ["string", "null"] },
                "position": { "$ref": "#/$defs/PositionRef" }
            }
        }
    }
}
