                },
                "annotation": {
                    "$ref": "#/$defs/AnnotationOrNull"
                },
                "signal": {
                    "oneOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/LineMarkerOrNull"
