                },
                "signal": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/LineMarkerOrNull"
                },
                "body": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                },
                "tags": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "BareStatement": {
            "type": "object",
            "required": [
                "op",
                "delimiter",
                "annotation",
                "signal",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "BARE"
                },
                "delimiter": {
                    "type": "string"
                },
                "annotation": {
                    "$ref": "#/$defs/AnnotationOrNull"
                },
                "signal": {
                    "$ref": "#/$defs/AppliedTagSignal"
                },
                "target": {
                    "type": "null"
                },
                "lineMarker": {
                    "type": "null"
                },
                "body": {
                    "type": "string",
                    "minLength": 1
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
