                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "SendStatement": {
            "type": "object",
            "required": [
                "op",
                "delimiter",
                "annotation",
                "signal",
                "target",
                "lineMarker",
                "body",
                "position"
            ],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "SEND"
                },
