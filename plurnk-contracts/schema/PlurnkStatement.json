                    "type": "string"
                },
                "annotation": {
                    "$ref": "#/$defs/AnnotationOrNull"
                },
                "signal": {
                    "$ref": "#/$defs/AppliedTagSignal"
                },
                "target": {
                    "$ref": "#/$defs/PathOrNull"
                },
                "lineMarker": {
                    "$ref": "#/$defs/TextLineMarkerOrNull"
                },
                "body": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "position": {
                    "$ref": "#/$defs/PositionRef"
                }
            }
        },
        "CopyStatement": {
