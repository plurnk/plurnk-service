{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/DaemonNotificationEnvelope.json",
    "title": "DaemonNotificationEnvelope",
    "description": "Canonical Watch envelope streamed over GET /notifications (notifications/snapshot, notifications/resync, and the 19 discrete DaemonNotification transitions).",
    "oneOf": [
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 0 },
                "event": { "const": "notifications/snapshot" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/NotificationsSnapshot" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 0 },
                "event": { "const": "notifications/resync" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/NotificationsResync" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "workspace/created" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": "null" },
                "data": { "$ref": "#/$defs/WorkspaceCreated" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "workspace/renamed" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": "null" },
                "data": { "$ref": "#/$defs/WorkspaceRenamed" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "workspace/archived" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": "null" },
                "data": { "$ref": "#/$defs/WorkspaceArchived" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "config/changed" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": "null" },
                "data": { "$ref": "#/$defs/ConfigChanged" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "functionality/changed" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/FunctionalityChanged" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "session/created" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/SessionCreated" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "session/archived" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/SessionArchived" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "session/deleted" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/SessionDeleted" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "session/titled" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/SessionTitled" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "session/policy" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/SessionPolicy" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "session/replied" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/SessionReplied" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "loop/started" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/LoopStarted" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "loop/parked" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/LoopParked" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "loop/proposal" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "https://schemas.plurnk.xyz/v0/ProposalProjection.json" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "loop/interaction" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "https://schemas.plurnk.xyz/v0/ClientInteractionProjection.json" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "loop/gate-settled" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/LoopGateSettled" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "loop/terminated" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/Terminated" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "stream/concluded" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/StreamConcluded" }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "timestamp", "workspaceId", "sessionId", "data"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "event": { "const": "notice/event" },
                "timestamp": { "type": "number" },
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "data": { "$ref": "#/$defs/NoticeEvent" }
            }
        }
    ],
    "$defs": {
        "ExteriorActorProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "handle"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "handle": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 }
            }
        },
        "OverviewReply": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "coordinate", "completion", "at", "excerpt", "continued"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "coordinate": { "type": "string", "minLength": 1 },
                "completion": { "enum": [200, 499] },
                "at": { "type": "number" },
                "excerpt": { "type": "string" },
                "continued": { "type": "boolean" }
            }
        },
        "OverviewWorkspace": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "projectRoot", "projectLabel"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "name": { "type": "string", "minLength": 1 },
                "projectRoot": { "type": ["string", "null"] },
                "projectLabel": { "type": ["string", "null"] }
            }
        },
        "OverviewSession": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "workspaceId",
                "id",
                "name",
                "parentSessionId",
                "parentName",
                "parentOrigin",
                "kind",
                "lifecycle",
                "gates",
                "reply"
            ],
            "properties": {
                "workspaceId": { "type": "integer", "minimum": 1 },
                "id": { "type": "integer", "minimum": 1 },
                "name": { "type": "string", "minLength": 1 },
                "parentSessionId": { "type": ["integer", "null"], "minimum": 1 },
                "parentName": { "type": ["string", "null"], "minLength": 1 },
                "parentOrigin": { "enum": ["model", "_plurnk", null] },
                "kind": { "enum": ["root", "fork", "work"] },
                "lifecycle": {
                    "enum": ["idle", "queued", "running", "parked", "completed", "cancelled", "failed"]
                },
                "gates": { "type": "integer", "minimum": 0 },
                "opening": { "type": "string", "minLength": 1 },
                "reply": {
                    "oneOf": [
                        { "$ref": "#/$defs/OverviewReply" },
                        { "type": "null" }
                    ]
                },
                "title": { "type": ["string", "null"], "minLength": 1 },
                "persona": { "type": ["string", "null"], "minLength": 1 }
            }
        },
        "WorkspaceCreated": {
            "$ref": "#/$defs/OverviewWorkspace"
        },
        "WorkspaceRenamed": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "name": { "type": "string", "minLength": 1 }
            }
        },
        "WorkspaceArchived": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "archivedAt"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "archivedAt": { "type": ["string", "null"] }
            }
        },
        "ConfigChanged": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workspaceId", "scope", "key"],
            "properties": {
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "scope": { "enum": ["service", "workspace"] },
                "key": { "type": "string", "minLength": 1 }
            }
        },
        "FunctionalityChanged": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workspaceId", "sessionId", "family"],
            "properties": {
                "workspaceId": { "type": ["integer", "null"], "minimum": 1 },
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "family": { "type": "string", "minLength": 1 }
            }
        },
        "SessionCreated": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "workspaceId",
                "workspaceName",
                "projectRoot",
                "projectLabel",
                "name",
                "parentSessionId",
                "origin",
                "kind",
                "lifecycle"
            ],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "workspaceId": { "type": "integer", "minimum": 1 },
                "workspaceName": { "type": "string", "minLength": 1 },
                "projectRoot": { "type": ["string", "null"] },
                "projectLabel": { "type": ["string", "null"] },
                "name": { "type": "string", "minLength": 1 },
                "parentSessionId": { "type": ["integer", "null"], "minimum": 1 },
                "origin": { "enum": ["model", "_plurnk"] },
                "kind": { "enum": ["root", "fork", "work"] },
                "lifecycle": { "enum": ["idle", "queued", "running", "parked", "completed", "cancelled", "failed"] },
                "persona": { "type": ["string", "null"], "minLength": 1 }
            }
        },
        "SessionArchived": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "archivedAt", "sessionIds"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "archivedAt": { "type": ["string", "null"] },
                "sessionIds": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 }
                }
            }
        },
        "SessionDeleted": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sessionIds"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "sessionIds": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 }
                }
            }
        },
        "SessionTitled": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "title": { "type": "string", "minLength": 1 }
            }
        },
        "SessionPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionId", "model", "childModel"],
            "properties": {
                "sessionId": { "type": "integer", "minimum": 1 },
                "model": {
                    "oneOf": [
                        { "$ref": "https://schemas.plurnk.xyz/v0/ModelRoute.json" },
                        { "type": "null" }
                    ]
                },
                "childModel": {
                    "oneOf": [
                        { "$ref": "https://schemas.plurnk.xyz/v0/ModelRoute.json" },
                        { "type": "null" }
                    ]
                },
                "persona": { "type": ["string", "null"], "minLength": 1 }
            }
        },
        "SessionReplied": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionId", "loopId", "loopSeq", "reply"],
            "properties": {
                "sessionId": { "type": "integer", "minimum": 1 },
                "loopId": { "type": "integer", "minimum": 1 },
                "loopSeq": { "type": "integer", "minimum": 1 },
                "reply": { "$ref": "#/$defs/OverviewReply" },
                "repliedToActors": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/ExteriorActorProfile" }
                }
            }
        },
        "LoopStarted": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionId", "loopId", "loopSeq"],
            "properties": {
                "sessionId": { "type": "integer", "minimum": 1 },
                "loopId": { "type": "integer", "minimum": 1 },
                "loopSeq": { "type": "integer", "minimum": 1 },
                "opening": { "type": "string", "minLength": 1 }
            }
        },
        "LoopParked": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionId", "loopId", "loopSeq", "status"],
            "properties": {
                "sessionId": { "type": "integer", "minimum": 1 },
                "loopId": { "type": "integer", "minimum": 1 },
                "loopSeq": { "type": "integer", "minimum": 1 },
                "status": { "const": 202 }
            }
        },
        "LoopGateSettled": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "sessionId", "loopId", "logEntryId", "decision", "outcome"],
                    "properties": {
                        "kind": { "const": "proposal" },
                        "sessionId": { "type": "integer", "minimum": 1 },
                        "loopId": { "type": "integer", "minimum": 1 },
                        "logEntryId": { "type": "integer", "minimum": 1 },
                        "decision": { "enum": ["accept", "reject", "cancel"] },
                        "outcome": { "type": "string", "minLength": 1 }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "sessionId", "loopId", "interactionId", "action"],
                    "properties": {
                        "kind": { "const": "interaction" },
                        "sessionId": { "type": "integer", "minimum": 1 },
                        "loopId": { "type": "integer", "minimum": 1 },
                        "interactionId": { "type": "integer", "minimum": 1 },
                        "action": { "enum": ["accept", "decline", "cancel"] }
                    }
                }
            ]
        },
        "Terminated": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sessionId",
                "loopId",
                "loopSeq",
                "result",
                "hitMaxTurns",
                "turnIds",
                "attributions",
                "terminatedAt",
                "usage"
            ],
            "properties": {
                "sessionId": { "type": "integer", "minimum": 1 },
                "loopId": { "type": "integer", "minimum": 1 },
                "loopSeq": { "type": "integer", "minimum": 1 },
                "result": { "$ref": "https://schemas.plurnk.xyz/v0/OperationResult.json" },
                "hitMaxTurns": { "type": "boolean" },
                "turnIds": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 }
                },
                "attributions": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "terminatedAt": { "type": "number" },
                "usage": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "accounting",
                        "curationWeight",
                        "curationBudget",
                        "contextTokens",
                        "contextCapacity",
                        "meta"
                    ],
                    "properties": {
                        "accounting": { "$ref": "https://schemas.plurnk.xyz/v0/ProviderAccounting.json" },
                        "curationWeight": { "type": ["number", "null"] },
                        "curationBudget": { "type": ["number", "null"] },
                        "contextTokens": { "type": ["number", "null"] },
                        "contextCapacity": { "type": ["number", "null"] },
                        "meta": {
                            "type": "object",
                            "additionalProperties": {}
                        }
                    }
                }
            }
        },
        "StreamConcluded": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sessionId",
                "entryId",
                "target",
                "subscriptionId",
                "result",
                "scheme",
                "summary",
                "wakeAction"
            ],
            "properties": {
                "sessionId": { "type": "integer", "minimum": 1 },
                "entryId": { "type": "integer", "minimum": 1 },
                "target": { "type": "string", "minLength": 1 },
                "subscriptionId": { "type": "integer", "minimum": 1 },
                "result": { "$ref": "https://schemas.plurnk.xyz/v0/OperationResult.json" },
                "scheme": { "type": "string", "minLength": 1 },
                "summary": { "type": "string" },
                "wakeAction": { "type": "string", "minLength": 1 },
                "loopSeq": { "type": "integer", "minimum": 1 },
                "turnSeq": { "type": "integer", "minimum": 1 },
                "sequence": { "type": "integer", "minimum": 1 }
            }
        },
        "NoticeEvent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionId", "loopId", "notice"],
            "properties": {
                "sessionId": { "type": ["integer", "null"], "minimum": 1 },
                "loopId": { "type": "integer", "minimum": 0 },
                "notice": { "$ref": "https://schemas.plurnk.xyz/v0/Notice.json" }
            }
        },
        "NotificationsSnapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "reason",
                "epoch",
                "latestId",
                "workspaces",
                "sessions",
                "proposals",
                "interactions",
                "omitted"
            ],
            "properties": {
                "reason": { "enum": ["initial", "restarted", "evicted", "malformed"] },
                "epoch": { "type": "string", "minLength": 1 },
                "latestId": { "type": "integer", "minimum": 0 },
                "workspaces": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/OverviewWorkspace" }
                },
                "sessions": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/OverviewSession" }
                },
                "proposals": {
                    "type": "array",
                    "items": { "$ref": "https://schemas.plurnk.xyz/v0/ProposalProjection.json" }
                },
                "interactions": {
                    "type": "array",
                    "items": { "$ref": "https://schemas.plurnk.xyz/v0/ClientInteractionProjection.json" }
                },
                "omitted": { "type": "integer", "minimum": 0 }
            }
        },
        "NotificationsResync": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason", "epoch", "latestId"],
            "properties": {
                "reason": { "enum": ["restarted", "evicted", "malformed"] },
                "epoch": { "type": "string", "minLength": 1 },
                "latestId": { "type": "integer", "minimum": 0 }
            }
        }
    }
}
