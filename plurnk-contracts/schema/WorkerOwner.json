{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/WorkerOwner.json",
    "title": "WorkerOwner",
    "description": "A workspace-scoped approval owner and the client tools it implements. Capabilities persist while disconnected; a message never changes ownership.",
    "type": "object",
    "required": ["address", "tools"],
    "additionalProperties": false,
    "properties": {
        "address": { "type": "string", "minLength": 1 },
        "tools": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
        }
    }
}
