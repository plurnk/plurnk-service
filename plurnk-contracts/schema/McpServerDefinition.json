{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/McpServerDefinition.json",
    "title": "McpServerDefinition",
    "description": "One complete MCP connection definition. Configuration sources supply it; workspace management persists it without installing a plugin.",
    "oneOf": [
        {
            "$ref": "#/$defs/stdio"
        },
        {
            "$ref": "#/$defs/streamableHttp"
        }
    ],
    "$defs": {
        "name": {
            "title": "McpServerName",
            "description": "The server's alias: its mcpServers member name, the runtime tag whose fence invokes it, and its resource scheme.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "stdio": {
            "title": "McpStdioServerDefinition",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "type",
                "command"
            ],
            "properties": {
                "name": {
                    "$ref": "#/$defs/name"
                },
                "type": {
                    "description": "A local server: a subprocess speaking MCP over its standard input and output.",
                    "const": "stdio"
                },
                "command": {
                    "description": "An executable name or path, without a shell. Relative paths resolve against the working directory.",
                    "type": "string",
                    "minLength": 1
                },
                "args": {
                    "description": "Exact arguments; ${NAME} environment references expand once.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "env": {
                    "description": "Process environment additions; ${NAME} references resolve against the workspace-composed operator environment.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "cwd": {
                    "description": "An absolute working directory, optionally using ${NAME} references. When absent the host supplies a workspace-owned state directory outside the project.",
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "streamableHttp": {
            "title": "McpStreamableHttpServerDefinition",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "type",
                "url"
            ],
            "properties": {
                "name": {
                    "$ref": "#/$defs/name"
                },
                "type": {
                    "description": "A remote server: an MCP endpoint over Streamable HTTP.",
                    "const": "streamable-http"
                },
                "url": {
                    "description": "The MCP endpoint: HTTPS, or HTTP on a loopback host.",
                    "type": "string",
                    "pattern": "^https?://"
                },
                "headers": {
                    "description": "Headers sent only to this endpoint; ${NAME} references expand at connection time. Protocol-owned headers are supplied by the client. Authorization cannot also be declared as a header when authorization is configured.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "authorization": {
                    "title": "McpAuthorization",
                    "description": "This endpoint's bearer or OAuth configuration. Secrets remain symbolic environment references.",
                    "oneOf": [
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "type",
                                "token"
                            ],
                            "properties": {
                                "type": {
                                    "const": "bearer"
                                },
                                "token": {
                                    "$ref": "https://schemas.plurnk.xyz/v0/McpOAuth.json#/$defs/environmentReference"
                                }
                            }
                        },
                        {
                            "$ref": "https://schemas.plurnk.xyz/v0/McpOAuth.json"
                        }
                    ]
                }
            }
        }
    }
}
