{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/TextRegion.json",
    "title": "TextRegion",
    "description": "A contiguous region of text. Lines and Unicode code-point columns are 1-based; the start is included and the end is excluded.",
    "type": "object",
    "required": ["startLine", "startColumn", "endLine", "endColumn"],
    "additionalProperties": false,
    "properties": {
        "startLine": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "startColumn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "endLine": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "endColumn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        }
    }
}
