{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/RangeExtent.json",
    "title": "RangeExtent",
    "description": "A compact projection of one line or ordered-result selection. Requested and returned positions are inclusive; total is the complete available cardinality.",
    "type": "object",
    "required": ["unit", "total", "requested"],
    "additionalProperties": false,
    "properties": {
        "unit": {
            "enum": ["line", "result", "resource", "matchLocation"]
        },
        "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "requested": {
            "$ref": "#/$defs/RequestedRange"
        },
        "returned": {
            "$ref": "#/$defs/ReturnedRange"
        }
    },
    "$defs": {
        "RequestedRange": {
            "type": "array",
            "items": {
                "type": "number",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
            },
            "minItems": 2,
            "maxItems": 2
        },
        "ReturnedRange": {
            "type": "array",
            "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "minItems": 2,
            "maxItems": 2
        }
    }
}
