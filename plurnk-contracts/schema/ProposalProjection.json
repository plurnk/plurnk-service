{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/ProposalProjection.json",
    "title": "ProposalProjection",
    "description": "The runtime-neutral client-interface projection of one durable stopped-world proposal. Live delivery and reconnect discovery expose this same shape.",
    "type": "object",
    "required": [
        "logEntryId",
        "sessionId",
        "session",
        "loopId",
        "turnId",
        "coordinate",
        "op",
        "target",
        "body",
        "attrs",
        "owner",
        "disposition"
    ],
    "additionalProperties": false,
    "properties": {
        "logEntryId": {
            "type": "integer",
            "minimum": 1
        },
        "sessionId": {
            "type": "integer",
            "minimum": 1
        },
        "session": {
            "description": "The requesting session's name.",
            "type": "string",
            "minLength": 1
        },
        "loopId": {
            "type": "integer",
            "minimum": 1
        },
        "turnId": {
            "type": "integer",
            "minimum": 1
        },
        "coordinate": {
            "description": "The gated operation's log coordinate, loop/turn/sequence: the id of the call it is.",
            "type": "string",
            "pattern": "^[0-9]+/[0-9]+/[0-9]+$"
        },
        "op": {
            "description": "An operation keyword, or a runtime tag: an execution's operation is its runtime.",
            "anyOf": [
                {
                    "enum": [
                        "FIND",
                        "READ",
                        "EDIT",
                        "COPY",
                        "MOVE",
                        "SEND",
                        "BARE",
                        "WORK",
                        "FORK",
                        "KILL",
                        "NOTE",
                        "WAIT"
                    ]
                },
                {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9+.-]*$"
                }
            ],
            "tsType": "\"FIND\" | \"READ\" | \"EDIT\" | \"COPY\" | \"MOVE\" | \"SEND\" | \"BARE\" | \"WORK\" | \"FORK\" | \"KILL\" | \"NOTE\" | \"WAIT\" | Lowercase<string>"
        },
        "target": {
            "type": "object",
            "required": [
                "scheme",
                "authority",
                "pathname"
            ],
            "additionalProperties": false,
            "properties": {
                "scheme": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "authority": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "pathname": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "body": {
            "type": "string"
        },
        "attrs": {
            "type": "object",
            "additionalProperties": true
        },
        "owner": {
            "type": "string",
            "minLength": 1
        },
        "disposition": {
            "$ref": "https://schemas.plurnk.xyz/v0/ProposalDisposition.json"
        },
        "selector": {
            "description": "The capability selector for the proposed operation, persisted on allow_always / reject_always.",
            "$ref": "https://schemas.plurnk.xyz/v0/CapabilitySelector.json"
        },
        "subject": {
            "description": "Structured ACP v2 permission subject for the proposed operation.",
            "oneOf": [
                {
                    "type": "object",
                    "required": ["type", "command", "cwd"],
                    "additionalProperties": false,
                    "properties": {
                        "type": { "const": "command" },
                        "command": { "type": "string" },
                        "cwd": { "type": "string", "minLength": 1 }
                    }
                },
                {
                    "type": "object",
                    "required": ["type", "kind", "title"],
                    "additionalProperties": false,
                    "properties": {
                        "type": { "const": "tool_call" },
                        "kind": {
                            "enum": ["read", "edit", "delete", "move", "search", "execute", "think", "fetch", "switch_mode", "other"]
                        },
                        "title": { "type": "string", "minLength": 1 },
                        "locations": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": ["path"],
                                "additionalProperties": false,
                                "properties": {
                                    "path": { "type": "string", "minLength": 1 }
                                }
                            }
                        },
                        "diff": {
                            "type": "object",
                            "required": ["path", "patch"],
                            "additionalProperties": false,
                            "properties": {
                                "path": { "type": "string" },
                                "patch": { "type": "string" }
                            }
                        }
                    }
                }
            ]
        },
        "expiresAt": {
            "description": "When the gate stops waiting and core cancels it (ISO 8601); absent while it waits indefinitely.",
            "type": "string",
            "format": "date-time"
        }
    }
}
