{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/Plan.json",
    "$comment": "Plurnk's model-native Plan is a bare array of {content, status} task entries. ACP projection (separately owned by AcpPlan.json) supplies the required priority at the edge.",
    "title": "Plan",
    "description": "Plurnk's model-native task inventory.",
    "type": "array",
    "items": {
        "$ref": "#/$defs/PlanEntry"
    },
    "$defs": {
        "PlanEntry": {
            "description": "One task or goal in the model's plan.",
            "type": "object",
            "properties": {
                "content": {
                    "description": "Human-readable description of what this task aims to accomplish.",
                    "type": "string"
                },
                "status": {
                    "description": "The current execution status of this task.",
                    "$ref": "#/$defs/PlanEntryStatus"
                },
                "_meta": {
                    "description": "Opaque entry metadata preserved through standards projection.",
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": true
                }
            },
            "required": [
                "content",
                "status"
            ],
            "additionalProperties": false
        },
        "PlanEntryStatus": {
            "description": "ACP v1 plan-entry lifecycle states.",
            "oneOf": [
                {
                    "type": "string",
                    "const": "pending"
                },
                {
                    "type": "string",
                    "const": "in_progress"
                },
                {
                    "type": "string",
                    "const": "completed"
                }
            ]
        }
    }
}
