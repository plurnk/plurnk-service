{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/CapabilityDescriptor.json",
    "title": "CapabilityDescriptor",
    "description": "One fully routed operation demand evaluated by the capability-policy cascade.",
    "type": "object",
    "required": ["operation", "access", "traits"],
    "additionalProperties": false,
    "properties": {
        "operation": {
            "description": "An operation keyword, or a runtime tag: an execution's operation is its runtime.",
            "anyOf": [
                { "enum": ["find", "read", "edit", "copy", "move", "send", "bare", "work", "fork", "kill"] },
                { "type": "string", "pattern": "^[a-z][a-z0-9+._-]*$", "not": { "enum": ["done", "fail", "note", "wait", "extension", "error"] } }
            ],
            "tsType": "\"find\" | \"read\" | \"edit\" | \"copy\" | \"move\" | \"send\" | \"bare\" | \"work\" | \"fork\" | \"kill\" | Lowercase<string>"
        },
        "scheme": { "type": "string", "pattern": "^[a-z][a-z0-9+._-]*$" },
        "runtime": { "type": "string", "pattern": "^[a-z][a-z0-9+._-]*$" },
        "tool": { "type": "string", "minLength": 1 },
        "access": { "enum": ["observe", "mutate", "execute", "interact", "control"] },
        "traits": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "uniqueItems": true
        }
    }
}
