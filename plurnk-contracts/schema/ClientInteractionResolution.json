{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/ClientInteractionResolution.json",
    "title": "ClientInteractionResolution",
    "description": "The standard ACP v2 / MCP elicitation response that settles one pending interaction. Declined and cancelled interactions carry no fabricated content.",
    "oneOf": [
        {
            "type": "object",
            "required": ["action"],
            "additionalProperties": false,
            "properties": {
                "action": { "const": "accept" },
                "content": { "type": "object", "additionalProperties": true }
            }
        },
        {
            "type": "object",
            "required": ["action"],
            "additionalProperties": false,
            "properties": {
                "action": { "const": "decline" }
            }
        },
        {
            "type": "object",
            "required": ["action"],
            "additionalProperties": false,
            "properties": {
                "action": { "const": "cancel" }
            }
        }
    ]
}
