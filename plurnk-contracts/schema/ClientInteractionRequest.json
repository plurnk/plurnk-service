{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.plurnk.xyz/v0/ClientInteractionRequest.json",
    "title": "ClientInteractionRequest",
    "description": "A runtime-neutral client elicitation request in standard ACP v2 / MCP form or URL mode. Protocol-private continuation state is excluded.",
    "oneOf": [
        {
            "type": "object",
            "required": ["toolName", "mode", "message", "requestedSchema"],
            "additionalProperties": false,
            "properties": {
                "toolName": { "type": "string", "minLength": 1 },
                "mode": { "const": "form" },
                "message": { "type": "string", "minLength": 1 },
                "requestedSchema": { "type": "object", "additionalProperties": true }
            }
        },
        {
            "type": "object",
            "required": ["toolName", "mode", "message", "elicitationId", "url"],
            "additionalProperties": false,
            "properties": {
                "toolName": { "type": "string", "minLength": 1 },
                "mode": { "const": "url" },
                "message": { "type": "string", "minLength": 1 },
                "elicitationId": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri", "minLength": 1 }
            }
        }
    ]
}
