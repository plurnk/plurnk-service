{
    "name": "@plurnk/plurnk-contracts",
    "version": "1.3.12",
    "description": "Runtime-neutral wire contracts for PLURNK problems, operation results, and notices",
    "keywords": [
        "plurnk",
        "rfc-9457",
        "problem-details",
        "protocol"
    ],
    "homepage": "https://github.com/plurnk/plurnk-contracts#readme",
    "bugs": {
        "url": "https://github.com/plurnk/plurnk-contracts/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-contracts.git"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./schema/*.json": {
            "plurnk-dev": "./schema/*.json",
            "default": "./schema/*.json"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "schema/*.json",
        "README.md",
        "SPEC.md"
    ],
    "scripts": {
        "build:types": "node --conditions=plurnk-dev scriptify/generate-types.ts",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:types && npm run build:dist",
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@cfworker/json-schema": "^4.1.1"
    },
    "devDependencies": {
        "json-schema-to-typescript": "^15.0.4"
    }
}
