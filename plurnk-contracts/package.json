{
    "name": "@plurnk/plurnk-contracts",
    "version": "1.17.0",
    "description": "Canonical PLURNK language contract, schemas, generated types, and runtime-neutral wire contracts",
    "keywords": [
        "plurnk",
        "rfc-9457",
        "protocol"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-contracts#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-contracts"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/src/index.d.ts",
            "default": "./dist/src/index.js"
        },
        "./package.json": "./package.json",
        "./schema/*.json": {
            "plurnk-dev": "./schema/*.json",
            "default": "./dist/schema/*.json"
        },
        "./conformance/*.json": {
            "plurnk-dev": "./conformance/*.json",
            "default": "./dist/conformance/*.json"
        }
    },
    "files": [
        "dist/**/*",
        "plurnk.md",
        "README.md",
        "SPEC.md"
    ],
    "scripts": {
        "build:types": "node --conditions=plurnk-dev scriptify/generate-types.ts",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build:schemas": "node --conditions=plurnk-dev scriptify/copy-schemas.ts",
        "build": "npm run build:clean && npm run build:types && npm run build:dist && npm run build:schemas",
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test src/*.test.ts test/unit/*.test.ts",
        "test:intg": "node --conditions=plurnk-dev --test test/integration/*.test.ts",
        "test:installation": "node --conditions=plurnk-dev scriptify/smoke-test.ts",
        "conformance:report": "node --conditions=plurnk-dev scriptify/agui-conformance-report.ts",
        "test": "npm run test:lint && npm run test:unit && npm run test:intg",
        "release:check": "npm run test:installation",
        "prepublishOnly": "npm audit && npm run build && npm test && npm run test:installation",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@cfworker/json-schema": "^4.1.1",
        "jsonc-parser": "^3.3.1"
    },
    "devDependencies": {
        "json-schema-to-typescript": "^16.0.0"
    }
}
