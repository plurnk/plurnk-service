# @plurnk/plurnk-contracts — the keys the daemon and every client share. One owner, read by all:
# the daemon folds this file into its floor with every other installed package's, and a client
# folds it beneath its own, so neither holds the other's default.

# Where the daemon listens, and so where a local client dials: one line moves both.
PLURNK_HOST=127.0.0.1
# The daemon's TCP port, shared by all client interfaces.
PLURNK_PORT=1066
# The whole URL a client dials instead: a remote portal, or a daemon bound to an address no
# client can dial (0.0.0.0). Unset = http://$PLURNK_HOST:$PLURNK_PORT.
# PLURNK_AGUI_URL=
