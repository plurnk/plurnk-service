# @plurnk/plurnk-contracts — the keys the daemon and every client share. One owner, read by all:
# the daemon folds this file into its floor with every other installed package's, and a client
# folds it beneath its own, so neither holds the other's default.

# Where the daemon listens, and so where a local client dials: one line moves both.
PLURNK_HOST=127.0.0.1
# The daemon's TCP port, shared by all client interfaces.
PLURNK_PORT=1066
# The whole URL a client dials instead: a remote portal, or a daemon bound to an address no
# client can dial (0.0.0.0). Unset = http://$PLURNK_HOST:$PLURNK_PORT/agui.
# PLURNK_AGUI_URL=

# Whether the daemon authenticates ({§credential-authority}): 1 = every request to the client
# interface and to the hosted agent presents a credential this daemon issued, and the daemon serves
# the authorization server that issues them; 0 = no credential exists and every request is
# anonymous, for a harness driving a daemon of its own. The posture is this value, never inferred
# from what else is set.
PLURNK_AUTH=1
# The operator's client secret ({§agui-oauth-clients}): what the terminal client and every other
# tool of yours exchanges for access tokens. Unset, the daemon mints one at every boot into the
# file `secret` beside its database (0600), where a tool running as you reads it. Set it here, and
# the same value in the tool's environment, for a tool on another host or under another user.
# PLURNK_SECRET=
# The operator's browser sign-in ({§agui-oauth-login}): user and password compared in constant time
# at the authorization endpoint. Both empty = a browser on this host is the operator without a
# sign-in ({§agui-oauth-session}), and a browser elsewhere is told the two settings. Set both on a
# host with other users, or behind a listener that is not loopback.
PLURNK_USER=
PLURNK_PASS=
