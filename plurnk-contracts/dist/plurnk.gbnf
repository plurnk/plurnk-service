tags ::= "[" tag tag-rest* "]"
branch ::= "[" [A-Za-z0-9_./-]+ "]"
tag ::= [A-Za-z0-9_.-]+
tag-rest ::= "," tag
target ::= "(" target-inner ")"
target-inner ::= target-atom+
target-atom ::= [^\x00-\x08\x0B-\x0C\x0E-\x1F\x7F\\()<\r\n] | target-escape
target-escape ::= "\\\\" | "\\(" | "\\)"
line ::= "<" int line-rest* ">"
line-rest ::= "," " "? int
int ::= "-"? [0-9]+ frac?
frac ::= "." [0-9]+
exec-sig ::= "[" [a-z] [a-z0-9_-]* "]"
kill-sig ::= "[" [0-9] [0-9]? "]"
