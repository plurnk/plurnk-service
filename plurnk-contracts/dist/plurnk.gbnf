park ::= "<" park-t park-poll? ">"
park-t ::= "-1" | [0-9]+
park-poll ::= "," [0-9]+
status-mid ::= [05-9] [0-9] [0-9] | "1" status-mid-1 | "2" status-mid-2 | "3" status-mid-3 | "4" status-mid-4
status-mid-1 ::= "0" [0-13-9] | [1-9] [0-9]
status-mid-2 ::= "0" [13-9] | [1-9] [0-9]
