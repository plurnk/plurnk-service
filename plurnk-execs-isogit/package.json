{
    "name": "@plurnk/plurnk-execs-isogit",
    "version": "1.9.0",
    "description": "Optional in-process isomorphic-git executor for shellless Plurnk deployments.",
    "keywords": [
        "plurnk",
        "exec",
        "runtime",
        "executor",
        "isomorphic-git",
        "sandbox"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-execs-isogit#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-execs-isogit"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "plurnk": {
        "kind": "exec",
        "runtimes": [
            {
                "name": "isogit",
                "glyph": "git",
                "summary": "Run supported in-process isomorphic-git commands.",
                "invocation": {
                    "body": {
                        "role": "isogit command and arguments",
                        "required": true
                    },
                    "target": {
                        "role": "repository directory",
                        "required": false,
                        "kind": "path"
                    },
                    "example": {
                        "target": ".",
                        "body": "status"
                    }
                }
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "docs/**/*",
        ".env.defaults"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file-if-exists=../plurnk-execs/.env.defaults --test \"src/**/*.test.ts\"",
        "test": "npm run test:lint && npm run test:unit",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepack": "npm run build",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test"
    },
    "dependencies": {
        "isomorphic-git": "1.41.9"
    },
    "peerDependencies": {
        "@plurnk/plurnk-execs": "^1.9.0"
    }
}
