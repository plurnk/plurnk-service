# @plurnk/plurnk-schemes-http — .env.defaults (operator config + defaults floor).
#
# Every knob this package reads, family-namespaced PLURNK_SCHEMES_HTTP_*. This
# file IS the operator documentation, and the daemon assembles every installed
# member's .env.defaults into one operative floor at boot — set-if-unset under
# the operator's env (service SPEC §operator-config-env-defaults, schemes#31).
# UNCOMMENTED keys are real defaults the floor sets. COMMENTED keys are modes
# whose ABSENCE is meaningful (unset = the documented behavior) — the floor
# must not set them. Standalone (no daemon), the required numerics fail hard
# when unset, naming the var.
#
# ── Required (render path) ───────────────────────────────────────────────────
# Navigation/render timeout in ms (page.goto networkidle budget).
PLURNK_SCHEMES_HTTP_FETCH_TIMEOUT=30000
# Salvage threshold in body-text chars: a networkidle timeout whose DOM already
# holds at least this much innerText is the chatty-page case (long-poll, ad
# refresh) — the render is kept; below it the timeout propagates.
PLURNK_SCHEMES_HTTP_SALVAGE_MIN_BODY_CHARS=200
# Warm-chromium idle teardown in ms: the browser process closes after this long
# with no render activity, and relaunches on the next render.
PLURNK_SCHEMES_HTTP_IDLE_TIMEOUT=900000

# ── Defaults (floor-set; override to change) ────────────────────────────────
# Playwright BrowserType method. "launch" uses the compatible bundled Chromium
# unless CHANNEL or EXECUTABLE_PATH selects another local browser. "connect"
# uses a Playwright protocol endpoint; "connectOverCDP" attaches to a running
# Chromium browser; "disabled" explicitly removes rendered HTML retrieval.
PLURNK_SCHEMES_HTTP_PLAYWRIGHT_METHOD=launch
# Browser launch/connection timeout in ms.
PLURNK_SCHEMES_HTTP_PLAYWRIGHT_TIMEOUT=30000
# Headless launch. Set 0 for a visible operator-managed browser session.
PLURNK_SCHEMES_HTTP_PLAYWRIGHT_HEADLESS=1
# Playwright's Chromium sandbox launch option. Playwright defaults this off;
# set 1 only where the host/container supports Chromium user namespaces.
PLURNK_SCHEMES_HTTP_PLAYWRIGHT_CHROMIUM_SANDBOX=0
# Mobile device emulation on the render path (Pixel-5-class viewport + UA):
# responsive sites serve a lighter, less-chrome layout — a better generation
# hint. "0" renders desktop (escape hatch for sites that serve degraded or
# blocked mobile content). Required read: unset crashes at render, naming the var.
PLURNK_SCHEMES_HTTP_MOBILE=1
# Per-URL freshness TTL in ms: a re-read of a URL fetched within this window
# serves the stored copy with ZERO round-trips (no conditional GET). This makes
# a just-materialized web entry immediately readable like any other entry.
# 0 opts into revalidation on every read via ETag/304.
# Required read: unset crashes, naming the var.
PLURNK_SCHEMES_HTTP_TTL_MS=300000
# Max HTTP redirect hops the SSRF-guarded fetch follows (WebFetcher). Each hop is
# re-guarded — a public URL redirecting into private space is refused. 0 follows
# none (strictest). Required read: unset crashes, naming the var.
PLURNK_SCHEMES_HTTP_REDIRECTS=5
# Maximum buffered characters in one incomplete SSE line/event. Exceeding this
# bound terminates the remote stream instead of allowing unbounded memory growth.
PLURNK_SCHEMES_HTTP_SSE_MAX_BUFFER_CHARS=1048576
# Maximum characters retained from a caught fetch, render, or transport
# diagnostic in a model-facing Problem detail. Complete errors remain in daemon
# diagnostics.
PLURNK_SCHEMES_HTTP_ERROR_DETAIL_LIMIT=512

# ── Optional modes (absence IS the mode — never floor-set) ──────────────────
# Required by connect/connectOverCDP: the Playwright or CDP endpoint.
# PLURNK_SCHEMES_HTTP_PLAYWRIGHT_ENDPOINT=http://localhost:9222
# Optional launch channel: chromium, chrome, chrome-beta, chrome-dev,
# chrome-canary, msedge, msedge-beta, msedge-dev, or msedge-canary.
# PLURNK_SCHEMES_HTTP_PLAYWRIGHT_CHANNEL=chrome
# Optional exact browser executable for launch. Mutually exclusive with CHANNEL.
# PLURNK_SCHEMES_HTTP_PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium
# Chromium JS heap cap in MB (--max-old-space-size). Unset → chromium default.
# PLURNK_SCHEMES_HTTP_CHROMIUM_HEAP_MB=2048

# Native Playwright installation controls remain authoritative and pass through
# unchanged. These examples are intentionally unset.
# PLAYWRIGHT_BROWSERS_PATH=/var/cache/ms-playwright
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
