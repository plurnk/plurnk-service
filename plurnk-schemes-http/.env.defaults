# @plurnk/plurnk-schemes-http — HTTP acquisition and streams.

# Request deadline, ms.
PLURNK_SCHEMES_HTTP_FETCH_TIMEOUT=30000
# User-Agent sent when a request names none. Most sites serve their content to a browser identity;
# state your own to identify this deployment honestly instead.
PLURNK_SCHEMES_HTTP_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
# Stored URL freshness, ms; within the TTL, READ performs no request.
# 0 = revalidate on every READ (ETag/304 when available).
PLURNK_SCHEMES_HTTP_TTL_MS=300000
# Maximum automatic redirect hops; 0 = none.
PLURNK_SCHEMES_HTTP_REDIRECTS=5
# Maximum buffered characters per incomplete SSE line/event; overflow terminates the stream.
PLURNK_SCHEMES_HTTP_SSE_MAX_BUFFER_CHARS=1048576
# Maximum diagnostic characters in model-facing errors; daemon diagnostics remain complete.
PLURNK_SCHEMES_HTTP_ERROR_DETAIL_LIMIT=512
# Web host policy: unset/empty = every host; a JSON array admits only its hosts
# ("example.com", "*.example.com"); [] = no web access at all (e.g. an isolated benchmark).
# PLURNK_SCHEMES_HTTP_HOSTS=[]

# Optional HTML materializer; unset = installed local HTML projection.
# @plurnk/plurnk-schemes-http-tavily ships with the service; it needs TAVILY_API_KEY in the
# service environment and this selection to take part.
# PLURNK_SCHEMES_HTTP_MATERIALIZER=tavily-extract
