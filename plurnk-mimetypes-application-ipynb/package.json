{
    "name": "@plurnk/plurnk-mimetypes-application-ipynb",
    "version": "2.0.1",
    "description": "application/x-ipynb+json (Jupyter notebook) mimetype handler for plurnk-service. Notebook reading Markdown, cell symbols, and source-located structural queries.",
    "keywords": [
        "plurnk",
        "mimetype",
        "ipynb",
        "jupyter",
        "notebook"
    ],
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "plurnk": {
        "kind": "mimetype",
        "handlers": [
            {
                "name": "application/x-ipynb+json",
                "revision": "3",
                "glyph": "📓",
                "extensions": [
                    ".ipynb"
                ]
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^3.0.0"
    },
    "dependencies": {
        "@plurnk/plurnk-mimetypes-application-json": "^2.0.0",
        "jsonc-parser": "^3.3.1"
    },
    "devDependencies": {
        "@plurnk/plurnk-contracts": "^3.0.1"
    },
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-mimetypes-application-ipynb#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-mimetypes-application-ipynb"
    }
}
