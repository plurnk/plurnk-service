{
    "name": "@plurnk/plurnk-hooks",
    "version": "2.0.0",
    "description": "Deliver selected Plurnk lifecycle events to exact local commands.",
    "keywords": [
        "plurnk",
        "hooks",
        "notifications",
        "automation"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-hooks#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-hooks"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "dependencies": {
        "@plurnk/plurnk-contracts": "^2.0.0",
        "@plurnk/plurnk-meta": "^2.0.0"
    },
    "peerDependencies": {
        "@plurnk/plurnk-modules": "^2.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./module": {
            "plurnk-dev": "./src/daemon-module.ts",
            "types": "./dist/daemon-module.d.ts",
            "default": "./dist/daemon-module.js"
        },
        "./package.json": "./package.json"
    },
    "plurnk": {
        "kind": "module",
        "module": "./module"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "SPEC.md",
        ".env.defaults"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file=.env.defaults --test \"src/**/*.test.ts\"",
        "test": "npm run test:lint && npm run test:unit",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepack": "npm run build",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test"
    }
}
