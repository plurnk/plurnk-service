# @plurnk/plurnk-hooks — exact-command event delivery.
# Both COMMAND and EVENTS are required to enable hooks. No shell interpretation.

# Exact executable; each invocation receives one event envelope on stdin.
# PLURNK_HOOKS_COMMAND=/usr/bin/node
# Literal argument vector, JSON array.
# PLURNK_HOOKS_ARGS=["/absolute/path/to/plurnk-hook.mjs"]
# Selected events, comma-separated.
# PLURNK_HOOKS_EVENTS=loop/terminated,loop/proposal,notice/event
# Delivery deadline, positive ms; expiry terminates the hook, not the loop.
PLURNK_HOOKS_TIMEOUT_MS=30000
