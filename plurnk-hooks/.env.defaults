# --- @plurnk/plurnk-hooks : exact command lifecycle hooks ---

# Hooks are disabled until both an exact executable and explicit event selection
# are configured. Arguments are a JSON array; no shell command is interpreted.
# PLURNK_HOOKS_COMMAND=/usr/bin/node
# PLURNK_HOOKS_ARGS=["/absolute/path/to/plurnk-hook.mjs"]
# PLURNK_HOOKS_EVENTS=loop/terminated,loop/proposal,notice/event

# One hook process receives one event envelope on stdin. This positive integer
# bounds each delivery; expiry terminates that process without affecting the loop.
PLURNK_HOOKS_TIMEOUT_MS=30000
