{
    "name": "@plurnk/plurnk-mimetypes",
    "version": "1.10.0",
    "description": "Framework + detection service for the @plurnk/plurnk-mimetypes-* handler packages.",
    "keywords": [
        "plurnk",
        "mimetype",
        "llm",
        "symbols",
        "structural"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-mimetypes#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-mimetypes"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./conformance": {
            "plurnk-dev": "./src/conformance.ts",
            "types": "./dist/conformance.d.ts",
            "default": "./dist/conformance.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "plurnk-mimetypes-compile": "./bin/plurnk-mimetypes-compile.js"
    },
    "files": [
        "dist/**/*",
        "bin/*.js",
        ".env.defaults",
        "README.md",
        "SPEC.md"
    ],
    "scripts": {
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file=.env.defaults --test scripts/*.test.mjs src/*.test.ts src/treesitter/*.test.ts src/issues/*.test.ts",
        "test:intg": "node --conditions=plurnk-dev --env-file=.env.defaults --test test/integration/**/*.test.ts test/conformance/*.test.ts",
        "test": "npm run test:lint && npm run test:unit && npm run test:intg",
        "grammars:check": "node --conditions=plurnk-dev scripts/update-grammars.mjs --check",
        "grammars:verify": "node scripts/verify-grammar-packages.mjs",
        "grammars:update": "node --conditions=plurnk-dev scripts/update-grammars.mjs",
        "grammars:publish": "node --conditions=plurnk-dev scripts/publish-grammars.mjs",
        "deps:check": "node --conditions=plurnk-dev scripts/deps-check.mjs",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "antlr-ng": "^1.0.10"
    },
    "peerDependenciesMeta": {
        "antlr-ng": {
            "optional": true
        }
    },
    "devDependencies": {
        "@plurnk/plurnk-mimetypes-grammar-bash": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-c": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-cpp": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-css": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-dart": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-elixir": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-fsharp": "1.4.0",
        "@plurnk/plurnk-mimetypes-grammar-fsharp-signature": "1.4.0",
        "@plurnk/plurnk-mimetypes-grammar-go": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-haskell": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-java": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-javascript": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-julia": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-kotlin": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-lua": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-make": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-ocaml": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-odin": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-php": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-python": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-ruby": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-rust": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-scala": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-toml": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-tsx": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-typescript": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-yaml": "1.3.1",
        "@plurnk/plurnk-mimetypes-grammar-zig": "1.3.1",
        "antlr4ng": "^3.0.16",
        "web-tree-sitter": "^0.26.9"
    },
    "dependencies": {
        "@plurnk/plurnk-contracts": "1.10.0",
        "@plurnk/plurnk-meta": "1.10.0",
        "@xmldom/xmldom": "^0.9.10",
        "antlr4ng": "^3.0.16",
        "json-p3": "^2.2.2",
        "smol-toml": "^1.7.1",
        "web-tree-sitter": "^0.26.9",
        "xpath": "^0.0.34",
        "yaml": "^2.9.0"
    }
}
