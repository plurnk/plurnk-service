# @plurnk/plurnk-mimetypes — operator configuration ({§mimetype-binary-input}).
#
# Maximum source bytes admitted to one installed binary handler invocation.
# Raw bytes remain transient; exceeding this ceiling rejects projection before
# the complete source is retained in memory. Format handlers may impose a
# stricter limit. Set a positive integer number of bytes.
PLURNK_MIMETYPES_BINARY_INPUT_MAX_BYTES=104857600
