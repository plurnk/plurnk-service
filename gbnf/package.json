{
    "name": "@plurnk/gbnf",
    "version": "1.4.0",
    "description": "A Node-native, zero-dependency GBNF grammar validator",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "bin": {
        "gbnf": "./dist/bin/gbnf.js"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/src/index.d.ts",
            "default": "./dist/src/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "gbnf"
    },
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/gbnf#readme",
    "keywords": [
        "gbnf",
        "grammar",
        "bnf",
        "ebnf",
        "llama.cpp",
        "validator",
        "constrained-generation"
    ],
    "scripts": {
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "oracle:fetch": "scripts/fetchLlamaGrammar.sh",
        "oracle:build": "scripts/buildLlama.sh",
        "oracle:check": "scripts/checkLlamaGrammar.sh",
        "test:lint": "tsc --noEmit",
        "test:intg": "node --conditions=plurnk-dev --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=50 --test-coverage-branches=50 --test-coverage-functions=50 test/intg/*.test.ts",
        "test:llama": "node --conditions=plurnk-dev --test test/e2e/*.test.ts",
        "test": "npm run test:lint && npm run test:intg",
        "prepublishOnly": "npm test && npm run build:dist",
        "prepack": "npm run build"
    }
}
