{
    "name": "@plurnk/gbnf",
    "version": "1.3.2",
    "description": "A Node-native, zero-dependency GBNF grammar validator",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "bin": {
        "gbnf": "./dist/bin/gbnf.js"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/src/index.d.ts",
            "default": "./dist/src/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/gbnf.git"
    },
    "bugs": "https://github.com/plurnk/gbnf/issues",
    "homepage": "https://github.com/plurnk/gbnf#readme",
    "keywords": [
        "gbnf",
        "grammar",
        "bnf",
        "ebnf",
        "llama.cpp",
        "validator",
        "constrained-generation"
    ],
    "scripts": {
        "build:dist": "rm -rf dist && tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "oracle:fetch": "scripts/fetchLlamaGrammar.sh",
        "oracle:build": "scripts/buildLlama.sh",
        "oracle:check": "scripts/checkLlamaGrammar.sh",
        "test:lint": "tsc --noEmit",
        "test:intg": "node --conditions=plurnk-dev --test test/intg/*.test.ts",
        "test:e2e": "node --conditions=plurnk-dev --test test/e2e/*.test.ts",
        "test:coverage": "node --conditions=plurnk-dev --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=50 --test-coverage-branches=50 --test-coverage-functions=50 test/intg/*.test.ts",
        "test:all": "npm run test:lint && npm run test:coverage && npm run test:e2e",
        "prepublishOnly": "npm run test:lint && npm run test:intg && npm run build:dist",
        "prepack": "npm run build:dist"
    }
}
