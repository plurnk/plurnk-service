{
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "types": [
            "node"
        ],
        "customConditions": [
            "plurnk-dev"
        ],
        "incremental": true
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts",
        "bin/**/*.ts",
        "scripts/**/*.ts",
        "scriptify/**/*.ts"
    ]
}
