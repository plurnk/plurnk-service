{
    "name": "@plurnk/plurnk-mimetypes-text-ini",
    "version": "1.3.1",
    "description": "text/x-ini (INI / config) mimetype handler for plurnk-service. Sections and keys as symbols. Hand-rolled, no parser dependency.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "plurnk": {
        "kind": "mimetype",
        "handlers": [
            {
                "name": "text/x-ini",
                "glyph": "⚙️",
                "extensions": [
                    ".ini",
                    ".cfg",
                    "setup.cfg",
                    "tox.ini",
                    "pytest.ini",
                    ".editorconfig",
                    ".flake8",
                    ".pylintrc"
                ]
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^1.3.1"
    }
}
