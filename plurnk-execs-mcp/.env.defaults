# --- @plurnk/plurnk-execs-mcp : MCP server bridge ---
# Each configured server becomes an EXEC[tag]/tag:// runtime. One var per server;
# the name after the prefix IS the server tag. Sets no operative default — these
# comments ARE the operator docs.

# Runtime hotload gate (SPEC §3.2, the introduction gate). OFF unless set: a
# running daemon may NOT /mcp add servers at runtime while unset.
# PLURNK_EXECS_MCP_INSTALL=1

# A server — value is an https URL (remote) or a stdio command line (local):
# PLURNK_EXECS_MCP_<server>=https://mcp.example.com/sse
# stdio env overlay (JSON) — tokens for a local stdio server:
# PLURNK_EXECS_MCP_<server>_ENV={"GITHUB_TOKEN":"..."}
# http request headers (JSON) — auth for a remote server:
# PLURNK_EXECS_MCP_<server>_HEADERS={"Authorization":"Bearer ..."}
