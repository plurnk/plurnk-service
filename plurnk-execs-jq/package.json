{
    "name": "@plurnk/plurnk-execs-jq",
    "version": "1.11.0",
    "description": "jq runtime executor for plurnk-service's exec scheme — shells the system jq binary to filter or transform JSON.",
    "keywords": [
        "plurnk",
        "exec",
        "runtime",
        "executor",
        "jq",
        "json",
        "filter"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-execs-jq#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-execs-jq"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "plurnk": {
        "kind": "exec",
        "runtimes": [
            {
                "name": "jq",
                "glyph": "🧰",
                "summary": "Transform JSON with jq.",
                "invocation": {
                    "body": {
                        "role": "jq filter",
                        "required": false
                    },
                    "target": {
                        "role": "JSON input",
                        "required": false,
                        "kind": "resource"
                    },
                    "example": {
                        "target": "package.json",
                        "body": ".name"
                    }
                }
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "docs/**/*"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file-if-exists=../plurnk-execs/.env.defaults --test \"src/**/*.test.ts\"",
        "test": "npm run test:lint && npm run test:unit",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepack": "npm run build",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test"
    },
    "peerDependencies": {
        "@plurnk/plurnk-execs": "^1.11.0"
    }
}
