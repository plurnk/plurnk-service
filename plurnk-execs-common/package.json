            {
                "name": "bc",
                "glyph": "🧮",
                "summary": "Evaluate calculations with bc.",
                "invocation": {
                    "body": {
                        "role": "bc program; stdin when the target is a script",
                        "required": false
                    },
                    "target": {
                        "role": "cwd or script; never a command",
                        "required": false,
                        "kind": "resource",
