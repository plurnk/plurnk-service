            {
                "name": "awk",
                "glyph": "🪄",
                "summary": "Run AWK code or scripts.",
                "invocation": {
                    "body": {
                        "role": "AWK program; stdin when the target is a script",
                        "required": false
                    },
                    "target": {
                        "role": "cwd or script; never a command",
                        "required": false,
                        "kind": "resource",
                        "directory": "cwd"
                    },
