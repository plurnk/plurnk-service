{
    "name": "@plurnk/plurnk-execs-common",
    "version": "1.5.0",
    "description": "Universal subprocess executor for plurnk-service's exec scheme — one package exposing the shell + node + python floor plus whichever host interpreters (perl, ruby, php, lua, awk, bc, …) are present.",
    "keywords": [
        "plurnk",
        "exec",
        "runtime",
        "executor",
        "subprocess",
        "repl",
        "shell",
        "node",
        "python"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-execs-common#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-execs-common"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "plurnk": {
        "kind": "exec",
        "runtimes": [
            {
                "name": "sh",
                "glyph": "🐚",
                "example": "## EXEC1\nuname -sr\n\n## EXEC1 [sh] (build.sh)\n\n## EXEC1 <-1,300>\nnpm run test"
            },
            {
                "name": "bash",
                "glyph": "🐚"
            },
            {
                "name": "node",
                "glyph": "⬢",
                "example": "## EXEC1 [node]\nconsole.log(new Date(Date.now() + 14 * 86_400_000).toISOString().slice(0, 10))"
            },
            {
                "name": "python",
                "glyph": "🐍",
                "example": "## EXEC1 [python]\nprint(sum(range(101)))"
            },
            {
                "name": "python3",
                "glyph": "🐍",
                "example": "## EXEC1 [python3]\nprint(sum(range(101)))"
            },
            {
                "name": "perl",
                "glyph": "🐪",
                "example": "## EXEC1 [perl]\nprint join(',', 1..5)"
            },
            {
                "name": "ruby",
                "glyph": "💎",
                "example": "## EXEC1 [ruby]\nputs (1..5).sum"
            },
            {
                "name": "php",
                "glyph": "🐘",
                "example": "## EXEC1 [php]\necho array_sum([1,2,3]);"
            },
            {
                "name": "lua",
                "glyph": "🌙",
                "example": "## EXEC1 [lua]\nprint(('hi'):upper())"
            },
            {
                "name": "deno",
                "glyph": "🦕",
                "example": "## EXEC1 [deno]\nconsole.log(Deno.version.deno)"
            },
            {
                "name": "bun",
                "glyph": "🥟",
                "example": "## EXEC1 [bun]\nconsole.log(Bun.version)"
            },
            {
                "name": "tcl",
                "glyph": "🪶",
                "example": "## EXEC1 [tcl]\nputs [expr {2**10}]"
            },
            {
                "name": "bc",
                "glyph": "🧮",
                "example": "## EXEC1 [bc]\nscale=4; 22/7"
            },
            {
                "name": "awk",
                "glyph": "🪄",
                "example": "## EXEC1 [awk]\nBEGIN { print 6 * 7 }"
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md",
        ".env.example",
        "docs/**/*"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file-if-exists=../plurnk-execs/.env.defaults --test \"src/**/*.test.ts\"",
        "test": "npm run test:lint && npm run test:unit",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepack": "npm run build",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test"
    },
    "peerDependencies": {
        "@plurnk/plurnk-execs": "^1.5.0"
    }
}
