{
    "name": "@plurnk/plurnk-execs-common",
    "version": "1.10.1",
    "description": "Universal subprocess executor for plurnk-service's exec scheme — one package exposing the shell + node + python floor plus whichever host interpreters (perl, ruby, php, lua, awk, bc, …) are present.",
    "keywords": [
        "plurnk",
        "exec",
        "runtime",
        "executor",
        "subprocess",
        "repl",
        "shell",
        "node",
        "python"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-execs-common#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-execs-common"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "plurnk": {
        "kind": "exec",
        "runtimes": [
            {
                "name": "sh",
                "glyph": "🐚",
                "summary": "Run POSIX shell commands and scripts.",
                "invocation": {
                    "body": {
                        "role": "the shell program; stdin when the target is a script",
                        "required": false
                    },
                    "target": {
                        "role": "cwd or script; never a command",
                        "required": false,
                        "kind": "resource",
                        "directory": "cwd"
                    },
                    "example": {
                        "body": "git status --short"
                    }
                }
            },
            {
                "name": "bash",
                "glyph": "🐚",
                "summary": "Run Bash code or scripts.",
                "invocation": {
                    "body": {
                        "role": "the Bash program; stdin when the target is a script",
                        "required": false
                    },
                    "target": {
                        "role": "cwd or script; never a command",
                        "required": false,
                        "kind": "resource",
                        "directory": "cwd"
                    },
                    "signature": "shell code"
                }
            },
            {
                "name": "node",
                "glyph": "⬢",
                "summary": "Run JavaScript code or scripts with Node.js.",
                "invocation": {
                    "body": {
                        "role": "JavaScript program; stdin when the target is a script",
                        "required": false
                    },
                    "target": {
                        "role": "cwd or script; never a command",
                        "required": false,
                        "kind": "resource",
                        "directory": "cwd"
                    },
                    "signature": "JavaScript code"
                }
            },
            {
                "name": "python",
                "glyph": "🐍",
                "summary": "Run Python code or scripts.",
                "invocation": {
                    "body": {
                        "role": "Python program; stdin when the target is a script",
                        "required": false
                    },
                    "target": {
                        "role": "cwd or script; never a command",
                        "required": false,
                        "kind": "resource",
                        "directory": "cwd"
                    },
                    "signature": "Python code"
                }
            },
            {
                "name": "python3",
                "glyph": "🐍",
                "summary": "Run Python 3 code or scripts.",
                "invocation": {
                    "body": {
                        "role": "Python program; stdin when the target is a script",
                        "required": false
                    },
                    "target": {
                        "role": "cwd or script; never a command",
                        "required": false,
                        "kind": "resource",
