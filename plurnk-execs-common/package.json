{
    "name": "@plurnk/plurnk-execs-common",
    "version": "1.5.0",
    "description": "Universal subprocess executor for plurnk-service's exec scheme — one package exposing the shell + node + python floor plus whichever host interpreters (perl, ruby, php, lua, awk, bc, …) are present.",
    "keywords": [
        "plurnk",
        "exec",
        "runtime",
        "executor",
        "subprocess",
        "repl",
        "shell",
        "node",
        "python"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-execs-common#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-execs-common"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "plurnk": {
        "kind": "exec",
        "runtimes": [
            {
                "name": "sh",
                "glyph": "🐚",
                "invocation": {
                    "body": { "role": "shell program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "pwd" }
                }
            },
            {
                "name": "bash",
                "glyph": "🐚",
                "invocation": {
                    "body": { "role": "Bash program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "npm test" }
                }
            },
            {
                "name": "node",
                "glyph": "⬢",
                "invocation": {
                    "body": { "role": "JavaScript program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "console.log(process.version);" }
                }
            },
            {
                "name": "python",
                "glyph": "🐍",
                "invocation": {
                    "body": { "role": "Python program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "print(\"hello\")" }
                }
            },
            {
                "name": "python3",
                "glyph": "🐍",
                "invocation": {
                    "body": { "role": "Python program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "print(\"hello\")" }
                }
            },
            {
                "name": "perl",
                "glyph": "🐪",
                "invocation": {
                    "body": { "role": "Perl program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "print \"hello\\n\";" }
                }
            },
            {
                "name": "ruby",
                "glyph": "💎",
                "invocation": {
                    "body": { "role": "Ruby program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "puts \"hello\"" }
                }
            },
            {
                "name": "php",
                "glyph": "🐘",
                "invocation": {
                    "body": { "role": "PHP program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "<?php echo \"hello\\n\";" }
                }
            },
            {
                "name": "lua",
                "glyph": "🌙",
                "invocation": {
                    "body": { "role": "Lua program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "print(\"hello\")" }
                }
            },
            {
                "name": "deno",
                "glyph": "🦕",
                "invocation": {
                    "body": { "role": "Deno program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "console.log(Deno.version.deno);" }
                }
            },
            {
                "name": "bun",
                "glyph": "🥟",
                "invocation": {
                    "body": { "role": "Bun program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "console.log(Bun.version);" }
                }
            },
            {
                "name": "tcl",
                "glyph": "🪶",
                "invocation": {
                    "body": { "role": "Tcl program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "puts \"hello\"" }
                }
            },
            {
                "name": "bc",
                "glyph": "🧮",
                "invocation": {
                    "body": { "role": "bc program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "2 + 2" }
                }
            },
            {
                "name": "awk",
                "glyph": "🪄",
                "invocation": {
                    "body": { "role": "AWK program; stdin with a targeted script file", "required": false },
                    "target": { "role": "script file", "required": false, "kind": "resource", "directory": "cwd" },
                    "example": { "body": "BEGIN { print \"hello\" }" }
                }
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md",
        ".env.example",
        "docs/**/*"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file-if-exists=../plurnk-execs/.env.defaults --test \"src/**/*.test.ts\"",
        "test": "npm run test:lint && npm run test:unit",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepack": "npm run build",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test"
    },
    "peerDependencies": {
        "@plurnk/plurnk-execs": "^1.5.0"
    }
}
