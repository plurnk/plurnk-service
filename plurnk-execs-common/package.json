                    },
                    "signature": "TypeScript or JavaScript code"
                }
            },
            {
                "name": "tcl",
                "glyph": "🪶",
                "summary": "Run Tcl code or scripts.",
                "invocation": {
                    "body": {
                        "role": "Tcl program; stdin when the target is a script",
                        "required": false
                    },
                    "target": {
