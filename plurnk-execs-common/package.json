                    },
                    "signature": "PHP code"
                }
            },
            {
                "name": "lua",
                "glyph": "🌙",
                "summary": "Run Lua code or scripts.",
                "invocation": {
                    "body": {
                        "role": "Lua program; stdin when the target is a script",
                        "required": false
                    },
                    "target": {
