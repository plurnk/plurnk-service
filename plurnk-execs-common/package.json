                    },
                    "target": {
                        "role": "cwd or script; never a command",
                        "required": false,
                        "kind": "resource",
                        "directory": "cwd"
                    },
                    "signature": "Perl code"
                }
            },
            {
                "name": "ruby",
                "glyph": "💎",
                "summary": "Run Ruby code or scripts.",
                "invocation": {
                    "body": {
                        "role": "Ruby program; stdin when the target is a script",
                        "required": false
                    },
                    "target": {
                        "role": "cwd or script; never a command",
                        "required": false,
                        "kind": "resource",
