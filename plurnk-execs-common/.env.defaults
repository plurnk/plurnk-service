# @plurnk/plurnk-execs-common — secondary interpreters are opt-in.
# Set a runtime to 1 to register it; its interpreter must also be on PATH.
# sh, node, and python3 remain enabled through the executor framework's default.
PLURNK_EXECS_PERL=0
PLURNK_EXECS_RUBY=0
PLURNK_EXECS_LUA=0
PLURNK_EXECS_DENO=0
PLURNK_EXECS_BUN=0
PLURNK_EXECS_TCL=0
PLURNK_EXECS_BC=0
PLURNK_EXECS_AWK=0
