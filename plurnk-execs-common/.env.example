# @plurnk/plurnk-execs-common — environment

# sh, node, and python3 are enabled when their interpreter is available.
# Uncomment any optional runtime to enable it at the next service start.
# An enabled runtime still requires its interpreter on PATH.
# PLURNK_EXECS_PERL=1
# PLURNK_EXECS_RUBY=1
# PLURNK_EXECS_LUA=1
# PLURNK_EXECS_DENO=1
# PLURNK_EXECS_BUN=1
# PLURNK_EXECS_TCL=1
# PLURNK_EXECS_BC=1
# PLURNK_EXECS_AWK=1
