# @plurnk/plurnk-schedule — scheduled messages for workers.

# Time zone for schedules and for every command a worker runs; an IANA name. UTC unless the
# operator or a worker (through env) says otherwise; a rule without a TZID is stamped with the
# effective zone when it is added.
TZ=UTC
# Initially enabled service-origin rule aliases, JSON array; [] = none.
PLURNK_SCHEDULE_ENABLED=[]
# A service-origin rule: the operator's crontab. JSON with the RFC 5545 rule text (without a
# DTSTART it starts when the daemon starts), the target worker, the message, and an optional
# loop policy. Disable-only for a worker; may be unbounded.
# An empty alias definition masks the service rule and its ENABLED selection.
# PLURNK_SCHEDULE_heartbeat={"rule":"FREQ=HOURLY","target":"worker://plurnkbot","prompt":"Check for new messages and report."}
