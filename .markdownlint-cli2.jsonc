{
    "$schema": "./node_modules/markdownlint-cli2/markdownlint-cli2-config-schema.json",
    "globs": [
        "**/*.md"
    ],
    "ignores": [
        "**/.tmp/**",
        "**/dist/**",
        "**/node_modules/**",
        "**/test/**",
        "**/vendor/**",
        "plurnk-contracts/plurnk.md",
        "plurnk-meta/POLICY.md",
        "plurnk-meta/reasoning.md",
        "plurnk-meta/recap.md",
        "plurnk-meta/docs/**",
        "plurnk-meta/requirements.md",
        "scripts/fixtures/**"
    ],
    "noProgress": true,
    "config": {
        "MD013": false,
        "MD024": {
            "siblings_only": true
        },
        "MD033": {
            "allowed_elements": [
                "br"
            ]
        },
        "MD060": false
    }
}
