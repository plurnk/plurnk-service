# @plurnk/plurnk-acp — ACP v2 client protocol. Listener address: the shared PLURNK_HOST/PLURNK_PORT
# (@plurnk/plurnk-contracts). Authentication is the shared PLURNK_AUTH ({§credential-authority},
# {§auth-oauth}).

# The other origin whose pages a browser lets read replies (CORS): * = any page; one origin = that
# page only; empty = no CORS headers, so no page of another origin reads a reply.
PLURNK_ACP_ALLOW_ORIGIN=*
# Default prompt turn cap: empty = no module default; -1 = unlimited; otherwise nonnegative integer.
# Core's operator ceiling still applies.
PLURNK_ACP_MAX_TURNS=
# Stream heartbeat interval in ms (0..2147483647); 0 = off.
PLURNK_ACP_HEARTBEAT_MS=15000
# Conversation history a client receives on session/load ({§acp-session-load}): the bound worker's
# newest loops replayed initially before older loops are paged on demand.
PLURNK_ACP_HISTORY_LOOPS=2
# The most characters one replayed or live message/tool payload carries inline before body-by-reference
# or chunking applies.
PLURNK_ACP_HISTORY_PAGE_CHARS=2000000
# The most characters of a message's excerpt a list carries ({§list-excerpt}): a loop's opening in
# a worker's loop list and a worker's latest finished reply in the overview.
PLURNK_ACP_EXCERPT_CHARS=240
# The places one worker overview holds beside every place waiting on a gate; it counts the rest.
PLURNK_ACP_OVERVIEW_WORKERS=200
