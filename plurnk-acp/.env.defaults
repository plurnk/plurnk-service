# @plurnk/plurnk-acp — client protocol. Listener address: the shared PLURNK_HOST/PLURNK_PORT
# (@plurnk/plurnk-contracts). Authentication is the shared PLURNK_AUTH ({§credential-authority},
# {§auth-oauth}).

# The other origin whose pages a browser lets read replies (CORS): * = any page; one origin = that
# page only; empty = no CORS headers, so no page of another origin reads a reply (a page this
# daemon serves reads its own). The bearer, not this, is the perimeter.
PLURNK_ACP_ALLOW_ORIGIN=*
# Default run turn cap: empty = no module default; -1 = unlimited; otherwise nonnegative integer.
# Core's operator ceiling still applies.
PLURNK_ACP_MAX_TURNS=
# SSE comment heartbeat, ms (0..2147483647); 0 = off. Independent of model output.
PLURNK_ACP_HEARTBEAT_MS=15000
# Conversation history a client receives ({§acp-history-window}): a snapshot holds the bound session's newest
# loops, whole turns, and links the page before; GET at that link answers one loop at a time. No number fits
# every workload; these are the starting points.
PLURNK_ACP_HISTORY_LOOPS=2
# The most characters one snapshot, history page or live text delta serializes to.
PLURNK_ACP_HISTORY_PAGE_CHARS=2000000
# The most characters of a message's excerpt a list carries ({§application-session-observation}): a loop's opening in a session's loop
# list ({§acp-action-binding}) and a session's latest finished reply in the overview ({§acp-overview}).
PLURNK_ACP_EXCERPT_CHARS=240
# The places one session overview holds beside every place waiting on a gate ({§acp-overview}); it counts the rest.
PLURNK_ACP_OVERVIEW_SESSIONS=200
