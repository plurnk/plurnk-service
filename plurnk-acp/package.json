{
    "name": "@plurnk/plurnk-acp",
    "version": "1.0.0",
    "description": "ACP v2 WebSocket interface for the PLURNK daemon",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-acp"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./module": {
            "plurnk-dev": "./src/daemon-module.ts",
            "types": "./dist/daemon-module.d.ts",
            "default": "./dist/daemon-module.js"
        },
        "./client": {
            "plurnk-dev": "./src/client.ts",
            "types": "./dist/client.d.ts",
            "default": "./dist/client.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        ".env.defaults",
        "README.md",
        "SPEC.md"
    ],
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "test": "npm run test:lint && npm run test:unit && npm run test:intg",
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file-if-exists=../plurnk-contracts/.env.defaults --env-file-if-exists=.env.defaults --experimental-test-coverage --test-coverage-include-all '--test-coverage-include=src/**' --test ${PLURNK_TEST_CONCURRENCY:+--test-concurrency=$PLURNK_TEST_CONCURRENCY} src/*.test.ts",
        "test:intg": "export PLURNK_TEST_RUN=$(date -u +%Y%m%dT%H%M%SZ) PLURNK_TEST_LANE=acp; node --conditions=plurnk-dev --env-file-if-exists=../plurnk-contracts/.env.defaults --env-file-if-exists=.env.defaults --experimental-test-coverage --test-coverage-include-all '--test-coverage-include=src/**' --test ${PLURNK_TEST_CONCURRENCY:+--test-concurrency=$PLURNK_TEST_CONCURRENCY} test/intg/*.test.ts && node ../scripts/reclaim-green-run.mjs acp",
        "prepublishOnly": "npm test",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@types/ws": "^8.18.2"
    },
    "keywords": [
        "plurnk",
        "acp",
        "agent-client-protocol",
        "agent",
        "transport",
        "sse",
        "websocket",
        "json-rpc",
        "human-in-the-loop"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-acp#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "author": "@wikitopian",
    "peerDependencies": {
        "@plurnk/plurnk-modules": "^4.0.0",
        "@plurnk/plurnk-schemes": "^3.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@agentclientprotocol/sdk": "^2.2.0",
        "@plurnk/plurnk-contracts": "^6.0.0",
        "@plurnk/plurnk-meta": "^2.1.0",
        "@plurnk/plurnk-parser": "^4.2.0",
        "ws": "^8.22.0"
    },
    "plurnk": {
        "kind": "module",
        "module": "./module"
    }
}
