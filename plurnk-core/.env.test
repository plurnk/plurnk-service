# Committed real-model gate profile ({§operator-config-real-model-profile}, #25).
# Live/demo load this after operator files; candidate daemons load it below the
# inherited benchmark environment. Direct shell values still win. This profile
# owns the safe gate default; model aliases, provider routes, credentials, model
# tuning, and operator ceilings never belong here.
PLURNK_MODEL=rtx5070

# Exercise the ordinary semantic path. Atlas explicitly narrows this to the
# FTS-only path because its headless MCP task does not evaluate embeddings.
PLURNK_SERVICE_EMBED_DISABLE=0

# Give model-facing gates complete orientation and automatic Git membership
# when the operator's hard Git ceiling permits it (Atlas uses --no-git).
PLURNK_SERVICE_FILES_ITEMS=-1
PLURNK_SERVICE_GIT_AUTO=1

# Ambient operator-file docs and packet notes must not make a gate machine-dependent.
# Each harness separately owns its exact privileged policy.
PLURNK_SERVICE_MD_POLICY=
PLURNK_SERVICE_PACKET_INJECT=

# Ambient operator MCP selection must not change a general gate's tool surface,
# startup work, packet, or process tree. A deliberate shell value still wins.
PLURNK_MCP_ENABLED=[]
PLURNK_MCP_EXPANDED=[]
