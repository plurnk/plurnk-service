# Committed real-model gate profile ({§operator-config-real-model-profile}, #25).
# Live/demo load this after operator files; candidate daemons load it below the
# inherited benchmark environment. Direct shell values still win. This profile owns
# only what is the same on every machine: which model runs is the operator's, so the
# selector, alias declarations, provider routes, credentials, model tuning and
# operator ceilings all live in the operator's own files, never here.

# Give model-facing gates complete orientation and automatic Git membership
# when the operator's hard Git ceiling permits it (Atlas uses --no-git).
PLURNK_SERVICE_FILES_ITEMS=-1
PLURNK_SERVICE_GIT_AUTO=1

# A gate run is unattended on purpose and exists to watch the work happen, so it states the
# disposition the shipped panel deliberately withholds ({§loop-policy-composition}).
PLURNK_SERVICE_UNATTENDED_PROPOSALS=accept

# Ambient operator-file docs and packet notes must not make a gate machine-dependent.
# Each harness separately owns its exact privileged policy.
PLURNK_SERVICE_POLICY=
PLURNK_SERVICE_PACKET_INJECT=

# A gate reads the project's own Agent Skills and Plugins, never the operator's installed ones, and
# ambient MCP expansion must not change its packet. A deliberate shell value still wins.
PLURNK_SERVICE_ROOTS=project
PLURNK_MCP_EXPANDED=[]
PLURNK_MCP_ENABLED=0
PLURNK_A2A_ENABLED=0

# Drivers disable named operator-file resources independently; explicit shell overrides win.
# Keep operator schedules inert in disposable workspaces; specimens add their own.
PLURNK_SCHEDULE_ENABLED=0

# Unattended gates have no human to answer the question tool.
PLURNK_EXECS_QUESTION=0
