# Dependencies, builds, packs
node_modules/
dist/
*.tgz

# The operator's environment; the shipped defaults and the test floor are source.
.env
.env.*
!.env.defaults
!.env.example
!.env.test

# SQLite working files (WAL mode)
*.db
*.db-shm
*.db-wal

