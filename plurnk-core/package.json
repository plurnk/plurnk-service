{
    "name": "@plurnk/plurnk-service",
    "version": "2.0.0",
    "description": "Plurnk agent runtime — the server / engine / core. Implements the @plurnk/plurnk-contracts contract.",
    "keywords": [
        "plurnk",
        "agent",
        "llm",
        "daemon",
        "agui",
        "sqlite",
        "harness"
    ],
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./launch": {
            "plurnk-dev": "./src/launch/Launch.ts",
            "types": "./dist/launch/Launch.d.ts",
            "default": "./dist/launch/Launch.js"
        },
        "./package.json": "./package.json",
        "./evidence": {
            "plurnk-dev": "./src/evidence/EvidenceReader.ts",
            "types": "./dist/evidence/EvidenceReader.d.ts",
            "default": "./dist/evidence/EvidenceReader.js"
        }
    },
    "bin": {
        "plurnk-service": "dist/service.js"
    },
    "files": [
        ".env.defaults",
        "dist/**/*",
        "docs/**/*",
        "migrations/**/*.sql",
        "README.md",
        "INSTALL.md",
        "plurnk.service",
        "SPEC.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "start": "node --conditions=plurnk-dev src/service.ts",
        "types:sqlrite": "node scripts/sqlrite-types.mjs --write",
        "types:sqlrite:check": "node scripts/sqlrite-types.mjs",
        "test:lint": "npm run types:sqlrite:check && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "test:unit": "node --conditions=plurnk-dev --import=./test/setup.ts --env-file-if-exists=.env.defaults --test --test-timeout=30000 scripts/*.test.mjs src/**/*.test.ts",
        "test:intg": "export PLURNK_TEST_RUN=$(date -u +%Y%m%dT%H%M%SZ); PLURNK_SERVICE_FILES_ITEMS=0 node --conditions=plurnk-dev --import=./test/setup.ts --env-file-if-exists=.env.defaults --test --test-concurrency=8 --test-timeout=30000 test/intg/*.test.ts && node ../scripts/reclaim-green-run.mjs core",
        "test:mcp:dogfood": "PLURNK_TEST_MCP_DOGFOOD=1 node --conditions=plurnk-dev --import=./test/setup.ts --env-file-if-exists=.env.defaults --test --test-concurrency=1 --test-timeout=120000 test/intg/mcp-agui-composition.test.ts",
        "test:a2a:tck": "node scripts/a2a-tck.mjs",
        "test:live": "bash ../scripts/operator-environment.sh node --conditions=plurnk-dev scripts/live.mjs",
        "test:live:specimen": "bash ../scripts/operator-environment.sh node --conditions=plurnk-dev scripts/live.mjs --specimen",
        "test:live:zeropin": "PLURNK_ZERO_PIN=1 npm run test:live",
        "test:demo": "bash ../scripts/operator-environment.sh node --conditions=plurnk-dev scripts/demo.mjs",
        "test:demo:specimen": "bash ../scripts/operator-environment.sh node --conditions=plurnk-dev scripts/demo.mjs --specimen",
        "test:demo:zeropin": "PLURNK_ZERO_PIN=1 npm run test:demo",
        "test:benchlet": "bash ../scripts/operator-environment.sh node scripts/benchlet.mjs",
        "fixture:demo": "node --conditions=plurnk-dev test/demo/_fixture.ts",
        "test": "npm run test:lint && npm run test:unit && npm run test:intg",
        "digest:missing": "node --conditions=plurnk-dev bin/digest-missing.ts",
        "share": "node --conditions=plurnk-dev src/service.ts share",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build:sql": "node --conditions=plurnk-dev scripts/copy-sql.mjs",
        "build:info": "node scripts/write-build-info.mjs",
        "build": "npm run build:clean && npm run build:dist && npm run build:sql && npm run build:info",
        "build:global:install": "npm run build && npm install -g .",
        "build:global:uninstall": "npm uninstall -g @plurnk/plurnk-service",
        "build:local:install": "node --conditions=plurnk-dev scripts/install-sandbox.mjs install",
        "build:local:uninstall": "node --conditions=plurnk-dev scripts/install-sandbox.mjs uninstall",
        "test:installation": "node --conditions=plurnk-dev scripts/test-installation.mjs",
        "deps:audit": "node --conditions=plurnk-dev scripts/deps-audit.ts",
        "release:check": "npm run deps:audit && npm run test:installation",
        "prepublishOnly": "npm run deps:audit && npm run test:installation",
        "prepack": "npm run build",
        "report:floor": "node --conditions=plurnk-dev --import=./test/setup.ts --env-file-if-exists=.env.defaults scripts/floor-report.mjs"
    },
    "dependencies": {
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/context-async-hooks": "^2.11.0",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
        "@opentelemetry/resources": "^2.11.0",
        "@opentelemetry/sdk-metrics": "^2.11.0",
        "@opentelemetry/sdk-trace-base": "^2.11.0",
        "@plurnk/plurnk-a2a": "2.0.0",
        "@plurnk/plurnk-agui": "2.0.0",
        "@plurnk/plurnk-contracts": "2.0.0",
        "@plurnk/plurnk-parser": "2.0.0",
        "@plurnk/plurnk-schedule": "2.0.0",
        "@plurnk/plurnk-skills": "2.0.0",
        "@plurnk/plurnk-execs": "2.0.0",
        "@plurnk/plurnk-execs-common": "2.0.0",
        "@plurnk/plurnk-execs-jq": "2.0.0",
        "@plurnk/plurnk-execs-sqlite": "2.0.0",
        "@plurnk/plurnk-hooks": "2.0.0",
        "@plurnk/plurnk-mcp": "2.0.0",
        "@plurnk/plurnk-meta": "2.0.0",
        "@plurnk/plurnk-agent-plugins": "2.0.0",
        "@plurnk/plurnk-agent-skills": "2.0.0",
        "@plurnk/plurnk-mimetypes": "2.0.0",
        "@plurnk/plurnk-mimetypes-application-ipynb": "2.0.0",
        "@plurnk/plurnk-mimetypes-application-json": "2.0.0",
        "@plurnk/plurnk-mimetypes-application-jsonl": "2.0.0",
        "@plurnk/plurnk-mimetypes-application-xml": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-bash": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-c": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-cpp": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-css": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-dart": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-elixir": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-go": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-haskell": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-java": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-javascript": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-julia": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-kotlin": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-lua": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-make": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-ocaml": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-odin": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-php": "2.0.0",
