{
    "name": "@plurnk/plurnk-service",
    "version": "1.4.0",
    "description": "Plurnk agent runtime — the server / engine / core. Implements the @plurnk/plurnk-contracts contract.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./digest": {
            "plurnk-dev": "./src/digest/Digest.ts",
            "types": "./dist/digest/Digest.d.ts",
            "default": "./dist/digest/Digest.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "plurnk-service": "dist/service.js"
    },
    "files": [
        ".env.defaults",
        "dist/**/*",
        "migrations/**/*.sql",
        "README.md",
        "INSTALL.md",
        "SPEC.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "start": "node --conditions=plurnk-dev src/service.ts",
        "types:sqlrite": "node scripts/sqlrite-types.mjs --write",
        "test:sqlrite-types": "node scripts/sqlrite-types.mjs",
        "test:artifacts:begin": "node ../scripts/test-artifacts.mjs begin",
        "pretest:intg": "npm run test:artifacts:begin",
        "test:lint": "npm run test:sqlrite-types && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "test:unit": "node --conditions=plurnk-dev --import=./test/setup.ts --env-file-if-exists=.env.defaults --test --test-timeout=30000 src/**/*.test.ts",
        "test:intg": "PLURNK_SERVICE_FILES_ITEMS=0 node --conditions=plurnk-dev --import=./test/setup.ts --env-file-if-exists=.env.defaults --test --test-concurrency=8 --test-timeout=30000 test/intg/*.test.ts",
        "test:live": "PLURNK_SERVICE_POLICY=../plurnk-meta/PLURNK_PERSONALITY.md node --conditions=plurnk-dev --import=./test/floor.ts --env-file-if-exists=.env.defaults --env-file-if-exists=$HOME/.plurnk/.env --env-file-if-exists=.env --env-file-if-exists=.env.test --test --test-concurrency=1 test/live/*.test.ts",
        "test:live:specimen": "node --conditions=plurnk-dev bin/live-specimen.ts",
        "test:live:zeropin": "PLURNK_ZERO_PIN=1 PLURNK_SERVICE_POLICY=../plurnk-meta/PLURNK_PERSONALITY.md node --conditions=plurnk-dev --import=./test/floor.ts --env-file-if-exists=.env.defaults --env-file-if-exists=$HOME/.plurnk/.env --env-file-if-exists=.env --env-file-if-exists=.env.test --test --test-concurrency=1 test/live/*.test.ts",
        "test:demo": "PLURNK_SERVICE_POLICY=../plurnk-meta/PLURNK_PERSONALITY.md node --conditions=plurnk-dev --import=./test/floor.ts --env-file-if-exists=.env.defaults --env-file-if-exists=$HOME/.plurnk/.env --env-file-if-exists=.env --env-file-if-exists=.env.test --test --test-concurrency=1 test/demo/*.test.ts",
        "test:demo:zeropin": "PLURNK_ZERO_PIN=1 PLURNK_SERVICE_POLICY=../plurnk-meta/PLURNK_PERSONALITY.md node --conditions=plurnk-dev --import=./test/floor.ts --env-file-if-exists=.env.defaults --env-file-if-exists=$HOME/.plurnk/.env --env-file-if-exists=.env --env-file-if-exists=.env.test --test --test-concurrency=1 test/demo/*.test.ts",
        "fixture:demo": "node --conditions=plurnk-dev test/demo/_fixture.ts",
        "test:all": "npm run test:lint && npm run test:unit && npm run test:intg && npm run test:demo",
        "test:digest": "node --conditions=plurnk-dev bin/digest.ts",
        "digest:missing": "node --conditions=plurnk-dev bin/digest-missing.ts",
        "test:clean-tmp": "node ../scripts/test-artifacts.mjs clean",
        "dev:digest": "node --conditions=plurnk-dev bin/digest.ts",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build:sql": "node --conditions=plurnk-dev scripts/copy-sql.mjs",
        "build:info": "node scripts/write-build-info.mjs",
        "build": "npm run build:clean && npm run build:dist && npm run build:sql && npm run build:info",
        "build:global:install": "npm run build && npm install -g .",
        "build:global:uninstall": "npm uninstall -g @plurnk/plurnk-service",
        "build:local:install": "node --conditions=plurnk-dev scripts/install-sandbox.mjs install",
        "build:local:uninstall": "node --conditions=plurnk-dev scripts/install-sandbox.mjs uninstall",
        "test:installation": "node --conditions=plurnk-dev scripts/test-installation.mjs",
        "deps:audit": "node --conditions=plurnk-dev scripts/deps-audit.ts",
        "prepublishOnly": "npm run deps:audit && npm run test:installation",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
        "@opentelemetry/sdk-metrics": "^2.10.0",
        "@opentelemetry/sdk-node": "^0.221.0",
        "@opentelemetry/sdk-trace-base": "^2.10.0",
        "@plurnk/gbnf": "1.4.0",
        "@plurnk/plurnk-agui": "1.4.0",
        "@plurnk/plurnk-contracts": "1.4.0",
        "@plurnk/plurnk-execs": "1.4.0",
        "@plurnk/plurnk-execs-common": "1.4.0",
        "@plurnk/plurnk-execs-git": "1.4.0",
        "@plurnk/plurnk-execs-jq": "1.4.0",
        "@plurnk/plurnk-execs-search": "1.4.0",
        "@plurnk/plurnk-execs-sqlite": "1.4.0",
        "@plurnk/plurnk-execs-wasm": "1.4.0",
        "@plurnk/plurnk-mcp": "1.4.0",
        "@plurnk/plurnk-meta": "1.4.0",
        "@plurnk/plurnk-mimetypes": "1.4.0",
        "@plurnk/plurnk-mimetypes-application-ipynb": "1.4.0",
        "@plurnk/plurnk-mimetypes-application-json": "1.4.0",
        "@plurnk/plurnk-mimetypes-application-jsonl": "1.4.0",
        "@plurnk/plurnk-mimetypes-application-pdf": "1.4.0",
        "@plurnk/plurnk-mimetypes-application-xml": "1.4.0",
        "@plurnk/plurnk-mimetypes-embeddings": "1.4.0",
        "@plurnk/plurnk-mimetypes-text-csv": "1.4.0",
        "@plurnk/plurnk-mimetypes-text-diff": "1.4.0",
        "@plurnk/plurnk-mimetypes-text-dotenv": "1.4.0",
        "@plurnk/plurnk-mimetypes-text-html": "1.4.0",
        "@plurnk/plurnk-mimetypes-text-ini": "1.4.0",
        "@plurnk/plurnk-mimetypes-text-markdown": "1.4.0",
        "@plurnk/plurnk-mimetypes-text-plain": "1.4.0",
        "@plurnk/plurnk-mimetypes-tokenizers": "1.4.0",
        "@plurnk/plurnk-models": "1.4.0",
        "@plurnk/plurnk-providers": "1.4.0",
        "@plurnk/plurnk-schemes": "1.4.0",
        "@plurnk/plurnk-schemes-http": "1.4.0",
        "@possumtech/sqlrite": "^6.5.2",
        "diff": "^9.0.0",
        "ignore": "7.0.6",
        "isomorphic-git": "1.40.0"
    },
    "devDependencies": {
        "@opentelemetry/context-async-hooks": "^2.10.0",
        "@opentelemetry/core": "^2.10.0",
        "@types/diff": "^7.0.2"
    },
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-core#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-core"
    }
}
