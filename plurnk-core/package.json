{
    "name": "@plurnk/plurnk-service",
    "version": "4.3.3",
    "description": "Plurnk agent runtime — the server / engine / core. Implements the @plurnk/plurnk-contracts contract.",
    "keywords": [
        "plurnk",
        "agent",
        "llm",
        "daemon",
        "acp",
        "sqlite",
        "harness"
    ],
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "exports": {
        "./launch": {
            "plurnk-dev": "./src/launch/Launch.ts",
            "types": "./dist/launch/Launch.d.ts",
            "default": "./dist/launch/Launch.js"
        },
        "./package.json": "./package.json",
        "./evidence": {
            "plurnk-dev": "./src/evidence/EvidenceReader.ts",
            "types": "./dist/evidence/EvidenceReader.d.ts",
            "default": "./dist/evidence/EvidenceReader.js"
        }
    },
    "bin": {
        "plurnk-service": "dist/service.js"
    },
    "man": "./dist/man/plurnk-service.1",
    "files": [
        ".env.defaults",
        "dist/**/*",
        "docs/**/*",
        "migrations/**/*.sql",
        "README.md",
        "INSTALL.md",
        "plurnk.service",
        "plurnk.nginx.conf",
        "SPEC.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "start": "node --conditions=plurnk-dev src/service.ts",
        "types:sqlrite:write": "node scripts/sqlrite-types.mjs --write",
        "types:sqlrite:check": "node scripts/sqlrite-types.mjs",
        "test:lint": "npm run types:sqlrite:check && tsc --noEmit && tsc --noEmit -p test",
        "test:unit": "node --conditions=plurnk-dev --import=./test/setup.ts --env-file-if-exists=.env.defaults --experimental-test-coverage --test-coverage-include-all '--test-coverage-include=src/**' --test ${PLURNK_TEST_CONCURRENCY:+--test-concurrency=$PLURNK_TEST_CONCURRENCY} --test-timeout=30000 scripts/*.test.mjs 'src/**/*.test.ts'",
        "test:intg": "export PLURNK_TEST_RUN=$(date -u +%Y%m%dT%H%M%SZ); PLURNK_SERVICE_FILES_ITEMS=0 node --conditions=plurnk-dev --import=./test/setup.ts --env-file-if-exists=.env.defaults --experimental-test-coverage --test-coverage-include-all '--test-coverage-include=src/**' --test ${PLURNK_TEST_CONCURRENCY:+--test-concurrency=$PLURNK_TEST_CONCURRENCY} --test-timeout=30000 test/intg/*.test.ts && node ../scripts/reclaim-green-run.mjs core",
        "test:live": "bash ../scripts/operator-environment.sh node --conditions=plurnk-dev scripts/live.mjs",
        "test:benchlet": "bash ../scripts/operator-environment.sh node scripts/benchlet.mjs",
        "test": "npm run test:lint && npm run test:unit && npm run test:intg",
        "digest:missing": "node --conditions=plurnk-dev bin/digest-missing.ts",
        "share": "node --conditions=plurnk-dev src/service.ts share",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build:sql": "node --conditions=plurnk-dev scripts/copy-sql.mjs",
        "build:info": "node scripts/write-build-info.mjs",
        "build:posix": "node --conditions=plurnk-dev scripts/generate-posix.mjs",
        "build": "npm run build:clean && npm run types:sqlrite:write && npm run build:dist && npm run build:sql && npm run build:info && npm run build:posix",
        "install:global": "npm run build && npm install -g .",
        "uninstall:global": "npm uninstall -g @plurnk/plurnk-service",
        "install:sandbox": "node --conditions=plurnk-dev scripts/install-sandbox.mjs install",
        "uninstall:sandbox": "node --conditions=plurnk-dev scripts/install-sandbox.mjs uninstall",
        "test:installation": "node scripts/test-installation.mjs",
        "audit:deps": "node --conditions=plurnk-dev scripts/deps-audit.ts",
        "release:check": "npm run audit:deps && npm run test:installation",
        "prepublishOnly": "npm run audit:deps && npm run test:installation",
        "prepack": "npm run build",
        "report:floor": "node --conditions=plurnk-dev --import=./test/setup.ts --env-file-if-exists=.env.defaults scripts/floor-report.mjs",
        "report:sql": "node --conditions=plurnk-dev scripts/sql-report.mjs"
    },
    "dependencies": {
        "@opentelemetry/api": "^1.10.0",
        "@plurnk/plurnk-acp": "1.0.0",
        "@plurnk/plurnk-auth": "1.0.0",
        "@plurnk/plurnk-contracts": "6.0.1",
        "@plurnk/plurnk-parser": "4.2.2",
        "@plurnk/plurnk-schedule": "3.0.5",
        "@plurnk/plurnk-skills": "3.0.4",
        "@plurnk/plurnk-execs": "4.0.3",
        "@plurnk/plurnk-execs-common": "3.0.1",
        "@plurnk/plurnk-hooks": "2.0.4",
        "@plurnk/plurnk-mcp": "3.3.1",
        "@plurnk/plurnk-meta": "2.1.2",
        "@plurnk/plurnk-agent-plugins": "2.0.0",
        "@plurnk/plurnk-agent-skills": "2.0.4",
        "@plurnk/plurnk-mimetypes": "3.0.6",
        "@plurnk/plurnk-mimetypes-application-ipynb": "2.0.3",
        "@plurnk/plurnk-mimetypes-application-json": "2.0.2",
        "@plurnk/plurnk-mimetypes-application-jsonl": "2.0.2",
        "@plurnk/plurnk-mimetypes-application-xml": "2.0.3",
        "@plurnk/plurnk-mimetypes-grammar-bash": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-c": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-cpp": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-css": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-dart": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-elixir": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-go": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-haskell": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-java": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-javascript": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-julia": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-kotlin": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-lua": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-make": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-ocaml": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-odin": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-php": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-python": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-ruby": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-rust": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-scala": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-toml": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-tsx": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-typescript": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-yaml": "2.0.0",
        "@plurnk/plurnk-mimetypes-grammar-zig": "2.0.0",
        "@plurnk/plurnk-mimetypes-application-pdf": "2.0.2",
        "@plurnk/plurnk-mimetypes-image": "2.0.2",
        "@plurnk/plurnk-mimetypes-audio": "2.0.4",
        "@plurnk/plurnk-mimetypes-text-csv": "2.0.2",
        "@plurnk/plurnk-mimetypes-text-diff": "2.0.2",
        "@plurnk/plurnk-mimetypes-text-dotenv": "2.0.2",
        "@plurnk/plurnk-mimetypes-text-html": "2.0.4",
        "@plurnk/plurnk-mimetypes-text-ini": "2.0.2",
        "@plurnk/plurnk-mimetypes-text-markdown": "2.0.3",
        "@plurnk/plurnk-mimetypes-text-plain": "2.0.2",
        "@plurnk/plurnk-models": "3.0.3",
        "@plurnk/plurnk-modules": "4.1.0",
        "@plurnk/plurnk-providers": "5.0.2",
        "@plurnk/plurnk-schemes": "3.3.0",
        "@plurnk/plurnk-schemes-http": "2.0.5",
        "@possumtech/sqlrite": "^6.6.1",
        "diff": "^9.0.0",
        "glob": "^14.0.3",
        "minimatch": "^11.0.3",
        "@plurnk/plurnk-digest": "3.2.3",
        "@plurnk/plurnk-otel": "1.0.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/server": "2.4.0",
        "@opentelemetry/sdk-trace": "^3.0.0",
        "marked": "^18.1.2",
        "zod": "4.6.7"
    },
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-core#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-core"
    }
}
