{
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": false,
        "allowJs": true,
        "types": [
            "node"
        ],
        "lib": [
            "ES2024"
        ],
        "customConditions": [
            "plurnk-dev"
        ],
        "paths": {
            "@possumtech/sqlrite": [
                "./SqlRite.d.ts"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "bin/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "migrations/generated"
    ]
}
