{
    "name": "@plurnk/plurnk-execs-wasm",
    "version": "1.6.1",
    "description": "WebAssembly runtime executor for plurnk-service's exec scheme — in-process sandboxed execution of WAT (text) and wasm (binary) modules.",
    "keywords": [
        "plurnk",
        "exec",
        "runtime",
        "executor",
        "webassembly",
        "wasm",
        "wat",
        "sandbox"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-execs-wasm#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-execs-wasm"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "plurnk": {
        "kind": "exec",
        "runtimes": [
            {
                "name": "wat",
                "glyph": "🧩",
                "invocation": {
                    "body": {
                        "role": "inline WAT module",
                        "required": false
                    },
                    "target": {
                        "role": "WAT module",
                        "required": false,
                        "kind": "resource"
                    },
                    "exclusive": true,
                    "example": {
                        "body": "(module)"
                    }
                }
            },
            {
                "name": "wasm",
                "glyph": "🧩",
                "invocation": {
                    "body": {
                        "role": "inline base64 WASM module",
                        "required": false
                    },
                    "target": {
                        "role": "WASM module",
                        "required": false,
                        "kind": "resource"
                    },
                    "exclusive": true,
                    "example": {
                        "target": "module.wasm"
                    }
                }
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --env-file-if-exists=../plurnk-execs/.env.defaults --test \"src/**/*.test.ts\"",
        "test": "npm run test:lint && npm run test:unit",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepack": "npm run build",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test"
    },
    "dependencies": {
        "wabt": "^1.0.39"
    },
    "peerDependencies": {
        "@plurnk/plurnk-execs": "^1.6.1"
    }
}
