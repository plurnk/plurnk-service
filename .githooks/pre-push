#!/bin/sh
# The gate: branch-name policy on EVERY push; the drill (lint+unit full; intg
# scoped to the changed workspaces, full on a root-level change) on pushes to MAIN
# ONLY — main is what ships and what every lane builds on. Never GitHub CI
# (POSSUMTECH.md §Forge responsibilities).
# Branches are main or type/kebab-slug; tags pass. Deletions are exempt from both
# the name policy and the drill — a deletion pushes no code to gate and removes a
# ref rather than naming one (so a mis-named branch can always be deleted).
remote_name="$1"
zero=0000000000000000000000000000000000000000
any_update=0
ref_count=0
gate_base=
gates_main=0
while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    node scripts/commit-provenance.mjs "$remote_name" "$local_sha" "$remote_sha" || exit 1
    any_update=1
    ref_count=$((ref_count + 1))
    [ "$remote_sha" != "$zero" ] && gate_base="$remote_sha"
    case "$remote_ref" in
        refs/heads/main) gates_main=1 ;;
        refs/tags/*) : ;;
        refs/heads/*)
            branch="${remote_ref#refs/heads/}"
            node scripts/conventional.mjs branch "$branch" || exit 1
            ;;
    esac
done
[ "$any_update" = 0 ] && exit 0

# The drill gates MAIN only. A push that touches no main ref (feature/preview/WIP,
# already name-policed above) pushes free — its red can't reach main, because main
# is only ever updated by a push to main, which IS gated. Healthy branch workflows
# unblocked; main's protection unchanged.
[ "$gates_main" = 1 ] || exit 0

# Worktree isolation at the push boundary: hand drill the remote base sha so intg
# scopes to the changed workspaces. Single-ref, non-new pushes only — a multi-ref
# or new-branch push has no single base and runs the full intg (safe default).
[ "$ref_count" = 1 ] && [ -n "$gate_base" ] && export PLURNK_GATE_BASE="$gate_base"

# Git exports its hook environment (GIT_DIR = <main>/.git/worktrees/<wt> when pushing
# from a linked worktree). A gate test that runs `git init <tmpdir>` under it re-initializes
# the MAIN repository as bare (#402). The drill discovers the repository from cwd.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

exec npm test
