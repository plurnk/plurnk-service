{
    "name": "@plurnk/plurnk-models",
    "version": "1.13.0",
    "description": "Release-time snapshot of Models.dev provider and model metadata for PLURNK.",
    "keywords": [
        "plurnk",
        "llm",
        "models",
        "pricing",
        "context-window",
        "catalog"
    ],
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-models#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-models"
    },
    "engines": {
        "node": ">=26"
    },
    "license": "MIT",
    "author": "@wikitopian",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "generate": "node --conditions=plurnk-dev src/generate.mjs",
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json && node --conditions=plurnk-dev -e \"const fs=require('node:fs'); for (const name of ['catalog.json','providers.json']) fs.copyFileSync('src/'+name,'dist/'+name)\"",
        "build": "npm run build:clean && npm run build:dist",
        "prepack": "npm run build"
    }
}
