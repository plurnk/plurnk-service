{
    "name": "@plurnk/plurnk-mimetypes-application-xml",
    "version": "0.1.2",
    "description": "application/xml and text/xml mimetype handler for plurnk-service. DOM-tree extraction via @xmldom/xmldom; xpath via the xpath package; deep-json projection per framework #10.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "plurnk": {
        "kind": "mimetype",
        "handlers": [
            {
                "name": "application/xml",
                "glyph": "📐",
                "extensions": [
                    ".xml"
                ]
            },
            {
                "name": "text/xml",
                "glyph": "📐",
                "extensions": []
            }
        ]
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "prepare": "npm run build"
    },
    "dependencies": {
        "@xmldom/xmldom": "^0.9.10",
        "xpath": "^0.0.34"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "typescript": "^6.0.3",
        "@plurnk/plurnk-mimetypes": "^0.15.0"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^0.15.0"
    }
}
