# @plurnk/plurnk-auth — optional external OIDC / OAuth 2.1 resource server ({§auth-oauth}).

# External OIDC / OAuth 2.1 issuer URL ({§auth-oauth}, {§auth-configuration}).
# Empty = disabled (zero mounts, no bearer requirement). Set to an https:// issuer URL
# (or loopback http://127.0.0.1 / http://localhost / http://[::1] for local testing) to
# verify presented JWTs against the issuer's JWKS and advertise RFC 9728 metadata.
PLURNK_AUTH_ISSUER=
# Public OIDC / OAuth 2.1 client identifier advertised to browser and CLI PKCE clients
# and used as the default JWT audience when PLURNK_AUTH_AUDIENCE is empty ({§auth-configuration}).
PLURNK_AUTH_CLIENT_ID=
# Expected JWT `aud` claim ({§auth-configuration}). Empty falls back to PLURNK_AUTH_CLIENT_ID;
# when both are empty, any valid token signed by PLURNK_AUTH_ISSUER is accepted without audience restriction.
PLURNK_AUTH_AUDIENCE=
# Browser OIDC PKCE callback URL hint advertised in `/.well-known/oauth-protected-resource`
# ({§auth-configuration}). Empty defaults to `<resource-origin>/auth/callback`.
PLURNK_AUTH_CALLBACK=
# Space- or comma-separated scopes advertised in `/.well-known/oauth-protected-resource` ({§auth-configuration}).
PLURNK_AUTH_SCOPES="openid profile email"
# Comma-separated allowlist of admitted `sub` identifiers or verified `email` addresses
# (`email_verified === true`) ({§auth-configuration}). Empty admits every user authenticated by PLURNK_AUTH_ISSUER.
PLURNK_AUTH_USERS=
# Comma-separated allowlist of JWT `sub` identifiers authorized to attribute exterior speakers
# (`_meta.plurnk.actor`) across authenticated bridges ({§auth-configuration}). Empty disables delegation.
PLURNK_AUTH_DELEGATES=
# Access-Control-Allow-Origin value on `/.well-known/oauth-protected-resource` ({§auth-oauth}).
# Empty omits CORS headers; `*` allows any browser origin to read public discovery metadata.
PLURNK_AUTH_ALLOW_ORIGIN=*
