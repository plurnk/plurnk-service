# @plurnk/plurnk-auth — the daemon's OAuth 2.1 authorization server ({§auth-oauth}).
# PLURNK_HOST, PLURNK_PORT, PLURNK_AUTH, PLURNK_SECRET and PLURNK_PASS live in @plurnk/plurnk-contracts.

# Public http(s) origin of the authorization server and protected resource behind a proxy
# ({§auth-oauth}). Empty = the address each request reached this daemon at, so a daemon on
# 0.0.0.0 answers 127.0.0.1 at 127.0.0.1 and a LAN browser at the LAN address it dialed; set this
# only when a proxy (nginx, a tunnel) terminates TLS in front of the daemon.
PLURNK_AUTH_ISSUER=
# Credential lifetimes ({§auth-oauth-tokens}), seconds. An access token is presented as the bearer and
# expires on its own; a refresh token is exchanged once and rotated.
PLURNK_AUTH_ACCESS_TTL_SEC=3600
PLURNK_AUTH_REFRESH_TTL_SEC=2592000
# Confidential clients beyond the operator's own, one line each ({§auth-oauth-clients}):
# PLURNK_AUTH_CLIENT_<id>={"secret":"<its secret>","scopes":["acp"]}. Each holds its own
# secret and scopes and can be revoked without touching the operator's credentials.

# Access-Control-Allow-Origin value on authorization endpoints ({§auth-oauth}).
PLURNK_AUTH_ALLOW_ORIGIN=*
