# Enable declared personas by default; per-alias _ENABLED overrides this.
PLURNK_PERSONAS_ENABLED=1
# Allow workspace persona definitions and discovery to read local filesystem `source` paths (`1` = allowed, `0` = inline only; operator `PLURNK_PERSONAS_<alias>` and configured roots are unaffected).
PLURNK_PERSONAS_ALLOW_LOCAL_SOURCES=1
# Personas: complete definitions ({"source":"..."} or {"description":"...","body":"..."}), with independent enabledness.
# `_` in a key represents `-`; Unicode names work in .env or via `env 'KEY=value' command`.
# PLURNK_PERSONAS_reviewer={"source":"/srv/personas/reviewer"}
# PLURNK_PERSONAS_reviewer_ENABLED=0
# Any persona alias: its definition, and its own _ENABLED control.
# PLURNK_PERSONAS_<alias>=<definition>
