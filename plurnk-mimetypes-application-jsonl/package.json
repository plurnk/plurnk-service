{
    "name": "@plurnk/plurnk-mimetypes-application-jsonl",
    "version": "1.26.0",
    "description": "JSON Lines / NDJSON handler with record-schema symbols and exact source-located queries.",
    "keywords": [
        "plurnk",
        "mimetype",
        "jsonl",
        "ndjson"
    ],
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "plurnk": {
        "kind": "mimetype",
        "handlers": [
            {
                "name": "application/jsonl",
                "revision": "2",
                "glyph": "🧾",
                "extensions": [
                    ".jsonl",
                    ".ndjson"
                ]
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:clean": "rm -rf dist",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:clean && npm run build:dist",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^1.26.0"
    },
    "dependencies": {
        "@plurnk/plurnk-mimetypes-application-json": "1.26.0",
        "jsonc-parser": "^3.3.1"
    },
    "homepage": "https://github.com/plurnk/plurnk-service/tree/main/plurnk-mimetypes-application-jsonl#readme",
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-service.git",
        "directory": "plurnk-mimetypes-application-jsonl"
    }
}
