{
    "name": "@plurnk/plurnk-mimetypes-application-jsonl",
    "version": "1.3.3",
    "description": "application/jsonl (JSON Lines / NDJSON) mimetype handler for plurnk-service. Record-schema symbols, records array as deepJson. Hand-rolled, no parser dependency.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "plurnk": {
        "kind": "mimetype",
        "handlers": [
            {
                "name": "application/jsonl",
                "glyph": "🧾",
                "extensions": [
                    ".jsonl",
                    ".ndjson"
                ]
            }
        ]
    },
    "exports": {
        ".": {
            "plurnk-dev": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --conditions=plurnk-dev --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "prepublishOnly": "npm audit --audit-level=moderate && npm test",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^1.3.3"
    }
}
