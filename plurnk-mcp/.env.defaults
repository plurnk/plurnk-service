# @plurnk/plurnk-mcp — MCP servers come from installed Agent Plugins: a plugin's mcp.json declares
# them, and installing the plugin enables them. The environment holds only these controls and each
# server alias's operator settings (the alias uppercased, its hyphens as underscores).

# Connection deadline and complete catalog/list-walk deadline, positive ms each.
PLURNK_MCP_CONNECT_TIMEOUT=30000
# Whole-operation deadline including client input, positive ms; caller cancellation still applies.
PLURNK_MCP_REQUEST_TIMEOUT=86400000
# First delay before the adapter retries a dropped subscription or a failed catalog refresh, positive ms; it doubles per attempt.
PLURNK_MCP_RETRY_FLOOR_MS=250
# Ceiling of that doubling delay, positive ms, at least the floor.
PLURNK_MCP_RETRY_CEILING_MS=5000
# The MCP Registry `mcp (discover)` searches: https, or http on a loopback host; empty turns registry search off.
PLURNK_MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io
# Most servers one registry search returns, positive.
PLURNK_MCP_REGISTRY_LIMIT=20
# Expand these servers' tool lists in turn 0, JSON array of aliases; otherwise one row per server.
# PLURNK_MCP_EXPANDED=[]

# --- Per-server operator settings ---
# Tool allowlist, JSON array; absent enables every tool the server lists, [] none.
# PLURNK_MCP_FORGE_TOOLS=["issue_read","issue_search"]
# A fixed bearer for a Streamable HTTP server: one ${NAME} reference, so the token stays in the environment.
# PLURNK_MCP_FORGE_BEARER=${FORGE_TOKEN}
# Client-managed OAuth for a Streamable HTTP server, McpOAuth JSON; secrets are ${NAME} references.
# PLURNK_MCP_FORGE_OAUTH={"type":"oauth","redirectUrl":"http://127.0.0.1:8765/callback"}
