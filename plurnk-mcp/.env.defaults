# @plurnk/plurnk-mcp — Worker MCP attachments.
# Alias blocks make servers available; ENABLED selects initial attachments.
# A Worker can add/enable/disable/remove attachments through its Functionality controls.

# Connection and protocol-discovery deadline, positive ms.
PLURNK_MCP_CONNECT_TIMEOUT=30000
# Individual operation deadline, positive ms; caller cancellation still applies.
PLURNK_MCP_REQUEST_TIMEOUT=86400000
# Initially enabled aliases, JSON array; [] = none.
PLURNK_MCP_ENABLED=[]
# Expand these servers' tool lists in turn 0; otherwise show one row per server.
# PLURNK_MCP_EXPANDED=[]

# --- HTTP target ---
# URL, optional bearer reference, optional headers (string-valued JSON object).
# PLURNK_MCP_forge=https://example.test/mcp
# PLURNK_MCP_forge_BEARER=${FORGE_TOKEN}
# PLURNK_MCP_forge_HEADERS={"X-Tenant":"${FORGE_TENANT}"}

# --- stdio target ---
# One exact executable (not a shell command); ARGS is a literal JSON array.
# CWD is optional; ENV overlays the subprocess environment, resolving ${NAME} references.
# PLURNK_MCP_browser=node
# PLURNK_MCP_browser_ARGS=["/absolute/path/to/browser-server.mjs"]
# PLURNK_MCP_browser_CWD=/absolute/working/directory
# PLURNK_MCP_browser_ENV={"TOKEN":"${BROWSER_TOKEN}"}

# --- Tool admission and orientation ---
# Optional tool allowlist; omitted = all server tools. READ marks tools as read-only for admission.
# PLURNK_MCP_forge_TOOLS=["issue_read","issue_search"]
# PLURNK_MCP_forge_READ=["issue_read","issue_search"]
# Summary fallbacks when server metadata is inadequate; per-server or per-tool.
# PLURNK_MCP_forge_SUMMARY=```forge (issue_read) <!-- Read forge issues -->```
# PLURNK_MCP_forge_issue_read_SUMMARY=Read one issue.

# --- Optional Brave Search ---
# PLURNK_MCP_brave=npx
# PLURNK_MCP_brave_ARGS=["-y","@brave/brave-search-mcp-server@2.1.0"]
# PLURNK_MCP_brave_ENV={"BRAVE_API_KEY":"${BRAVE_API_KEY}"}
# PLURNK_MCP_brave_TOOLS=["brave_web_search","brave_news_search"]
# PLURNK_MCP_brave_READ=["brave_web_search","brave_news_search"]
# PLURNK_MCP_ENABLED=["brave"]
