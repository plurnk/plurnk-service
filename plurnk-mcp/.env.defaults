# --- @plurnk/plurnk-mcp : current MCP host module ---

# Bound only connection and protocol discovery. Individual MCP operations use
# the request timeout below and remain cancellable through their Plurnk run.
PLURNK_MCP_CONNECT_TIMEOUT=30000
PLURNK_MCP_REQUEST_TIMEOUT=86400000

# Configured servers are available to clients. Only this exact JSON-array
# subset connects and becomes model-visible by default; workspaces may override it.
PLURNK_MCP_ENABLED=[]

# Each configured server contributes its enabled `[server] (tool)` rows and server:// resources.
#
# Streamable HTTP:
# PLURNK_MCP_github=https://example.test/mcp
# PLURNK_MCP_github_BEARER=${GITHUB_TOKEN}
# PLURNK_MCP_github_TOOLS=["issue_read","issue_search"]
# PLURNK_MCP_github_READ=["issue_read","issue_search"]
#
# stdio: the target is one exact executable path/name, including whitespace.
# Arguments are a JSON array so Plurnk does not invent or interpret a shell.
# PLURNK_MCP_atlas=node
# PLURNK_MCP_atlas_ARGS=["/absolute/path/to/atlas-server.mjs"]
# PLURNK_MCP_atlas_CWD=/absolute/working/directory
# PLURNK_MCP_atlas_ENV={"TOKEN":"${ATLAS_TOKEN}"}
#
# npx (installed-on-demand executables) — the documented Brave Search fixture,
# demo-tier only; credentials stay one ${NAME} reference in the operator env:
# PLURNK_MCP_BRAVE=npx
# PLURNK_MCP_BRAVE_ARGS=["-y","@brave/brave-search-mcp-server@2.1.0"]
# PLURNK_MCP_BRAVE_ENV={"BRAVE_API_KEY":"${BRAVE_API_KEY}"}
# PLURNK_MCP_BRAVE_TOOLS=["brave_web_search","brave_news_search"]
# PLURNK_MCP_BRAVE_READ=["brave_web_search","brave_news_search"]
#
# Then list it above to make it model-visible, e.g. PLURNK_MCP_ENABLED=["brave"].
