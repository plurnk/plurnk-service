# @plurnk/plurnk-mcp — complete server definitions and independent behavior controls.
# Lowercase aliases; underscores represent hyphens. Declared servers default enabled.
# Files: project .agents/mcp.json > XDG plurnk/mcp.json > ~/.agents/mcp.json.
# Environment definitions override files whole; these controls apply to every source.
PLURNK_MCP_ENABLED=1
# PLURNK_MCP_code_search={"type":"stdio","command":"npx","args":["-y","example-mcp-server@1.0.0"]}
# PLURNK_MCP_code_search_ENABLED=0
# HTTP authentication belongs to the whole definition; secrets remain environment references.
# PLURNK_MCP_forge={"type":"streamable-http","url":"https://forge.example/mcp","authorization":{"type":"bearer","token":"${FORGE_TOKEN}"}}
# Any alias: its definition, and its own _ENABLED and _TOOLS controls.
# PLURNK_MCP_<alias>=<definition>

# Connection deadline and complete catalog/list-walk deadline, positive ms each.
PLURNK_MCP_CONNECT_TIMEOUT_MS=30000
# Whole-operation deadline including client input, positive ms; caller cancellation still applies.
PLURNK_MCP_REQUEST_TIMEOUT_MS=86400000
# First delay before the adapter retries a dropped subscription or a failed catalog refresh, positive ms; it doubles per attempt.
PLURNK_MCP_RETRY_FLOOR_MS=250
# Ceiling of that doubling delay, positive ms, at least the floor.
PLURNK_MCP_RETRY_CEILING_MS=5000
# The HTTP(S) MCP Registry `mcp` `{"discover": "..."}` searches; empty, the mcp family has no discover.
PLURNK_MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io
# Most servers one registry search returns, positive.
PLURNK_MCP_REGISTRY_LIMIT=20
# The other origin whose pages a browser lets read replies on /mcp (CORS): * = any page; one
# origin = that page only; empty = no CORS headers, so no page of another origin reads a reply
# (a page this daemon serves reads its own). The bearer, not this, is the perimeter.
PLURNK_MCP_ALLOW_ORIGIN=*
# Workspace MCP transports admitted for non-operator definitions ({§mcp-configuration}):
# comma-separated subset of stdio, streamable-http; empty forbids all workspace MCP additions.
# Operator definitions (PLURNK_MCP_<alias> and XDG/global mcp.json) remain exempt.
PLURNK_MCP_WORKSPACE_TRANSPORTS=stdio,streamable-http
# Public-address SSRF guard for non-operator HTTP MCP endpoints and OAuth hops ({§mcp-configuration}):
# 0 = allow loopback/private/link-local targets (default); 1 = refuse non-public URLs (403).
PLURNK_MCP_PUBLIC_ONLY=0

# --- Per-server operator settings ---
# Tool allowlist, JSON array; absent enables every tool the server lists, [] none.
# PLURNK_MCP_forge_TOOLS=["issue_read","issue_search"]
