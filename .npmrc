# Peer packages materialize only where the composition explicitly owns them.
# This keeps unused optional native bindings out while root dev dependencies
# provide every peer required by the complete development graph.
omit=peer
# npm's advisory endpoint drops over-limit requests instead of answering 429, and retries and
# probes only feed the limit; every install therefore skips the audit (release qualification
# audits the installed composition itself).
audit=false
