# The tree-sitter WASM grammars (tree-sitter-*, @tree-sitter-grammars/*) declare
# the NATIVE `tree-sitter` binding as a peerOptional, and disagree on its version
# (tree-sitter-go wants ^0.25, others ^0.21). We never use the native binding —
# the framework loads each grammar's `.wasm` through web-tree-sitter. legacy peer
# resolution lets the full grammar set install without that unused, conflicting
# native peer. @plurnk ecosystem coherence is held by the EXACT pins in
# package.json, not by install-time peer enforcement.
legacy-peer-deps=true
