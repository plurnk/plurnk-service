# @plurnk ecosystem coherence is held by the EXACT pins in package.json, not by
# install-time peer enforcement: sibling peerDependency ranges lag the actual
# compatible set (e.g. plurnk-schemes@0.18.0 peers plurnk-grammar below 0.62.0,
# while the coherent ecosystem tip IS 0.62.0). legacy peer resolution lets the
# exact-pinned set install. Drop this only once the sibling peer ranges catch up.
#
# (The former tree-sitter-native-peer justification is RETIRED as of
# mimetypes-all 0.5.0 — it deps self-contained .wasm grammar-* packages with no
# native `tree-sitter` binding peer, so that conflict no longer exists; #34.)
legacy-peer-deps=true
