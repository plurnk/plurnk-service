{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreDependencies": ["jscpd", "@arethetypeswrong/cli", "@modelcontextprotocol/conformance"],
    "ignoreBinaries": ["getent", "pgrep", "pkill"],
    "workspaces": {
        ".": {
            "entry": ["scripts/**/*.{mjs,ts}", "test/**/*.ts"],
            "project": ["scripts/**/*.{mjs,ts}", "test/**/*.ts"]
        },
        "plurnk-*": {
            "entry": ["src/**/*.test.ts", "test/**/*.ts", "scripts/**/*.{mjs,ts}"],
            "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.{mjs,ts}"]
        },
        "plurnk-acp": {
            "entry": ["src/**/*.test.ts", "test/**/*.ts", "scripts/**/*.{mjs,ts}"],
            "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.{mjs,ts}"],
            "ignoreDependencies": ["@plurnk/plurnk-providers"]
        },
        "plurnk-core": {
            "entry": ["src/core/content_weight.ts", "src/core/sha256.ts", "src/**/*.test.ts", "test/**/*.ts", "scripts/**/*.{mjs,ts}"],
            "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.{mjs,ts}"],
            "ignoreDependencies": ["@plurnk/plurnk-schemes-*", "@plurnk/plurnk-execs-*", "@plurnk/plurnk-mimetypes-*", "@plurnk/plurnk-providers-*", "@plurnk/plurnk-hooks", "@plurnk/plurnk-otel", "@agentclientprotocol/sdk", "@opentelemetry/context-async-hooks", "@opentelemetry/core"]
        },
        "plurnk-mimetypes": {
            "entry": ["src/**/*.test.ts", "test/**/*.ts", "scripts/**/*.{mjs,ts}"],
            "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.{mjs,ts}"],
            "ignoreDependencies": ["@plurnk/plurnk-mimetypes-grammar-*"]
        },
        "plurnk-providers": {
            "entry": ["src/**/*.test.ts", "test/**/*.ts", "scripts/**/*.{mjs,ts}"],
            "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.{mjs,ts}"],
            "ignoreDependencies": ["@aws-sdk/client-bedrock-runtime"]
        },
        "plurnk-parser": {
            "entry": ["src/FencePairing.ts", "src/**/*.test.ts", "test/**/*.ts", "scriptify/**/*.ts"],
            "project": ["src/**/*.ts", "test/**/*.ts", "scriptify/**/*.ts"]
        }
    }
}
