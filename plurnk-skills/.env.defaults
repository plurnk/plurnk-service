# Standard Agent Skills: complete definitions, with independent enabledness.
# `_` in a key represents `-`; Unicode names work in .env or via `env 'KEY=value' command`.
# PLURNK_SKILLS_code_review={"source":"/srv/skills/code-review"}
PLURNK_SKILLS_ENABLED=1
# PLURNK_SKILLS_code_review_ENABLED=0
# Any skill alias: its definition, and its own _ENABLED control.
# PLURNK_SKILLS_<alias>=<definition>
# Deadline for one skills source fetch (git ls-remote, git clone, tar, unzip), positive ms.
PLURNK_SKILLS_FETCH_TIMEOUT_MS=120000
# Comma-separated source kinds admitted for non-operator (workspace) skill additions and discovery: mcp, git, local.
# Empty disables all workspace skill sources while keeping built-in, operator, and configured-root skills available.
PLURNK_SKILLS_WORKSPACE_SOURCES=mcp,git,local
# Enforce public HTTPS-only git URLs and credential-free git fetches for non-operator (workspace) skill sources (0 or 1).
PLURNK_SKILLS_PUBLIC_ONLY=0
