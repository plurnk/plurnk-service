# Standard Agent Skills: complete definitions, with independent enabledness.
# `_` in a key represents `-`; Unicode names work in .env or via `env 'KEY=value' command`.
# PLURNK_SKILLS_code_review={"name":"code-review","source":"/srv/skills/code-review"}
PLURNK_SKILLS_ENABLED=1
# PLURNK_SKILLS_code_review_ENABLED=0
# Deadline for one skills source fetch (git ls-remote, git clone, tar, unzip), positive ms.
PLURNK_SKILLS_FETCH_TIMEOUT_MS=120000
